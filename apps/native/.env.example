# TBBT origin that hosts /api/native/v1. Never put passwords here.
# Debug/dev against a host machine: the Android app rewrites localhost/127.0.0.1
# to 10.0.2.2. Internal preview builds (Android APK + iOS simulator) bake
# https://www.collproreno.com from eas.json. This file is not a cleartext grant.
EXPO_PUBLIC_TBBT_API_URL="http://localhost:43217"
# Optional public Expo project id for getExpoPushTokenAsync.
# Not a secret. Leave empty until an EAS project exists.
# EXPO_PUBLIC_PROJECT_ID=""
