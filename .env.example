# Hosted PostgreSQL. Set DATABASE_URL in the environment.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Transactional estimate email via Resend. Leave unset locally if unused.
# EMAIL_FROM must be a verified Resend sender, for example:
# estimates@your-verified-domain.com
# The app sends as: Business Name <EMAIL_FROM>
RESEND_API_KEY=""
EMAIL_FROM=""
NEXT_PUBLIC_APP_URL="http://localhost:43217"
