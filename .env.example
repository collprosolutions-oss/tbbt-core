# Hosted PostgreSQL. Set DATABASE_URL in the environment.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Transactional estimate email via Resend. Leave unset locally if unused.
# EMAIL_FROM must be a verified Resend sender, for example:
# estimates@your-verified-domain.com
# The app sends as: Business Name <EMAIL_FROM>
RESEND_API_KEY=""
EMAIL_FROM=""
NEXT_PUBLIC_APP_URL="http://localhost:43217"

# Stripe Connect (test mode first). Platform secret only — never a
# per-business secret. Use sk_test_ / whsec_ values for local validation.
# Required events on a Connected accounts webhook endpoint:
# checkout.session.completed, checkout.session.async_payment_succeeded
# Destination must listen to Connected-account / snapshot events so
# event.account is present. Platform-only destinations can still apply
# when Checkout metadata includes connectedAccountId.
#
# Preview deployments with Vercel Authentication return 401 to Stripe
# before this route runs. Point the Event Destination at the Preview URL
# with ?x-vercel-protection-bypass=<project secret> (from Vercel project
# settings). Never commit that secret. Production should use an
# unprotected hostname or a Deployment Protection Exception for
# /api/stripe/webhook.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Local/demo only. Never set these in production.
# TBBT_PAYMENTS_ADAPTER=fake
# TBBT_PAYMENTS_FAKE_READY=1

# Job photo uploads via Vercel Blob. Create a Blob store on the Vercel
# project (Storage tab) and connect it, or run `vercel env pull` after
# `vercel link`, to populate this automatically. Leave unset locally to
# keep the app fully working; adding a photo will just show a clear
# "storage isn't set up yet" message instead of failing.
BLOB_READ_WRITE_TOKEN=""
