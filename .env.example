# Hosted PostgreSQL. Set DATABASE_URL in the environment.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Transactional estimate email via Resend. Leave unset locally if unused.
# EMAIL_FROM must be a verified Resend sender, for example:
# estimates@your-verified-domain.com
# The app sends as: Business Name <EMAIL_FROM>
RESEND_API_KEY=""
# Verified bounce/complaint webhook. Production URL:
# https://www.collproreno.com/api/mail/webhook
# The Next.js auth proxy allows this path without a TBBT session.
# Point the Resend webhook at that path and store the signing secret
# (whsec_…). Unsigned or cross-tenant events write nothing.
# Bounce/complaint suppression is enforced in sendTransactionalEmail
# immediately before the provider, per business + destination fingerprint,
# for customer-facing mail only. Team invite, password reset, and owner
# new-request notify are system-exempt by design.
# RESEND_WEBHOOK_SECRET=""
EMAIL_FROM=""
NEXT_PUBLIC_APP_URL="http://localhost:43217"

# Optional project-specific apex A from this Vercel project's Domains card.
# The Domains card is authoritative. When unset or invalid, tenant
# instructions fall back to A 76.76.21.21 and CNAME cname.vercel-dns.com.
# Value must be one public IPv4 dotted quad (or comma-separated quads):
# four decimal octets 0-255, no leading zeros, no whitespace or extra
# text. Rejected: private, loopback, link-local, CGNAT/shared, multicast,
# reserved, broadcast, documentation, 0.0.0.0/8, IPv6, hostnames, CIDR,
# URLs, and values with ports. Invalid values are ignored and never shown.
# WEBSITE_DOMAIN_PROJECT_RECOMMENDED_A=""

# TBBT corporate marketing site (www.tbbtool.com). Local `/` stays the CollPro
# public website unless one of these is set. Never required for CollPro.
# TBBT_MARKETING_SITE=1
# TBBT_MARKETING_HOST=localhost

# Stripe Connect. Platform secret only — never a per-business secret
# and never a publishable key (Checkout is hosted; no Stripe.js).
# Production webhook URL for BOTH destinations:
# https://www.collproreno.com/api/stripe/webhook
# The Next.js auth proxy allows this path without a TBBT session.
# Do not enable Vercel Authentication on Production. Preview protection
# returns 401 to Stripe before this route runs.
#
# Connect / customer-payment destination (Connected accounts / snapshot events):
# checkout.session.completed
# checkout.session.async_payment_succeeded
# Enable Connected-account / snapshot events so event.account is present.
# TBBT does not consume account.updated or other Connect account events.
# Platform-only destinations can still apply when Checkout metadata
# includes connectedAccountId. Signing secret → STRIPE_WEBHOOK_SECRET.
#
# Preview deployments with Vercel Authentication return 401 to Stripe
# before this route runs. Point the Event Destination at the Preview URL
# with ?x-vercel-protection-bypass=<project secret> (from Vercel project
# settings). Never commit that secret. Production should keep the
# production hostname publicly reachable (do not enable Vercel
# Authentication on Production). The Next.js auth proxy must not
# redirect /api/stripe/webhook — Stripe POSTs have no session cookie.
# If protection is ever on, use a Deployment Protection Exception for
# /api/stripe/webhook.
#
# Production Vercel env names (values never belong in git):
# STRIPE_SECRET_KEY (live platform sk_live_…), STRIPE_WEBHOOK_SECRET
# (whsec_… from the production destination), NEXT_PUBLIC_APP_URL
# (https://www.collproreno.com). Never set TBBT_PAYMENTS_ADAPTER=fake
# or TBBT_PAYMENTS_FAKE_READY in production.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Local/demo only. Never set these in production.
# TBBT_PAYMENTS_ADAPTER=fake
# Unknown connected account ids are not payment-ready. An explicit
# comma-separated allowlist is the only local override, and it is ignored
# when VERCEL_ENV=production. TBBT_PAYMENTS_FAKE_READY is not honored.
# TBBT_FAKE_PAYMENT_READY_ACCOUNTS=
#
# TBBT SaaS subscription billing (the trade business pays TBBT for
# software). This is not Stripe Connect. Reuses STRIPE_SECRET_KEY.
# Required on a Platform (not Connected-account) Event Destination
# at the same URL. Exact events the SaaS parser consumes:
# checkout.session.completed
# checkout.session.async_payment_succeeded
# customer.subscription.created
# customer.subscription.updated
# customer.subscription.deleted
# customer.subscription.paused
# customer.subscription.resumed
# invoice.paid
# invoice.payment_succeeded
# If this destination has its own signing secret, set
# STRIPE_SAAS_WEBHOOK_SECRET. If both destinations share one secret,
# STRIPE_WEBHOOK_SECRET alone is enough. A signature that matches
# neither secret is rejected. Connect invoice/deposit events are separate.
# Founder Plan display is $49/month. Checkout still uses this Stripe
# Price ID — do not invent or hardcode a Price ID in the app. Before
# production Checkout is enabled, create a recurring $49 USD/month
# Stripe Price and set this to that Price ID.
# Production Checkout fails closed without STRIPE_SECRET_KEY, this
# Price ID, the application URL, and a Price that is not a confirmed
# Founder Plan mismatch. Billing Portal fails closed without live
# Stripe configuration (STRIPE_SECRET_KEY), the application URL, and
# an existing Stripe customer. A missing Price ID alone does not
# block Billing Portal. Missing billing config does not take the
# website down.
STRIPE_SAAS_PRICE_ID=""
# Optional future approved plan prices. Do not invent amounts.
# Starter / Business / Enterprise stay non-purchasable until the catalog
# marks them LIVE and one of these is set to an approved Stripe Price ID.
# STRIPE_SAAS_PRICE_ID_STARTER=""
# STRIPE_SAAS_PRICE_ID_BUSINESS=""
# STRIPE_SAAS_PRICE_ID_ENTERPRISE=""
# Optional JSON map of catalog plan codes to Stripe Price IDs.
# STRIPE_SAAS_PLAN_PRICE_MAP=""
# Optional. Use when the SaaS Event Destination has a different signing
# secret than STRIPE_WEBHOOK_SECRET.
# STRIPE_SAAS_WEBHOOK_SECRET=""
# Local/demo only. Never set this in production. Vercel production
# ignores TBBT_SAAS_BILLING_ADAPTER=fake the same way it ignores
# TBBT_PAYMENTS_ADAPTER=fake.
# TBBT_SAAS_BILLING_ADAPTER=fake

# Customer SMS is disconnected until a real provider is configured.
# Do not treat a missing adapter as delivery. Local/script tests only:
# TBBT_CUSTOMER_MESSAGING_ADAPTER=fake
# Native field push stays disconnected unless Expo credentials are set
# or the fake adapter is enabled for local/script tests. The fake adapter
# cannot enable when VERCEL_ENV=production. Expo Push is the connected
# provider. Never commit EXPO_ACCESS_TOKEN. Missing credentials stay
# disconnected — TBBT never invents a delivery. Payloads stay job id +
# generic copy and never include a customer address or access code.
# TBBT_NATIVE_PUSH_ADAPTER=fake
# EXPO_ACCESS_TOKEN=""
# TBBT_CUSTOMER_MESSAGING_WEBHOOK_SECRET=""
# Local/script tests only. Never set this in production. Vercel production
# ignores TBBT_EMAIL_ADAPTER=fake the same way it ignores the SMS fake.
# TBBT_EMAIL_ADAPTER=fake
#
# Connected e-sign adapter (Dropbox Sign). Missing credentials stay
# NOT_CONNECTED. TBBT never invents a digital signature. Official webhook
# destination: https://www.collproreno.com/api/esign/webhook
# Verify event_hash = HMAC-SHA256(api_key, event_time + event_type).
# DROPBOX_SIGN_API_KEY=""
# DROPBOX_SIGN_CLIENT_ID=""
# Local/script tests only. Never set this in production. Vercel production
# ignores TBBT_ESIGN_ADAPTER=fake the same way it ignores the payments fake.
# TBBT_ESIGN_ADAPTER=fake
# TBBT_ESIGN_WEBHOOK_SECRET=""
# TBBT_ESIGN_FAKE_API_KEY=""
# Production Twilio (never commit values). Adapter activates when account
# SID + auth token AND (messaging service SID or from number) are set.
# Preferred production path: TWILIO_MESSAGING_SERVICE_SID plus a dedicated
# long code per SMS-enabled Business stored as Business.operationalSmsNumber.
# TWILIO_FROM_NUMBER is not a shared multi-tenant sender.
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_MESSAGING_SERVICE_SID=""
# TWILIO_FROM_NUMBER=""
# After a number is purchased and assigned to one Business in Twilio,
# set that Business.operationalSmsNumber to the normalized digits.
# The same dedicated number is the inbound Voice To routing key.
# Point the number's Voice URL / status callback at
# /api/communications/voice-webhook. That route verifies
# X-Twilio-Signature, logs a missed call, and returns <Reject/>.
# It does not answer, record, transcribe, or place calls.
#
# Facebook Page publish is an explicit OWNER action only when that
# business has a connected MarketingSocialDestination. Connecting a
# destination does not publish. Instagram and Google Business Profile
# can be connected by the OWNER; their publish paths are not yet available.
# Local/script tests only:
# TBBT_SOCIAL_PUBLISHING_ADAPTER=fake
# TBBT_SOCIAL_OAUTH_ADAPTER=fake
# Never set either fake adapter when VERCEL_ENV=production.
# Tests inject fake provider responses and make no network call to Meta or Google.
#
# Gusto payroll facts (owner-only). Not a payroll run and not a bank
# withdrawal. Production access requires an approved Gusto App
# Integration or Embedded Payroll partnership (pre-approval, security
# review, QA). Scopes are assigned at review. An individual customer
# connecting their own company directly is not supported. GUSTO_ENV
# must be demo or production; production is used only when set
# explicitly. Missing values stay "Not available" with no connect
# button. Connected appears only after token exchange and token info.
# TBBT_GUSTO_ADAPTER=fake is local/script tests only and is refused
# when VERCEL_ENV=production. Never commit secrets.
# GUSTO_CLIENT_ID=""
# GUSTO_CLIENT_SECRET=""
# GUSTO_ENV=demo
# GUSTO_REDIRECT_URI=""
# TBBT_GUSTO_ADAPTER=fake
#
# At-rest encryption for provider tokens (Gusto, Facebook, Instagram,
# and Google). 32 bytes as 64 hex characters. There is no plaintext fallback.
# CONNECTION_TOKEN_ENCRYPTION_KEY=""
# Meta Facebook Login (Facebook Page and Instagram professional accounts).
# Redirect URI must be the exact callback:
# https://<host>/api/marketing/connections/meta/callback
# META_APP_ID=
# META_APP_SECRET=
# META_OAUTH_REDIRECT_URI=
# Google OAuth web server flow for Business Profile.
# Redirect URI must be the exact callback:
# https://<host>/api/marketing/connections/google/callback
# Scope requested: https://www.googleapis.com/auth/business.manage
# Google must also approve Business Profile API access. Credentials alone
# do not grant that approval.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=
#
# Once-daily Vercel cron for the OWNER weekly Marketing Studio reminder.
# Required on Production. The route fails closed without it. Sends only
# when the business local day is Monday. Never a page-render trigger.
# Vercel sends Authorization: Bearer $CRON_SECRET.
# CRON_SECRET=""

# Job photo / receipt uploads still use Vercel Blob until that migration.
# Website Photos use platform object storage (Cloudflare R2) instead.
BLOB_READ_WRITE_TOKEN=""

# Platform-managed Cloudflare R2 (S3-compatible). Server-side only.
# Never put these in frontend code. Website Photos require these.
# R2_ENDPOINT defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# R2_ENDPOINT=""
# R2_REGION="auto"
# Optional public CDN / custom domain for public objects.
# STORAGE_PUBLIC_BASE_URL=""
# Optional override of the 5 GB managed default, in bytes.
# STORAGE_DEFAULT_LIMIT_BYTES=""

# Read-only Plaid bank connection for OWNER reconciliation review.
# Never a bank username, password, MFA code, or account number.
# Never a verified cash balance and never a money-movement product.
#
# Sandbox (development):
# 1. Create a Plaid dashboard team and application.
# 2. Enable the Transactions product (no Auth / Transfer / Payment Initiation).
# 3. Set PLAID_CLIENT_ID and the Sandbox PLAID_SECRET in the host environment.
# 4. Set PLAID_ENV=sandbox.
# 5. Generate PLAID_TOKEN_ENCRYPTION_KEY as 32 bytes (64 hex characters).
# 6. Set NEXT_PUBLIC_APP_URL to the public origin so Link webhooks can reach
#    https://<origin>/api/plaid/webhook (or set PLAID_WEBHOOK_URL explicitly).
# 7. For OAuth banks, register PLAID_REDIRECT_URI in the Plaid dashboard.
#    It must match exactly. Default when unset is
#    ${NEXT_PUBLIC_APP_URL}/settings?section=banking.
# 8. Optional: TBBT_PLAID_ADAPTER=fake uses an in-process sandbox for tests.
#    Do not set TBBT_PLAID_ADAPTER=fake in production. VERCEL_ENV=production
#    and NODE_ENV=production refuse the fake adapter and fake webhook secret.
#
# Production (do not paste values into chat or commit them):
# 1. Request Plaid production access for this application.
# 2. Enable Transactions only.
# 3. Add the production webhook URL and, for OAuth banks, register
#    PLAID_REDIRECT_URI in the Plaid dashboard. The URI must match exactly
#    (https://<production-host>/settings?section=banking).
# 4. Set PLAID_CLIENT_ID, production PLAID_SECRET, PLAID_ENV=production,
#    PLAID_REDIRECT_URI, and a dedicated PLAID_TOKEN_ENCRYPTION_KEY.
# 5. Keep Preview protection from blocking /api/plaid/webhook, same as Stripe.
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"
PLAID_TOKEN_ENCRYPTION_KEY=""
# PLAID_WEBHOOK_URL=""
# PLAID_REDIRECT_URI=""
# TBBT_PLAID_ADAPTER=fake
# PLAID_WEBHOOK_SECRET=""

# Founder production preflight only (npm run preflight:founder).
# The checker never opens DATABASE_URL. The read-only production probe
# runs only when BOTH of the following are set, and then only that URL,
# inside a read-only transaction. Do not point this at a database the
# operator is not authorized to read. The checker never migrates or repairs.
# TBBT_FOUNDER_PRODUCTION_READONLY_DATABASE_URL=""
# TBBT_FOUNDER_PRODUCTION_READONLY_CONFIRM=""
