  fillInBenchWorkers              FillInBenchWorker[]
  workforceOutreachCreated        WorkforceOutreachTask[]   @relation("WorkforceOutreachCreator")
  workforceOutreachApproved       WorkforceOutreachTask[]   @relation("WorkforceOutreachApprover")
  confirmedRecurringPatterns      RecurringExpensePattern[] @relation("RecurringPatternConfirmedBy")
  dismissedRecurringPatterns      RecurringExpensePattern[] @relation("RecurringPatternDismissedBy")
