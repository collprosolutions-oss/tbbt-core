// TBBT Step 1 foundation schema.
// Every business-owned record carries businessId and must be queried
// through the authenticated user's membership. Do not add unscoped lists.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum LineItemType {
  LABOR
  MATERIAL
  OTHER
}

enum JobPhotoStage {
  BEFORE
  DURING
  AFTER
}

/// Who originated an AdditionalWorkRequest. CUSTOMER is the Customer Project
/// Portal's "+ Request Additional Work" (see /p/[token]). EMPLOYEE is the
/// assigned field MEMBER's "Customer Asked for More Work" action (Phase 3 /
/// Step 4 Employee Field Workflow -- see reportAdditionalWorkFromField in
/// src/app/actions/field-job.ts). Both sources create the exact same kind of
/// record with the exact same non-effect: never scope, price, Job total, or
/// Invoice by itself. See the note on AdditionalWorkRequest below.
enum AdditionalWorkRequestSource {
  CUSTOMER
  EMPLOYEE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  /// Platform-level TBBT founder/developer flag -- NOT a business role
  /// and completely independent of Membership/MembershipRole. Grants
  /// access to Founder Design Mode ONLY (see src/lib/founder-access.ts);
  /// a subscriber OWNER is never a TBBT developer just because they own a
  /// business. Never set through any tenant-facing UI/API -- grant or
  /// revoke only via direct database access or
  /// scripts/set-founder-access.mjs.
  isFounder    Boolean  @default(false)
  /// Base32 TOTP secret used only after totpEnabledAt is set. Never
  /// exported, never shown after enrollment completes.
  totpSecret         String?
  /// Pending secret during enrollment. Cleared when the first valid code
  /// confirms the authenticator, or when enrollment is cancelled.
  totpPendingSecret  String?
  totpEnabledAt      DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships          Membership[]
  sessions             Session[]
  /// One-time credential-setup links for a newly-onboarded team member --
  /// see PasswordSetupToken below. Empty for every user who signed up
  /// themselves (signUpAction already sets a real password).
  passwordSetupTokens  PasswordSetupToken[]
  /// One-time password-recovery links -- see PasswordResetToken below.
  /// Empty until the user requests a reset. Distinct from team onboarding
  /// PasswordSetupToken rows so a 7-day invite cannot be reused as a reset.
  passwordResetTokens  PasswordResetToken[]
  totpBackupCodes      TotpBackupCode[]
  authChallenges       AuthChallenge[]
  /// Founder Design Mode cosmetic overrides this user has saved -- see
  /// FounderDesignOverride below. Empty for every non-founder User.
  founderDesignOverrides FounderDesignOverride[]
  aiInteractions         AiInteraction[]
}

/// Founder/developer-only cosmetic design-token overrides for the
/// approved TBBT UI foundation pages (Dashboard, Requests, Customers,
/// Estimates, Schedule/Jobs, Invoices). Presentation-only: never read by
/// any business-logic code path, never scoped to a Business, and never
/// exposed to any subscriber (OWNER/ADMIN/MEMBER) UI or API -- see
/// src/lib/founder-access.ts. Writing a row requires `userId` to belong
/// to a User with isFounder = true; enforced in
/// src/app/actions/founder-design.ts, not by a database constraint
/// (Founder Design Mode intentionally has no tenant/business scoping of
/// its own -- it is keyed by User, not Business).
model FounderDesignOverride {
  id      String @id @default(cuid())
  userId  String
  /// One of the fixed FOUNDER_PAGE_KEYS in src/lib/founder-design.ts
  /// (e.g. "dashboard", "requests") -- never a free-form/tenant value.
  pageKey String
  /// Validated, bounded token values only -- see resolveFounderTokens()
  /// and the *_BOUNDS constants in src/lib/founder-design.ts. Never HTML,
  /// CSS, or arbitrary strings; every value is clamped server-side before
  /// being written here.
  tokens Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pageKey])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  /// Best-effort User-Agent captured at sign-in. Display only.
  userAgent String?
  /// Set when the owner revokes this session. getSessionUser() treats a
  /// revoked row as signed-out without deleting the audit row.
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Hashed one-time TOTP backup codes. The raw code is shown once at
/// enrollment and never stored.
model TotpBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Short-lived sign-in challenge after password succeeds and TOTP is on.
/// Stores only sha256(token). Raw token lives in the sign-in form.
model AuthChallenge {
  id                 String   @id @default(cuid())
  userId             String
  tokenHash          String   @unique
  purpose            String
  expiresAt          DateTime
  /// Failed TOTP/backup attempts against this challenge. Five failures
  /// invalidate the challenge. This is not a user lockout.
  failedAttemptCount Int      @default(0)
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Durable native password-attempt window. Keyed by hashed email + purpose,
/// never a raw email or password. Survives process restarts. This is not a
/// permanent account lockout — the row expires and the counter resets.
model NativeSignInThrottle {
  id                 String   @id @default(cuid())
  /// sha256(purpose + normalized identifier). Never the raw email.
  subjectHash        String
  purpose            String
  failedAttemptCount Int      @default(0)
  windowStartedAt    DateTime
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([subjectHash, purpose])
  @@index([expiresAt])
}

/// A single-use, expiring, unguessable link letting a newly-onboarded team
/// member set their OWN password -- the smallest secure onboarding
/// mechanism that avoids ever exposing or storing a plaintext password
/// (see addTeamMember() in src/app/actions/team.ts and
/// src/app/set-password/[token]/page.tsx). Mirrors Session's existing
/// hashed-token pattern exactly (sha256 tokenHash stored, raw token only
/// ever in the URL) rather than introducing a new credential concept.
/// OWNER/ADMIN see the raw setup link exactly once, to relay to the new
/// MEMBER by whatever channel they already use (text, email, in person);
/// TBBT does not require email delivery to be configured for this to
/// work. `usedAt` makes the link single-use; `expiresAt` bounds its
/// lifetime the same way a Session's `expiresAt` does.
model PasswordSetupToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A single-use, expiring, unguessable link letting a user recover access
/// after forgetting their password (see requestPasswordResetOp in
/// src/lib/password-reset.ts). Mirrors PasswordSetupToken / Session:
/// store only sha256(tokenHash), never the raw token; `usedAt` makes the
/// link single-use; `expiresAt` bounds its lifetime. The raw token is
/// mailed exactly once and is the only identifier in the reset URL --
/// no business, tenant, or user ids.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Business {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  /// Compatibility projection of the primary active BusinessTrade only.
  /// business_trades is the Core source of truth. Do not treat this column
  /// as a second authority — writers sync it from the primary ACTIVE
  /// BusinessTrade so existing readers keep working during the transition.
  /// Planned removal: after every remaining tradeCode reader is migrated
  /// to listActiveBusinessTrades() / resolvePrimaryTradeCode().
  tradeCode           String   @default("HANDYMAN")
  laborMinimumEnabled Boolean  @default(false)
  laborMinimumAmount  Decimal?
  /// Customer-facing phone shown on estimates, invoices, and the public site.
  publicPhone         String?
  /// Customer-facing email shown on estimates, invoices, and the public site.
  publicEmail         String?
  /// Customer-facing website shown on estimates, invoices, and the public site.
  publicWebsite       String?
  /// Customer-facing primary service area shown on the public site.
  /// Free-text label only (for example "Reno, NV"). Not a city list, and
  /// not inferred from CollPro's Fort Myers map.
  publicServiceAreaLabel String?
  /// Set when the OWNER finishes first-run business identity setup.
  /// Null means this business still needs that setup. Existing tenants are
  /// backfilled once when the column is first created — not inferred from
  /// phone/email being populated.
  firstRunSetupCompletedAt DateTime?
  /// Set when the OWNER finishes (installs or skips) first-run starter
  /// services setup for this business's current trade. Null means the step
  /// is still pending. Existing tenants are backfilled once when the column
  /// is first created — not inferred from catalog item count.
  starterServicesSetupCompletedAt DateTime?
  /// INSTALLED or SKIPPED once starterServicesSetupCompletedAt is set for a
  /// new owner. Existing backfilled tenants may leave this null.
  starterServicesSetupChoice String?
  /// Set when the OWNER finishes (saves or skips) first-run public website
  /// setup. Null means the step is still pending. Existing tenants are
  /// backfilled once when the column is first created — not inferred from
  /// About copy or service-area text being populated.
  websiteSetupCompletedAt DateTime?
  /// SAVED or SKIPPED once websiteSetupCompletedAt is set for a new owner.
  /// Existing backfilled tenants may leave this null.
  websiteSetupChoice String?
  /// IANA timezone for business calendar days (time cards, schedule,
  /// reports, expenses, payroll, dashboard "today"). Null means
  /// America/New_York (Fort Myers / Eastern). Never a hard-coded offset.
  timezone            String?
  /// Normalized US digits of THIS business's dedicated Twilio long code.
  /// Used as both the outbound From and the inbound To routing key so
  /// STOP/START/HELP cannot be attributed to the wrong tenant. Unique.
  /// Null means this tenant has no SMS identity (inbound disabled; Twilio
  /// outbound will not use a shared/pool sender).
  operationalSmsNumber String? @unique
  /// Owner requested account/business closure. Historical financial and
  /// job records are never deleted by this timestamp.
  offboardingRequestedAt DateTime?
  /// Current published website snapshot. Null means this business still
  /// uses the live-assembled compatibility public site. Application code
  /// must only point this at a WebsitePublish owned by THIS business.
  publishedWebsiteId String? @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  memberships              Membership[]
  trades                   BusinessTrade[]
  customers                Customer[]
  properties               Property[]
  catalogItems             ServiceCatalogItem[]
  serviceRequests          ServiceRequest[]
  estimates                Estimate[]
  estimateVersions         EstimateVersion[]
  estimateVersionLineItems EstimateVersionLineItem[]
  estimateOptions          EstimateOption[]
  estimateVersionOptions   EstimateVersionOption[]
  jobs                     Job[]
  appointmentEvents        JobAppointmentEvent[]
  invoices                 Invoice[]
  invoiceCredits           InvoiceCredit[]
  lineItems                LineItem[]
  jobPhotos                JobPhoto[]
  changeOrders             ChangeOrder[]
  additionalWorkRequests      AdditionalWorkRequest[]
  additionalWorkRequestItems  AdditionalWorkRequestItem[]
  jobProblemReports           JobProblemReport[]
  jobCallbacks                JobCallback[]
  jobCallbackEvents           JobCallbackEvent[]
  /// OWNER-authored aftercare for a completed Job. Separate table so Job
  /// columns stay untouched. Concurrent Job-column chats do not collide.
  jobAftercareInstructions    JobAftercareInstruction[]
  jobAftercareEvents          JobAftercareEvent[]
  timeEntries              TimeEntry[]
  timeEntryAdjustments     TimeEntryAdjustment[]
  timeCorrectionRequests   TimeCorrectionRequest[]
  timeCorrectionDecisions  TimeCorrectionDecision[]
  timesheetWeeks           TimesheetWeek[]
  payrollRuns              PayrollRun[]
  payrollRunItems          PayrollRunItem[]
  payrollRunEvents         PayrollRunEvent[]
  expenses                 Expense[]
  /// Owner-recorded tools and vehicles. Not inventory stock.
  equipmentItems           EquipmentItem[]
  equipmentMaintenanceEntries EquipmentMaintenanceEntry[]
  marketingContents        MarketingContent[]
  marketingContentPhotos   MarketingContentPhoto[]
  marketingStudioWeeklyReminders MarketingStudioWeeklyReminder[]
  reviewRequests           ReviewRequest[]
  reviews                  Review[]
  reviewResponses          ReviewResponse[]
  pipelineOpportunities    PipelineOpportunity[]
  settings                 BusinessSettings?
  settingsAuditLogs        SettingsAuditLog[]
  publicSiteImages         PublicSiteImage[]
  knowledgeEntries         KnowledgeEntry[]
  launchProgress           BusinessLaunchProgress?
  launchSteps              BusinessLaunchStep[]
  companySetupProposals    CompanySetupProposal[]
  companySetupProposalItems CompanySetupProposalItem[]
  operatingProcedures      OperatingProcedure[]
  operatingProcedureSteps  OperatingProcedureStep[]
  experienceLearningCandidates ExperienceLearningCandidate[]
  serviceRequestItems         ServiceRequestItem[]
  serviceRequestPhotos        ServiceRequestPhoto[]
  serviceRequestMeasurements  ServiceRequestMeasurement[]
  paymentAccount           BusinessPaymentAccount?
  saasSubscription         BusinessSaasSubscription?
  productAddons            BusinessProductAddon[]
  productGrants            BusinessProductGrant[]
  storageAccount           BusinessStorageAccount?
  storedAssets             StoredAsset[]
  estimatingDefaults       BusinessEstimatingDefault[]
  payments                 Payment[]
  invoiceCheckoutSessions  InvoiceCheckoutSession[]
  unavailableDates         BusinessUnavailableDate[]
  supplierPreferences      BusinessSupplierPreference[]
  materialSupplierMappings BusinessMaterialSupplierMapping[]
  supplierPriceRecords     SupplierPriceRecord[]
  customerCommunications   CustomerCommunication[]
  communicationThreads     CommunicationThread[]
  phoneInteractions        PhoneInteraction[]
  receptionistEvents       ReceptionistEvent[]
  messagingWebhookEvents   CustomerMessagingWebhookEvent[]
  goals                    BusinessGoal[]
  actionItems              BusinessActionItem[]
  campaigns                MarketingCampaign[]
  serviceAreas             ServiceArea[]
  referralRequests         ReferralRequest[]
  referrals                Referral[]
  customerFollowUps        CustomerFollowUp[]
  aiConversations          AiConversation[]
  aiConversationMessages   AiConversationMessage[]
  aiInteractions           AiInteraction[]
  aiOrchestrationRuns      AiOrchestrationRun[]
  aiUsagePeriods           AiUsagePeriod[]
  knowledgeConcepts        KnowledgeConcept[]
  knowledgeAssertions      KnowledgeAssertion[]
  businessEvents           BusinessEvent[]
  automationRules          AutomationRule[]
  automationRuns           AutomationRun[]
  recommendationStates     BsosRecommendationState[]
  controlledAiActionAttempts ControlledAiActionAttempt[]
  laborBurdenSetting       BusinessLaborBurdenSetting?
  recurringExpensePatterns RecurringExpensePattern[]
  financeConnections       BusinessFinanceConnection[]
  publishedWebsite         WebsitePublish?          @relation("CurrentPublishedWebsite", fields: [publishedWebsiteId], references: [id], onDelete: SetNull)
  websitePublishes         WebsitePublish[]         @relation("BusinessWebsitePublishes")
  websiteGalleryItems      WebsiteGalleryItem[]
  websiteHostBindings      WebsiteHostBinding[]
  websiteLocalPageDrafts   WebsiteLocalPageDraft[]
  growthActionRequests     GrowthActionRequest[]
  leadAttributionCorrections LeadAttributionCorrection[]
  membershipSkills         MembershipSkill[]
  membershipWeeklyAvailability MembershipWeeklyAvailability[]
  membershipAvailabilityExceptions MembershipAvailabilityException[]
  membershipAvailabilityExceptionRequests MembershipAvailabilityExceptionRequest[]
  fillInBenchWorkers       FillInBenchWorker[]
  workforceOutreachTasks   WorkforceOutreachTask[]
  suppliers                  Supplier[]
  materialCatalogItems       MaterialCatalogItem[]
  materialPriceHistory       MaterialPriceHistory[]
  materialPurchaseLists      MaterialPurchaseList[]
  materialPurchaseListItems  MaterialPurchaseListItem[]
  materialPurchaseOrders     MaterialPurchaseOrder[]
  materialPurchaseOrderItems MaterialPurchaseOrderItem[]
  materialPurchaseOrderReceipts MaterialPurchaseOrderReceipt[]
  materialPurchaseOrderReceiptItems MaterialPurchaseOrderReceiptItem[]
  materialOperationAttempts  MaterialOperationAttempt[]
  vaultRecords             BusinessVaultRecord[]
  agreements               BusinessAgreement[]
  agreementVersions        BusinessAgreementVersion[]
  protectionAuditLogs      BusinessProtectionAuditLog[]
  protectionAcknowledgments BusinessProtectionAcknowledgment[]
  agreementCompletionClaims BusinessAgreementCompletionClaim[]
  esignBoundary            BusinessEsignBoundary?
  crewVisits               JobCrewVisit[]
  /// Explicit OWNER opt-in row for the BSOS Network. Absence means
  /// default-off — never infer participation from public contact or jobs.
  bsosNetworkParticipation BsosNetworkParticipation?
  /// Optional office / shop locations. Empty after migrate. Not a timezone,
  /// Stripe account, service area, or tenant boundary.
  locations                BusinessLocation[]
  partnerVendorOpportunities PartnerVendorOpportunity[]
  externalLeadImports      ExternalLeadImport[]
  externalLeadImportRows   ExternalLeadImportRow[]
  customerCsvImports       CustomerCsvImport[]
  customerCsvImportRows    CustomerCsvImportRow[]
  /// OWNER-reviewed CSV preview/confirm for this business's catalog.
  /// Confirm writes ServiceCatalogItem only — never LineItem snapshots
  /// or published hourly rates.
  serviceCatalogImports    ServiceCatalogImport[]
  serviceCatalogImportRows ServiceCatalogImportRow[]
  regulatoryIntelligenceNotes RegulatoryIntelligenceNote[]
  /// OWNER-authored extra intake questions + allowlisted visibility rules.
  /// Drafts stay off public hire forms until published as TenantIntakeSnapshot.
  intakeConditionDrafts    IntakeConditionDraft[]
  tenantIntakeSnapshots    TenantIntakeSnapshot[]
  /// Named OWNER assumption overlays for /scenario-planner. Knobs only —
  /// never recorded facts, forecasts, invoices, payments, expenses, or prices.
  ownerScenarioAssumptionSets OwnerScenarioAssumptionSet[]
  /// OWNER-named reusable draft estimate line sets. Business-scoped
  /// snapshots only — never public catalog prices or approved estimates.
  estimateLineTemplates     EstimateLineTemplate[]
  estimateLineTemplateLines EstimateLineTemplateLine[]
  customerMerges            CustomerMerge[]
  /// OWNER-recorded Job milestones. Separate table so Job columns stay
  /// untouched. Completion is explicit — never inferred from Job.status.
  jobMilestones             JobMilestone[]
  jobMilestoneEvents        JobMilestoneEvent[]
  /// OWNER-set monthly targets for recorded jobs completed, invoices paid,
  /// and collected payments (recorded). Targets are not forecasts or bank balance.
  monthlyBusinessGoals      MonthlyBusinessGoal[]
  /// OWNER-recorded collections next steps / resolutions. Not payments.
  invoiceCollectionWorkItems InvoiceCollectionWorkItem[]
}

/// First-class membership of a Business in a configured trade.
/// This is the Core source of truth for multi-trade. One Business identity
/// (slug, customers, jobs, invoices, public site) can hold multiple ACTIVE
/// rows. Browser-supplied trade/business IDs never authorize these rows.
model BusinessTrade {
  id        String   @id @default(cuid())
  businessId String
  /// HANDYMAN | CLEANING. Must be a configured TRADE_CODES value.
  tradeCode String
  /// ACTIVE | INACTIVE
  status    String   @default("ACTIVE")
  /// Owner/admin JSON overrides for configurable defaults (starter prices,
  /// customer-facing phrases). Never an authorization boundary. Validated
  /// against the platform TradeConfiguration for this tradeCode.
  configOverridesJson String @default("{}")
  /// Platform intake schema version frozen when this membership was last
  /// activated or when overrides were saved. Historical ServiceRequest
  /// rows store their own snapshot and are never reinterpreted from here.
  intakeSchemaVersion Int @default(1)
  /// Current published tenant intake snapshot for this trade. Null means
  /// public hire forms still use the platform schema only. Must only point
  /// at a TenantIntakeSnapshot owned by THIS business and trade.
  publishedIntakeSnapshotId String? @unique
  activatedAt   DateTime  @default(now())
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  publishedIntakeSnapshot TenantIntakeSnapshot? @relation("CurrentPublishedIntake", fields: [publishedIntakeSnapshotId], references: [id], onDelete: SetNull)

  @@unique([businessId, tradeCode])
  @@index([businessId])
  @@index([tradeCode])
}

/// Optional office / shop location for one Business.
/// Additive only. Existing businesses have zero rows after migrate.
/// Creating a location never writes Business.timezone, Stripe accounts,
/// ServiceArea rows, or a different businessId. Historical Jobs stay
/// unassigned (Job.businessLocationId remains null).
/// OWNER manages. Office roles (OWNER/ADMIN) may read. MEMBER stays
/// field-scoped and cannot list or mutate locations.
model BusinessLocation {
  id                    String   @id @default(cuid())
  businessId            String
  name                  String
  addressLine1          String   @default("")
  addressLine2          String   @default("")
  city                  String   @default("")
  region                String   @default("")
  postalCode            String   @default("")
  notes                 String   @default("")
  /// ACTIVE | ARCHIVED
  status                String   @default("ACTIVE")
  createdByMembershipId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  business  Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy Membership?  @relation("BusinessLocationCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  jobs      Job[]

  @@index([businessId])
  @@index([businessId, status])
}

/// Named OWNER assumption overlay for /scenario-planner.
/// Stores knobs only. Never stores recorded facts, forecasts, invoices,
/// payments, expenses, jobs, or catalog prices. Reopening applies these
/// knobs to the current bounded recorded-fact sample. Comparing two rows
/// uses one shared fact sample. businessId comes from access, not the browser.
model OwnerScenarioAssumptionSet {
  id                          String   @id @default(cuid())
  businessId                  String
  name                        String
  workloadPercent             Decimal
  materialCostPercent         Decimal
  laborCostPercent            Decimal
  pricePercent                Decimal
  assumeUnpaidInvoicesCollect Boolean  @default(false)
  createdByMembershipId       String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  business  Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy Membership? @relation("OwnerScenarioAssumptionSetCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  @@unique([businessId, name])
  @@index([businessId, updatedAt])
}

/// OWNER-set monthly targets for recorded jobs completed, invoices paid,
/// and collected payments (recorded). One row per business civil month. Targets are
/// not forecasts, projected cash, or bank balance. Actuals are computed
/// from recorded TBBT facts using Business.timezone month boundaries.
/// ADMIN may view; MEMBER is denied. businessId comes from access.
model MonthlyBusinessGoal {
  id                    String   @id @default(cuid())
  businessId            String
  year                  Int
  /// Civil month 1-12 in Business.timezone.
  month                 Int
  jobsCompletedTarget   Int?
  invoicesPaidTarget    Int?
  revenueReceivedTarget Decimal?
  createdByMembershipId String?
  updatedByMembershipId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  business  Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy Membership? @relation("MonthlyBusinessGoalCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  updatedBy Membership? @relation("MonthlyBusinessGoalUpdater", fields: [updatedByMembershipId], references: [id], onDelete: SetNull)

  @@unique([businessId, year, month])
}

model Membership {
  id         String         @id @default(cuid())
  userId     String
  businessId String
  role       MembershipRole
  /// Whether this Membership currently grants access. OWNER/ADMIN can
  /// deactivate a MEMBER's Membership (see removeTeamMember() in
  /// src/app/actions/team.ts) without deleting the row itself, so
  /// historical records that reference this Membership (Job.
  /// assignedMembershipId, JobProblemReport.membershipId) keep working
  /// exactly as they do today. requireWorkspace() only resolves a
  /// workspace from active memberships, so a deactivated MEMBER simply
  /// loses access -- there is no separate "disabled user" flag on User
  /// itself, since a user may still hold an active membership at a
  /// DIFFERENT business.
  active     Boolean        @default(true)
  /// Hourly wage for THIS membership at THIS business. OWNER/ADMIN only
  /// (see CAPABILITIES.MANAGE_TIME_CARDS). Never stored on User -- the
  /// same person may belong to different businesses at different rates.
  /// Null means no rate is on file yet; labor-cost estimates omit that
  /// worker rather than inventing a number. Later wage edits must not
  /// rewrite already-approved TimeEntry / TimesheetWeek snapshots.
  hourlyWage Decimal?
  /// Owner-recorded dispatch status. Inactive workers stay on the roster
  /// but are not recommended for new assignments.
  schedulingActive   Boolean @default(true)
  /// LEARNING | CAPABLE | LEAD_QUALIFIED. Practical qualification only.
  progression        String  @default("CAPABLE")
  /// Optional owner cap on scheduled job minutes per working day.
  maxDailyJobMinutes Int?
  preferredJobTypes  String  @default("")
  allowedJobTypes    String  @default("")
  workforceNotes     String  @default("")
  createdAt  DateTime       @default(now())

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  business       Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Jobs where this Membership (almost always a MEMBER) is the assigned
  /// field employee -- see Job.assignedMembershipId below. Deliberately a
  /// plain one-to-many on Job, not a join table: Phase 3 / Step 4 only
  /// needs ONE assigned member per Job, so a join table would be
  /// unused-crew-management complexity this step explicitly avoids.
  assignedJobs   Job[]              @relation("JobAssignment")
  appointmentConfirmations Job[]   @relation("JobAppointmentConfirmedBy")
  startWithoutConfirmationJobs Job[] @relation("JobStartWithoutConfirmationBy")
  appointmentEvents JobAppointmentEvent[] @relation("JobAppointmentEventActor")
  reportedIssues JobProblemReport[]
  timeEntries    TimeEntry[]
  timesheetWeeks TimesheetWeek[]
  /// Adjustments this membership authored (owner/admin corrections, or a
  /// MEMBER's own correction request). Not the entries they worked.
  authoredAdjustments TimeEntryAdjustment[] @relation("TimeEntryAdjustmentActor")
  requestedTimeCorrections TimeCorrectionRequest[] @relation("TimeCorrectionRequester")
  timeCorrectionDecisions  TimeCorrectionDecision[] @relation("TimeCorrectionDecisionActor")
  approvedTimesheets  TimesheetWeek[]       @relation("TimesheetWeekApprover")
  payrollRunItems     PayrollRunItem[]
  payrollRunEvents    PayrollRunEvent[]     @relation("PayrollRunEventActor")
  reviewedPayrollRuns    PayrollRun[]       @relation("PayrollRunReviewer")
