// TBBT Step 1 foundation schema.
// Every business-owned record carries businessId and must be queried
// through the authenticated user's membership. Do not add unscoped lists.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum LineItemType {
  LABOR
  MATERIAL
  OTHER
}

enum JobPhotoStage {
  BEFORE
  DURING
  AFTER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
  sessions    Session[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Business {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  /// App-level trade code. Only HANDYMAN is active in Phase 1.
  tradeCode           String   @default("HANDYMAN")
  laborMinimumEnabled Boolean  @default(false)
  laborMinimumAmount  Decimal?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  memberships              Membership[]
  customers                Customer[]
  properties               Property[]
  catalogItems             ServiceCatalogItem[]
  serviceRequests          ServiceRequest[]
  estimates                Estimate[]
  estimateVersions         EstimateVersion[]
  estimateVersionLineItems EstimateVersionLineItem[]
  jobs                     Job[]
  invoices                 Invoice[]
  lineItems                LineItem[]
  jobPhotos                JobPhoto[]
}

model Membership {
  id         String         @id @default(cuid())
  userId     String
  businessId String
  role       MembershipRole
  createdAt  DateTime       @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  email      String?
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  properties      Property[]
  serviceRequests ServiceRequest[]
  estimates       Estimate[]
  jobs            Job[]
  invoices        Invoice[]

  @@index([businessId])
}

model Property {
  id           String   @id @default(cuid())
  businessId   String
  customerId   String
  label        String?
  addressLine1 String
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceRequests ServiceRequest[]
  estimates       Estimate[]
  jobs            Job[]

  @@index([businessId])
  @@index([customerId])
}

model ServiceCatalogItem {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  /// FIXED | STARTING_AT | CUSTOM_QUOTE. Existing rows default to STARTING_AT.
  pricingMode String   @default("STARTING_AT")
  price       Decimal?
  /// Persistent grouping label for this business's price list (e.g.
  /// "Doors & Locks" for a Handyman business). Free-form per business/trade
  /// on purpose -- this is NOT a shared enum, so a future non-Handyman trade
  /// (Cleaning, Painting, Landscaping, ...) can use its own category
  /// vocabulary without any TBBT Core schema change. "Other Services" is
  /// the safe fallback for a service with no meaningful category, matching
  /// the app's pre-existing OTHER_SERVICES_CATEGORY fallback (see
  /// src/lib/service-catalog-category.ts and
  /// src/lib/handyman-starter-catalog.ts).
  category    String   @default("Other Services")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lineItems       LineItem[]
  serviceRequests ServiceRequest[]

  @@index([businessId])
}

model ServiceRequest {
  id          String   @id @default(cuid())
  businessId  String
  customerId  String?
  propertyId  String?
  status      String   @default("OPEN")
  summary     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Selected catalog service at intake time, if any. "Other / Not sure" leaves this null.
  serviceCatalogItemId String?

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  property           Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  serviceCatalogItem ServiceCatalogItem? @relation(fields: [serviceCatalogItemId], references: [id], onDelete: SetNull)
  estimates          Estimate[]

  @@index([businessId])
}

model Estimate {
  id                     String   @id @default(cuid())
  businessId             String
  customerId             String?
  propertyId             String?
  serviceRequestId       String?
  /// Lifecycle: DRAFT → SENT → APPROVED. String values, not a Prisma enum.
  status                 String   @default("DRAFT")
  total                  Decimal  @default(0)
  laborMinimumWaived     Boolean  @default(false)
  laborMinimumAdjustment Decimal  @default(0)
  publicToken            String   @unique
  /// Points at the EstimateVersion the customer actually approved. Set
  /// exactly once, in the same transaction that flips status SENT ->
  /// APPROVED, and never changed afterward.
  approvedVersionId      String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  property        Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  serviceRequest  ServiceRequest?   @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  jobs            Job[]
  lineItems       LineItem[]
  /// Immutable snapshots created every time this estimate is successfully
  /// sent. Application code must never update or delete an existing row.
  versions        EstimateVersion[] @relation("EstimateVersions")
  approvedVersion EstimateVersion?  @relation("EstimateApprovedVersion", fields: [approvedVersionId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([propertyId])
}

/// Immutable historical snapshot of an Estimate exactly as it was SENT to a
/// customer. Created exactly once per successful DRAFT -> SENT transition,
/// in the same transaction as that transition. Application code must never
/// update the snapshot fields (versionNumber, total, labor-minimum fields,
/// customer/property snapshot fields, line items) of an existing row --
/// the only field ever written after creation is approvedAt, and only on
/// the single version the customer actually approved.
model EstimateVersion {
  id            String @id @default(cuid())
  businessId    String
  estimateId    String
  versionNumber Int

  /// Snapshot of Estimate totals at the moment this version was sent.
  total                  Decimal
  laborMinimumWaived     Boolean
  laborMinimumAdjustment Decimal

  /// Snapshot of customer/property context needed to reconstruct what was
  /// sent, independent of later edits to the live Customer/Property rows.
  customerName         String?
  customerEmail        String?
  customerPhone        String?
  propertyAddressLine1 String?
  propertyAddressLine2 String?
  propertyCity         String?
  propertyRegion       String?
  propertyPostalCode   String?

  sentAt     DateTime  @default(now())
  /// Set exactly once, only on the version the customer actually approved.
  /// Never overwritten afterward.
  approvedAt DateTime?
  createdAt  DateTime  @default(now())

  business            Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  estimate            Estimate                  @relation("EstimateVersions", fields: [estimateId], references: [id], onDelete: Cascade)
  approvedOnEstimates Estimate[]                @relation("EstimateApprovedVersion")
  lineItems           EstimateVersionLineItem[]

  @@unique([estimateId, versionNumber])
  @@index([businessId])
  @@index([estimateId])
}

/// Immutable snapshot of a LineItem as it existed at the moment its parent
/// EstimateVersion was sent. Never edited or deleted by application code.
model EstimateVersionLineItem {
  id                String       @id @default(cuid())
  businessId        String
  estimateVersionId String
  description       String
  quantity          Decimal
  unitPrice         Decimal
  total             Decimal
  type              LineItemType
  createdAt         DateTime     @default(now())

  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  estimateVersion EstimateVersion @relation(fields: [estimateVersionId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([estimateVersionId])
}

model Job {
  id                       String    @id @default(cuid())
  businessId               String
  customerId               String?
  propertyId               String?
  estimateId               String?
  /// Lifecycle: UNSCHEDULED | SCHEDULED → IN_PROGRESS → COMPLETED.
  /// String values, not a Prisma enum. No extra fields for completion notes.
  status                   String    @default("SCHEDULED")
  scheduledAt              DateTime?
  /// Expected duration in minutes. Null means duration is not set.
  scheduledDurationMinutes Int?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  property  Property?  @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  estimate  Estimate?  @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  invoices  Invoice[]
  lineItems LineItem[]
  photos    JobPhoto[]

  @@index([businessId])
}

/// Private, owner-facing job documentation. Never surfaced on any public or
/// customer-facing page. Stores only a storage URL/key, never image bytes.
model JobPhoto {
  id         String        @id @default(cuid())
  businessId String
  jobId      String
  stage      JobPhotoStage
  url        String
  caption    String?
  createdAt  DateTime      @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([jobId])
}

model Invoice {
  id               String    @id @default(cuid())
  businessId       String
  customerId       String?
  jobId            String?
  status           String    @default("DRAFT")
  total            Decimal   @default(0)
  /// Set exactly once, when status transitions SENT -> PAID. Never overwritten afterward.
  paidAt           DateTime?
  /// Owner-facing only: CASH | CHECK | ZELLE_BANK_TRANSFER | CARD_EXTERNAL | OTHER. Free-form string, not an enum.
  paymentMethod    String?
  /// Owner-facing only optional note (e.g. check number). Never shown on public/customer pages.
  paymentReference String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  job       Job?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  lineItems LineItem[]

  @@index([businessId])
}

model LineItem {
  id                   String       @id @default(cuid())
  businessId           String
  serviceCatalogItemId String?
  estimateId           String?
  jobId                String?
  invoiceId            String?
  /// Snapshot fields. Catalog price changes must not rewrite these.
  description          String
  quantity             Decimal
  unitPrice            Decimal
  total                Decimal
  type                 LineItemType @default(LABOR)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceCatalogItem ServiceCatalogItem? @relation(fields: [serviceCatalogItemId], references: [id], onDelete: SetNull)
  estimate           Estimate?           @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  job                Job?                @relation(fields: [jobId], references: [id], onDelete: SetNull)
  invoice            Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([estimateId])
  @@index([jobId])
  @@index([invoiceId])
}
