// TBBT Step 1 foundation schema.
// Every business-owned record carries businessId and must be queried
// through the authenticated user's membership. Do not add unscoped lists.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum LineItemType {
  LABOR
  MATERIAL
  OTHER
}

enum JobPhotoStage {
  BEFORE
  DURING
  AFTER
}

/// Who originated an AdditionalWorkRequest. CUSTOMER is the Customer Project
/// Portal's "+ Request Additional Work" (see /p/[token]). EMPLOYEE is the
/// assigned field MEMBER's "Customer Asked for More Work" action (Phase 3 /
/// Step 4 Employee Field Workflow -- see reportAdditionalWorkFromField in
/// src/app/actions/field-job.ts). Both sources create the exact same kind of
/// record with the exact same non-effect: never scope, price, Job total, or
/// Invoice by itself. See the note on AdditionalWorkRequest below.
enum AdditionalWorkRequestSource {
  CUSTOMER
  EMPLOYEE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  /// Platform-level TBBT founder/developer flag -- NOT a business role
  /// and completely independent of Membership/MembershipRole. Grants
  /// access to Founder Design Mode ONLY (see src/lib/founder-access.ts);
  /// a subscriber OWNER is never a TBBT developer just because they own a
  /// business. Never set through any tenant-facing UI/API -- grant or
  /// revoke only via direct database access or
  /// scripts/set-founder-access.mjs.
  isFounder    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships          Membership[]
  sessions             Session[]
  /// One-time credential-setup links for a newly-onboarded team member --
  /// see PasswordSetupToken below. Empty for every user who signed up
  /// themselves (signUpAction already sets a real password).
  passwordSetupTokens  PasswordSetupToken[]
  /// Founder Design Mode cosmetic overrides this user has saved -- see
  /// FounderDesignOverride below. Empty for every non-founder User.
  founderDesignOverrides FounderDesignOverride[]
}

/// Founder/developer-only cosmetic design-token overrides for the
/// approved TBBT UI foundation pages (Dashboard, Requests, Customers,
/// Estimates, Schedule/Jobs, Invoices). Presentation-only: never read by
/// any business-logic code path, never scoped to a Business, and never
/// exposed to any subscriber (OWNER/ADMIN/MEMBER) UI or API -- see
/// src/lib/founder-access.ts. Writing a row requires `userId` to belong
/// to a User with isFounder = true; enforced in
/// src/app/actions/founder-design.ts, not by a database constraint
/// (Founder Design Mode intentionally has no tenant/business scoping of
/// its own -- it is keyed by User, not Business).
model FounderDesignOverride {
  id      String @id @default(cuid())
  userId  String
  /// One of the fixed FOUNDER_PAGE_KEYS in src/lib/founder-design.ts
  /// (e.g. "dashboard", "requests") -- never a free-form/tenant value.
  pageKey String
  /// Validated, bounded token values only -- see resolveFounderTokens()
  /// and the *_BOUNDS constants in src/lib/founder-design.ts. Never HTML,
  /// CSS, or arbitrary strings; every value is clamped server-side before
  /// being written here.
  tokens Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pageKey])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A single-use, expiring, unguessable link letting a newly-onboarded team
/// member set their OWN password -- the smallest secure onboarding
/// mechanism that avoids ever exposing or storing a plaintext password
/// (see addTeamMember() in src/app/actions/team.ts and
/// src/app/set-password/[token]/page.tsx). Mirrors Session's existing
/// hashed-token pattern exactly (sha256 tokenHash stored, raw token only
/// ever in the URL) rather than introducing a new credential concept.
/// OWNER/ADMIN see the raw setup link exactly once, to relay to the new
/// MEMBER by whatever channel they already use (text, email, in person);
/// TBBT does not require email delivery to be configured for this to
/// work. `usedAt` makes the link single-use; `expiresAt` bounds its
/// lifetime the same way a Session's `expiresAt` does.
model PasswordSetupToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Business {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  /// App-level trade code. Only HANDYMAN is active in Phase 1.
  tradeCode           String   @default("HANDYMAN")
  laborMinimumEnabled Boolean  @default(false)
  laborMinimumAmount  Decimal?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  memberships              Membership[]
  customers                Customer[]
  properties               Property[]
  catalogItems             ServiceCatalogItem[]
  serviceRequests          ServiceRequest[]
  estimates                Estimate[]
  estimateVersions         EstimateVersion[]
  estimateVersionLineItems EstimateVersionLineItem[]
  jobs                     Job[]
  invoices                 Invoice[]
  lineItems                LineItem[]
  jobPhotos                JobPhoto[]
  changeOrders             ChangeOrder[]
  additionalWorkRequests   AdditionalWorkRequest[]
  jobProblemReports        JobProblemReport[]
  timeEntries              TimeEntry[]
  timeEntryAdjustments     TimeEntryAdjustment[]
  timesheetWeeks           TimesheetWeek[]
  payrollRuns              PayrollRun[]
  payrollRunItems          PayrollRunItem[]
  payrollRunEvents         PayrollRunEvent[]
  expenses                 Expense[]
  marketingContents        MarketingContent[]
  marketingContentPhotos   MarketingContentPhoto[]
  reviewRequests           ReviewRequest[]
  reviews                  Review[]
  reviewResponses          ReviewResponse[]
  pipelineOpportunities    PipelineOpportunity[]
  settings                 BusinessSettings?
  settingsAuditLogs        SettingsAuditLog[]
  knowledgeEntries         KnowledgeEntry[]
}

model Membership {
  id         String         @id @default(cuid())
  userId     String
  businessId String
  role       MembershipRole
  /// Whether this Membership currently grants access. OWNER/ADMIN can
  /// deactivate a MEMBER's Membership (see removeTeamMember() in
  /// src/app/actions/team.ts) without deleting the row itself, so
  /// historical records that reference this Membership (Job.
  /// assignedMembershipId, JobProblemReport.membershipId) keep working
  /// exactly as they do today. requireWorkspace() only resolves a
  /// workspace from active memberships, so a deactivated MEMBER simply
  /// loses access -- there is no separate "disabled user" flag on User
  /// itself, since a user may still hold an active membership at a
  /// DIFFERENT business.
  active     Boolean        @default(true)
  /// Hourly wage for THIS membership at THIS business. OWNER/ADMIN only
  /// (see CAPABILITIES.MANAGE_TIME_CARDS). Never stored on User -- the
  /// same person may belong to different businesses at different rates.
  /// Null means no rate is on file yet; labor-cost estimates omit that
  /// worker rather than inventing a number. Later wage edits must not
  /// rewrite already-approved TimeEntry / TimesheetWeek snapshots.
  hourlyWage Decimal?
  createdAt  DateTime       @default(now())

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  business       Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Jobs where this Membership (almost always a MEMBER) is the assigned
  /// field employee -- see Job.assignedMembershipId below. Deliberately a
  /// plain one-to-many on Job, not a join table: Phase 3 / Step 4 only
  /// needs ONE assigned member per Job, so a join table would be
  /// unused-crew-management complexity this step explicitly avoids.
  assignedJobs   Job[]              @relation("JobAssignment")
  reportedIssues JobProblemReport[]
  timeEntries    TimeEntry[]
  timesheetWeeks TimesheetWeek[]
  /// Adjustments this membership authored (owner/admin corrections, or a
  /// MEMBER's own correction request). Not the entries they worked.
  authoredAdjustments TimeEntryAdjustment[] @relation("TimeEntryAdjustmentActor")
  approvedTimesheets  TimesheetWeek[]       @relation("TimesheetWeekApprover")
  payrollRunItems     PayrollRunItem[]
  payrollRunEvents    PayrollRunEvent[]     @relation("PayrollRunEventActor")
  reviewedPayrollRuns    PayrollRun[]       @relation("PayrollRunReviewer")
  authorizedPayrollRuns  PayrollRun[]       @relation("PayrollRunAuthorizer")
  processedPayrollRuns   PayrollRun[]       @relation("PayrollRunProcessor")
  purchasedExpenses      Expense[]          @relation("ExpensePurchaser")
  reviewedExpenses       Expense[]          @relation("ExpenseReviewer")
  marketingPhotoGrants   JobPhoto[]         @relation("JobPhotoMarketingGrant")
  createdMarketingContent MarketingContent[] @relation("MarketingContentCreator")
  reviewedMarketingContent MarketingContent[] @relation("MarketingContentReviewer")
  createdReviewRequests   ReviewRequest[]    @relation("ReviewRequestCreator")
  recordedReviews         Review[]           @relation("ReviewRecorder")
  createdReviewResponses  ReviewResponse[]   @relation("ReviewResponseCreator")
  reviewedReviewResponses ReviewResponse[]   @relation("ReviewResponseReviewer")
  settingsAuditLogs        SettingsAuditLog[] @relation("SettingsAuditActor")
  createdKnowledgeEntries  KnowledgeEntry[]   @relation("KnowledgeEntryCreator")
  reviewedKnowledgeEntries KnowledgeEntry[]   @relation("KnowledgeEntryReviewer")

  @@unique([userId, businessId])
  @@index([businessId])
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  email      String?
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  properties      Property[]
  serviceRequests ServiceRequest[]
  estimates       Estimate[]
  jobs            Job[]
  invoices        Invoice[]
  expenses        Expense[]
  reviewRequests  ReviewRequest[]
  reviews         Review[]

  @@index([businessId])
}

model Property {
  id           String   @id @default(cuid())
  businessId   String
  customerId   String
  label        String?
  addressLine1 String
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceRequests ServiceRequest[]
  estimates       Estimate[]
  jobs            Job[]

  @@index([businessId])
  @@index([customerId])
}

model ServiceCatalogItem {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  /// FIXED | STARTING_AT | CUSTOM_QUOTE. Existing rows default to STARTING_AT.
  pricingMode String   @default("STARTING_AT")
  price       Decimal?
  /// Persistent grouping label for this business's price list (e.g.
  /// "Doors & Locks" for a Handyman business). Free-form per business/trade
  /// on purpose -- this is NOT a shared enum, so a future non-Handyman trade
  /// (Cleaning, Painting, Landscaping, ...) can use its own category
  /// vocabulary without any TBBT Core schema change. "Other Services" is
  /// the safe fallback for a service with no meaningful category, matching
  /// the app's pre-existing OTHER_SERVICES_CATEGORY fallback (see
  /// src/lib/service-catalog-category.ts and
  /// src/lib/handyman-starter-catalog.ts).
  category    String   @default("Other Services")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lineItems       LineItem[]
  serviceRequests ServiceRequest[]

  @@index([businessId])
}

model ServiceRequest {
  id          String   @id @default(cuid())
  businessId  String
  customerId  String?
  propertyId  String?
  status      String   @default("OPEN")
  summary     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Selected catalog service at intake time, if any. "Other / Not sure" leaves this null.
  serviceCatalogItemId String?

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  property           Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  serviceCatalogItem ServiceCatalogItem? @relation(fields: [serviceCatalogItemId], references: [id], onDelete: SetNull)
  estimates          Estimate[]
  /// Owner-managed sales state for this request, if any. Created lazily
  /// when the owner records CONTACTED / SITE_VISIT_NEEDS_INFO / FOLLOW_UP /
  /// LOST, a follow-up date, or pipeline notes. New requests appear as
  /// New Lead without a row here.
  pipelineOpportunity PipelineOpportunity?

  @@index([businessId])
}

model Estimate {
  id                     String   @id @default(cuid())
  businessId             String
  customerId             String?
  propertyId             String?
  serviceRequestId       String?
  /// Lifecycle: DRAFT → SENT → APPROVED. String values, not a Prisma enum.
  status                 String   @default("DRAFT")
  total                  Decimal  @default(0)
  laborMinimumWaived     Boolean  @default(false)
  laborMinimumAdjustment Decimal  @default(0)
  publicToken            String   @unique
  /// Points at the EstimateVersion the customer actually approved. Set
  /// exactly once, in the same transaction that flips status SENT ->
  /// APPROVED, and never changed afterward.
  approvedVersionId      String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  property        Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  serviceRequest  ServiceRequest?   @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  jobs            Job[]
  lineItems       LineItem[]
  /// Immutable snapshots created every time this estimate is successfully
  /// sent. Application code must never update or delete an existing row.
  versions        EstimateVersion[] @relation("EstimateVersions")
  approvedVersion EstimateVersion?  @relation("EstimateApprovedVersion", fields: [approvedVersionId], references: [id], onDelete: SetNull)
  /// Owner-managed sales state only for standalone estimates (no
  /// ServiceRequest). Request-linked estimates reuse the request's
  /// PipelineOpportunity -- never a second opportunity row.
  pipelineOpportunity PipelineOpportunity? @relation("PipelineStandaloneEstimate")

  @@index([businessId])
  @@index([propertyId])
}

/// Immutable historical snapshot of an Estimate exactly as it was SENT to a
/// customer. Created exactly once per successful DRAFT -> SENT transition,
/// in the same transaction as that transition. Application code must never
/// update the snapshot fields (versionNumber, total, labor-minimum fields,
/// customer/property snapshot fields, line items) of an existing row --
/// the only field ever written after creation is approvedAt, and only on
/// the single version the customer actually approved.
model EstimateVersion {
  id            String @id @default(cuid())
  businessId    String
  estimateId    String
  versionNumber Int

  /// Snapshot of Estimate totals at the moment this version was sent.
  total                  Decimal
  laborMinimumWaived     Boolean
  laborMinimumAdjustment Decimal

  /// Snapshot of customer/property context needed to reconstruct what was
  /// sent, independent of later edits to the live Customer/Property rows.
  customerName         String?
  customerEmail        String?
  customerPhone        String?
  propertyAddressLine1 String?
  propertyAddressLine2 String?
  propertyCity         String?
  propertyRegion       String?
  propertyPostalCode   String?

  sentAt     DateTime  @default(now())
  /// Set exactly once, only on the version the customer actually approved.
  /// Never overwritten afterward.
  approvedAt DateTime?
  createdAt  DateTime  @default(now())

  business            Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  estimate            Estimate                  @relation("EstimateVersions", fields: [estimateId], references: [id], onDelete: Cascade)
  approvedOnEstimates Estimate[]                @relation("EstimateApprovedVersion")
  /// Jobs/Work Orders created from this exact approved version (see
  /// Job.approvedEstimateVersionId).
  jobsApprovedFrom    Job[]                     @relation("JobApprovedEstimateVersion")
  lineItems           EstimateVersionLineItem[]

  @@unique([estimateId, versionNumber])
  @@index([businessId])
  @@index([estimateId])
}

/// Immutable snapshot of a LineItem as it existed at the moment its parent
/// EstimateVersion was sent. Never edited or deleted by application code.
model EstimateVersionLineItem {
  id                String       @id @default(cuid())
  businessId        String
  estimateVersionId String
  description       String
  quantity          Decimal
  unitPrice         Decimal
  total             Decimal
  type              LineItemType
  createdAt         DateTime     @default(now())

  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  estimateVersion EstimateVersion @relation(fields: [estimateVersionId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([estimateVersionId])
}

model Job {
  id                        String    @id @default(cuid())
  businessId                String
  customerId                String?
  propertyId                String?
  estimateId                String?
  /// The immutable EstimateVersion this Work Order was created from -- the
  /// exact scope/price a customer actually approved, independent of any
  /// later edits to the live (mutable) Estimate. Set once, at Job creation,
  /// from the source Estimate's approvedVersionId. Null only for legacy
  /// Jobs created before this relation existed, or where the source
  /// Estimate had no approved version on record (pre-versioning estimate).
  /// Application code must never fabricate this relation after the fact --
  /// see resolveApprovedWorkOrderScope() in src/lib/job-work-order.ts for
  /// the safe fallback used when it is null.
  approvedEstimateVersionId String?
  /// The single field employee assigned to perform this Job -- Phase 3 /
  /// Step 4's Employee Field Workflow. References Membership (the existing
  /// business-user identity), NOT a separate Employee table -- see the note
  /// on Membership.assignedJobs above. Null means Unassigned, a real and
  /// safe state: existing Jobs created before this column existed simply
  /// stay Unassigned. Only a Membership belonging to THIS Job's own
  /// businessId may ever be set here (enforced in
  /// src/app/actions/job.ts::assignJobMember -- cross-business assignment
  /// must be impossible). onDelete: SetNull so a (currently unsupported)
  /// future membership removal safely unassigns rather than deleting the
  /// Job.
  assignedMembershipId      String?
  /// Unique, unguessable token for the customer-facing Project Portal
  /// (see src/app/p/[token]/page.tsx). Server-scoped to exactly this Job --
  /// the portal route looks a Job up ONLY by this token and never accepts a
  /// businessId from the client. Deliberately separate from
  /// Estimate.publicToken (a different record with a different lifecycle:
  /// estimate approval, not project status).
  projectToken              String    @unique
  /// Lifecycle: UNSCHEDULED | SCHEDULED → IN_PROGRESS → COMPLETED.
  /// String values, not a Prisma enum. No extra fields for completion notes.
  status                    String    @default("SCHEDULED")
  scheduledAt               DateTime?
  /// Expected duration in minutes. Null means duration is not set.
  scheduledDurationMinutes  Int?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  business                Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer                Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  property                Property?               @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  estimate                Estimate?               @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  approvedEstimateVersion EstimateVersion?        @relation("JobApprovedEstimateVersion", fields: [approvedEstimateVersionId], references: [id], onDelete: SetNull)
  assignedMembership      Membership?             @relation("JobAssignment", fields: [assignedMembershipId], references: [id], onDelete: SetNull)
  invoices                Invoice[]
  lineItems               LineItem[]
  photos                  JobPhoto[]
  /// Post-approval scope/pricing changes for this Job. See ChangeOrder below
  /// -- the original approvedEstimateVersion above is never rewritten by
  /// these; they are additive, separately-approved records.
  changeOrders            ChangeOrder[]
  additionalWorkRequests  AdditionalWorkRequest[]
  problemReports          JobProblemReport[]
  timeEntries             TimeEntry[]
  expenses                Expense[]
  marketingContents       MarketingContent[]
  reviewRequests          ReviewRequest[]
  reviews                 Review[]

  @@index([businessId])
  @@index([assignedMembershipId])
}

/// Private, owner-facing job documentation by default. Stores only a
/// storage URL/key, never image bytes. Marketing/public use requires an
/// explicit recorded permission -- existence on a Job is never enough.
model JobPhoto {
  id         String        @id @default(cuid())
  businessId String
  jobId      String
  stage      JobPhotoStage
  url        String
  caption    String?
  createdAt  DateTime      @default(now())
  /// PRIVATE (default) | APPROVED. APPROVED is marketing-eligible only.
  marketingPermissionStatus String @default("PRIVATE")
  marketingPermissionGrantedAt DateTime?
  marketingPermissionGrantedByMembershipId String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  marketingPermissionGrantedBy Membership? @relation("JobPhotoMarketingGrant", fields: [marketingPermissionGrantedByMembershipId], references: [id], onDelete: SetNull)
  marketingContentPhotos MarketingContentPhoto[]

  @@index([businessId])
  @@index([jobId])
  @@index([businessId, marketingPermissionStatus])
}

model Invoice {
  id               String    @id @default(cuid())
  businessId       String
  customerId       String?
  jobId            String?
  status           String    @default("DRAFT")
  total            Decimal   @default(0)
  /// Set exactly once, when status transitions SENT -> PAID. Never overwritten afterward.
  paidAt           DateTime?
  /// Owner-facing only: CASH | CHECK | ZELLE_BANK_TRANSFER | CARD_EXTERNAL | OTHER. Free-form string, not an enum.
  paymentMethod    String?
  /// Owner-facing only optional note (e.g. check number). Never shown on public/customer pages.
  paymentReference String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  job       Job?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  lineItems LineItem[]

  @@index([businessId])
}

model LineItem {
  id                   String       @id @default(cuid())
  businessId           String
  serviceCatalogItemId String?
  estimateId           String?
  jobId                String?
  invoiceId            String?
  /// Attaches this line item to a ChangeOrder's own commercial terms (see
  /// ChangeOrder below). A ChangeOrder line item lives here -- the same
  /// description/quantity/unitPrice/total/type shape already used for
  /// Estimate and Invoice line items -- rather than in a new parallel model.
  /// Only the dedicated change-order server actions
  /// (src/app/actions/change-order.ts) ever read/write rows scoped by this
  /// column, and only while the parent ChangeOrder is still DRAFT; once
  /// SENT, no code path mutates them again (see ChangeOrder.status below).
  changeOrderId        String?
  /// Snapshot fields. Catalog price changes must not rewrite these.
  description          String
  quantity             Decimal
  unitPrice            Decimal
  total                Decimal
  type                 LineItemType @default(LABOR)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceCatalogItem ServiceCatalogItem? @relation(fields: [serviceCatalogItemId], references: [id], onDelete: SetNull)
  estimate           Estimate?           @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  job                Job?                @relation(fields: [jobId], references: [id], onDelete: SetNull)
  invoice            Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  changeOrder        ChangeOrder?        @relation(fields: [changeOrderId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([estimateId])
  @@index([jobId])
  @@index([invoiceId])
  @@index([changeOrderId])
}

/// A separately-approved, post-contract scope/pricing change on a Job,
/// distinct from the original approved Estimate/EstimateVersion (which this
/// never rewrites). Lifecycle: DRAFT -> SENT -> APPROVED, with DECLINED (the
/// customer said no) and CANCELLED (the owner/admin withdrew it before the
/// customer responded) as the only other real states. String status, not a
/// Prisma enum, matching Estimate/Job/Invoice.
///
/// Immutability model: this record's own line items (LineItem rows attached
/// via LineItem.changeOrderId) and `title`/`total` may only be edited by
/// application code while status is DRAFT (enforced in
/// src/app/actions/change-order.ts). Once SENT, no code path updates any of
/// those fields again for the rest of this row's life -- there is no
/// "return to draft" for a Change Order. If a correction is needed after
/// Send, the owner/admin cancels this one (status -> CANCELLED, a terminal
/// state) and creates a new DRAFT ChangeOrder instead. This is deliberately
/// simpler than EstimateVersion's snapshot-on-every-send model: because this
/// row is never mutated again after Send, the row itself already IS the
/// immutable sent snapshot, so a customer approving a SENT ChangeOrder is
/// always approving exactly what is on this record -- there is no staleness
/// window to defend against.
model ChangeOrder {
  id          String    @id @default(cuid())
  businessId  String
  jobId       String
  /// Lifecycle: DRAFT -> SENT -> APPROVED | DECLINED | CANCELLED.
  status      String    @default("DRAFT")
  /// Short customer-facing label for the additional work covered by this
  /// change order, e.g. "Additional tile work in guest bathroom".
  title       String
  /// Sum of this ChangeOrder's own LineItem rows. Recomputed by application
  /// code on every line item add/remove while DRAFT (see
  /// persistChangeOrderTotal in src/lib/change-order.ts); frozen once SENT.
  total       Decimal   @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Set exactly once, on the guarded DRAFT -> SENT transition.
  sentAt      DateTime?
  /// Set exactly once, on the guarded SENT -> APPROVED transition (customer
  /// action, token-scoped -- see src/app/actions/customer-change-order.ts).
  approvedAt  DateTime?
  /// Set exactly once, on the guarded SENT -> DECLINED transition (customer
  /// action).
  declinedAt  DateTime?
  /// Set exactly once, on the guarded DRAFT|SENT -> CANCELLED transition
  /// (owner/admin action). Never set on an APPROVED or DECLINED order.
  cancelledAt DateTime?

  business               Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  job                    Job                     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  lineItems              LineItem[]
  additionalWorkRequests AdditionalWorkRequest[]

  @@index([businessId])
  @@index([jobId])
}

/// A customer's (or, in the future, an employee's -- see `source` below)
/// simple request for additional work on an existing Job. This is
/// deliberately NOT an approval and NEVER changes approved scope, price,
/// Job total, or Invoice total by itself -- it only creates an internal
/// review item. Owner/admin then decides whether to create a ChangeOrder
/// from it (setting changeOrderId + status CONVERTED), handle it outside
/// this feature, or dismiss it (status DISMISSED). Mirrors the existing
/// ServiceRequest OPEN -> CONVERTED pattern.
model AdditionalWorkRequest {
  id            String                      @id @default(cuid())
  businessId    String
  jobId         String
  description   String
  /// OPEN -> CONVERTED | DISMISSED. String status, matching ServiceRequest.
  status        String                      @default("OPEN")
  /// CUSTOMER (submitted from /p/[token]) or EMPLOYEE (submitted from the
  /// assigned field member's Field Job page). See
  /// AdditionalWorkRequestSource above.
  source        AdditionalWorkRequestSource @default(CUSTOMER)
  /// Set once the request leaves OPEN (either converted or dismissed).
  reviewedAt    DateTime?
  /// Set only when an owner/admin creates a ChangeOrder from this request.
  changeOrderId String?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  changeOrder ChangeOrder? @relation(fields: [changeOrderId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([jobId])
  @@index([changeOrderId])
}

/// A factual, operational field issue reported by the assigned MEMBER
/// against their own assigned Job (Phase 3 / Step 4 Employee Field
/// Workflow's "Report Problem"). Deliberately minimal -- not a general
/// ticketing system: no priority, assignment, comments, or attachments.
/// OWNER/ADMIN read these on the Work Order and may mark one RESOLVED;
/// nothing here ever changes Job status, approved scope, price, or the
/// Invoice.
model JobProblemReport {
  id           String    @id @default(cuid())
  businessId   String
  jobId        String
  /// The reporting member -- always the authenticated member's OWN
  /// Membership row for the Job's Business, set server-side (see
  /// reportJobProblem in src/app/actions/field-job.ts). Never accepted as
  /// client input.
  membershipId String
  description  String
  /// OPEN -> RESOLVED. String status, matching ServiceRequest/
  /// AdditionalWorkRequest's existing pattern rather than a Prisma enum.
  status       String    @default("OPEN")
  /// Set once, when an owner/admin marks this RESOLVED.
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  job        Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([jobId])
  @@index([membershipId])
}

/// One clocked or manually-entered interval of labor time. This is the
/// source of labor-hour truth (Time Cards). Distinct from Job.status,
/// which remains operational truth (UNSCHEDULED / SCHEDULED /
/// IN_PROGRESS / COMPLETED). Starting a Job does NOT create a TimeEntry;
/// clocking time does not change Job.status.
///
/// activityType: JOB | TRAVEL | MATERIAL_PICKUP | BREAK | OTHER
/// status: RUNNING | READY | NEEDS_REVIEW | APPROVED
/// source: CLOCK | MANUAL
///
/// BREAK is tracked working-day time but is unpaid (excluded from labor
/// cost). JOB / TRAVEL / MATERIAL_PICKUP / OTHER are paid working time.
/// jobId is required for JOB and optional for the others.
model TimeEntry {
  id           String    @id @default(cuid())
  businessId   String
  membershipId String
  jobId        String?
  activityType String
  status       String    @default("RUNNING")
  startedAt    DateTime
  endedAt      DateTime?
  note         String?
  source       String    @default("CLOCK")
  /// Frozen at week approval for historical integrity. Later wage / job /
  /// catalog changes must not rewrite these. Null until the parent week
  /// is approved (see TimesheetWeek).
  approvedHours       Decimal?
  approvedHourlyWage  Decimal?
  approvedLaborCost   Decimal?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business   Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  membership Membership             @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  job        Job?                   @relation(fields: [jobId], references: [id], onDelete: SetNull)
  adjustments TimeEntryAdjustment[]

  @@index([businessId])
  @@index([membershipId])
  @@index([jobId])
  @@index([businessId, membershipId, status])
  @@index([businessId, startedAt])
}

/// Auditable change history for a TimeEntry. Created on every create,
/// edit, correction-request, approve, and reopen. Application code must
/// never update or delete an existing row -- append only.
model TimeEntryAdjustment {
  id                String   @id @default(cuid())
  businessId        String
  timeEntryId       String
  actorMembershipId String
  /// CREATE | UPDATE | CORRECT | CORRECTION_REQUEST | APPROVE | REOPEN
  action            String
  reason            String?
  previousJson      Json?
  nextJson          Json?
  createdAt         DateTime @default(now())

  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  timeEntry    TimeEntry  @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  actor        Membership @relation("TimeEntryAdjustmentActor", fields: [actorMembershipId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([timeEntryId])
}

/// Weekly approval unit for one worker in one business. Payroll Ready
/// means status = APPROVED. This is a handoff flag only -- Time Cards
/// does not process payroll, taxes, or bank movement.
///
/// weekStartedAt is Sunday 00:00 local (matching startOfWeek() in
/// src/lib/schedule.ts). approvedHours / approvedHourlyWage /
/// approvedLaborCost are snapshots taken at approval.
model TimesheetWeek {
  id                     String    @id @default(cuid())
  businessId             String
  membershipId           String
  weekStartedAt          DateTime
  /// OPEN | APPROVED
  status                 String    @default("OPEN")
  approvedAt             DateTime?
  approvedByMembershipId String?
  approvedHours          Decimal?
  approvedHourlyWage     Decimal?
  approvedLaborCost      Decimal?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  business     Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  membership   Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  approvedBy   Membership? @relation("TimesheetWeekApprover", fields: [approvedByMembershipId], references: [id], onDelete: SetNull)
  payrollRunItems PayrollRunItem[]

  @@unique([businessId, membershipId, weekStartedAt])
  @@index([businessId])
  @@index([membershipId])
  @@index([businessId, status])
}

/// One assembled payroll period for a business. TBBT prepares, reviews,
/// authorizes, and records -- it is NOT a payroll processor. AUTHORIZED
/// and PROCESSED rows freeze their item snapshots; later wage / time /
/// membership edits must not rewrite those amounts.
///
/// status: DRAFT | READY_FOR_REVIEW | REVIEWED | AUTHORIZED | PROCESSED | CANCELLED
/// processedSource: MANUAL_EXTERNAL | PROVIDER (null until processed)
model PayrollRun {
  id         String @id @default(cuid())
  businessId String
  payPeriodStart DateTime
  payPeriodEnd   DateTime
  status     String @default("DRAFT")
  reviewedAt DateTime?
  reviewedByMembershipId String?
  authorizedAt DateTime?
  authorizedByMembershipId String?
  processedAt DateTime?
  processedByMembershipId String?
  processedSource String?
  providerReference String?
  notes      String?
  /// Frozen at OWNER authorization. History views read these, never
  /// recompute from current wages.
  authorizedWorkerCount      Int?
  authorizedApprovedHours    Decimal?
  authorizedGrossLaborAmount Decimal?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business     Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reviewedBy   Membership? @relation("PayrollRunReviewer", fields: [reviewedByMembershipId], references: [id], onDelete: SetNull)
  authorizedBy Membership? @relation("PayrollRunAuthorizer", fields: [authorizedByMembershipId], references: [id], onDelete: SetNull)
  processedBy  Membership? @relation("PayrollRunProcessor", fields: [processedByMembershipId], references: [id], onDelete: SetNull)
  items        PayrollRunItem[]
  events       PayrollRunEvent[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, payPeriodStart])
}

/// One worker-week included in a PayrollRun. Values are copied from the
/// approved TimesheetWeek at inclusion time. AUTHORIZED / PROCESSED items
/// are immutable snapshots.
model PayrollRunItem {
  id                 String   @id @default(cuid())
  businessId         String
  payrollRunId       String
  membershipId       String
  timesheetWeekId    String
  weekStartedAt      DateTime
  regularHours       Decimal
  overtimeHours      Decimal
  approvedHours      Decimal
  approvedHourlyWage Decimal?
  grossLaborAmount   Decimal?
  /// READY | NEEDS_ATTENTION
  readiness          String   @default("NEEDS_ATTENTION")
  /// String[] of PAYROLL_EXCEPTION codes (see src/lib/payroll.ts).
  exceptions         Json     @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payrollRun    PayrollRun    @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  membership    Membership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  timesheetWeek TimesheetWeek @relation(fields: [timesheetWeekId], references: [id], onDelete: Restrict)

  @@unique([payrollRunId, timesheetWeekId])
  @@index([businessId])
  @@index([payrollRunId])
  @@index([membershipId])
  @@index([timesheetWeekId])
}

/// Append-only audit log for consequential payroll actions. Application
/// code must never update or delete an existing row.
model PayrollRunEvent {
  id                String   @id @default(cuid())
  businessId        String
  payrollRunId      String
  actorMembershipId String
  /// CREATE | CHANGE_PERIOD | ADD_ITEM | REMOVE_ITEM | REVIEW | AUTHORIZE | REOPEN | CANCEL | MARK_PROCESSED
  action            String
  reason            String?
  previousJson      Json?
  nextJson          Json?
  createdAt         DateTime @default(now())

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  actor    Membership @relation("PayrollRunEventActor", fields: [actorMembershipId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([payrollRunId])
}

/// A business expense recorded by OWNER/ADMIN. Tenant-private financial
/// record -- always queried through the authenticated workspace
/// businessId. Split allocation is an intentional extension point
/// (parentExpenseId) and is not implemented in this step.
///
/// category: MATERIALS | GAS_FUEL | TOOLS_EQUIPMENT | VEHICLE |
///   OFFICE_ADMIN | SOFTWARE_SUBSCRIPTIONS | INSURANCE |
///   MARKETING_ADVERTISING | MILEAGE | OTHER
/// reimbursementStatus: NONE | PENDING | REIMBURSED
/// reviewStatus: RECORDED | APPROVED | FLAGGED
/// paymentMethod: same vocabulary as Invoice (CASH | CHECK |
///   ZELLE_BANK_TRANSFER | CARD_EXTERNAL | OTHER)
model Expense {
  id                    String    @id @default(cuid())
  businessId            String
  occurredOn            DateTime
  description           String
  amount                Decimal
  category              String
  vendor                String?
  purchaserMembershipId String?
  jobId                 String?
  customerId            String?
  receiptUrl            String?
  reimbursable          Boolean   @default(false)
  reimbursementStatus   String    @default("NONE")
  paymentMethod         String?
  taxCategory           String?
  recurring             Boolean   @default(false)
  recurringNote         String?
  /// Actual miles driven, stored separately from amount. Never used to
  /// invent an IRS/tax rate -- amount is always owner-entered.
  mileageMiles          Decimal?
  notes                 String?
  reviewStatus          String    @default("RECORDED")
  reviewedAt            DateTime?
  reviewedByMembershipId String?
  /// Reserved for future split-allocation children. Unused in this step.
  parentExpenseId       String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaser  Membership? @relation("ExpensePurchaser", fields: [purchaserMembershipId], references: [id], onDelete: SetNull)
  reviewer   Membership? @relation("ExpenseReviewer", fields: [reviewedByMembershipId], references: [id], onDelete: SetNull)
  job        Job?        @relation(fields: [jobId], references: [id], onDelete: SetNull)
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  parent     Expense?    @relation("ExpenseSplit", fields: [parentExpenseId], references: [id], onDelete: SetNull)
  splits     Expense[]   @relation("ExpenseSplit")

  @@index([businessId])
  @@index([businessId, occurredOn])
  @@index([businessId, category])
  @@index([jobId])
  @@index([customerId])
  @@index([purchaserMembershipId])
}

/// Internal marketing content. Never implies an external publish.
/// Status is DRAFT | READY_FOR_REVIEW | APPROVED only -- there is no
/// PUBLISHED state until a real channel integration exists.
model MarketingContent {
  id                     String    @id @default(cuid())
  businessId             String
  jobId                  String?
  contentType            String
  title                  String
  body                   String    @default("")
  channelIntent          String    @default("UNASSIGNED")
  status                 String    @default("DRAFT")
  /// Internal planning date only. Does not publish anything.
  plannedFor             DateTime?
  createdByMembershipId  String
  reviewedByMembershipId String?
  reviewedAt             DateTime?
  /// Optional future Marketing link from a recorded Review. Never auto-copies
  /// review text and never publishes a testimonial.
  reviewId               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  business  Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  job       Job?                     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdBy Membership               @relation("MarketingContentCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  reviewedBy Membership?             @relation("MarketingContentReviewer", fields: [reviewedByMembershipId], references: [id], onDelete: SetNull)
  review    Review?                  @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  photos    MarketingContentPhoto[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, plannedFor])
  @@index([jobId])
  @@index([reviewId])
}

/// Selected marketing-approved JobPhoto on a content draft.
/// The photo must already be APPROVED for marketing at attach time.
model MarketingContentPhoto {
  id         String   @id @default(cuid())
  businessId String
  contentId  String
  jobPhotoId String
  createdAt  DateTime @default(now())

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  content  MarketingContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  jobPhoto JobPhoto         @relation(fields: [jobPhotoId], references: [id], onDelete: Cascade)

  @@unique([contentId, jobPhotoId])
  @@index([businessId])
  @@index([jobPhotoId])
}

/// Internal review-request record. SENT means the owner recorded that a
/// request was sent -- TBBT does not send SMS/email unless a real
/// integration exists. Lifecycle: DRAFT → READY → SENT → COMPLETED,
/// plus CANCELLED. One active (non-cancelled) request per completed Job
/// is enforced in application code.
model ReviewRequest {
  id                    String    @id @default(cuid())
  businessId            String
  customerId            String
  jobId                 String?
  /// DRAFT | READY | SENT | COMPLETED | CANCELLED
  status                String    @default("DRAFT")
  /// GOOGLE | FACEBOOK | OTHER | UNASSIGNED
  intendedPlatform      String    @default("UNASSIGNED")
  requestText           String    @default("")
  notes                 String?
  /// Set when the owner records SENT. Not an automated send timestamp.
  requestedAt           DateTime?
  /// Owner workflow reminder only. Never triggers SMS/email.
  reminderAt            DateTime?
  createdByMembershipId String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job       Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdBy Membership @relation("ReviewRequestCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  reviews   Review[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([customerId])
  @@index([jobId])
}

/// A review the owner recorded as received externally. TBBT does not
/// ingest Google/Facebook reviews in this step. Low ratings flag
/// needsAttention for recovery -- never suppress or retaliate.
model Review {
  id                       String    @id @default(cuid())
  businessId               String
  customerId               String
  jobId                    String?
  reviewRequestId          String?
  /// GOOGLE | FACEBOOK | OTHER
  platform                 String
  /// Present only when the external review actually has a rating.
  rating                   Int?
  reviewText               String    @default("")
  externalReviewDate       DateTime?
  externalUrl              String?
  /// NONE | DRAFT | READY_FOR_REVIEW | APPROVED -- mirrors the latest
  /// ReviewResponse status, or NONE when no response exists.
  responseStatus           String    @default("NONE")
  needsAttention           Boolean   @default(false)
  recoveryNotes            String?
  notes                    String?
  /// Eligible for a future Marketing opportunity. Never auto-copies
  /// review text into public content and never publishes a testimonial.
  marketingEligible        Boolean   @default(false)
  recordedByMembershipId   String
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job          Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  reviewRequest ReviewRequest? @relation(fields: [reviewRequestId], references: [id], onDelete: SetNull)
  recordedBy   Membership      @relation("ReviewRecorder", fields: [recordedByMembershipId], references: [id], onDelete: Restrict)
  responses    ReviewResponse[]
  marketingContents MarketingContent[]

  @@index([businessId])
  @@index([businessId, needsAttention])
  @@index([customerId])
  @@index([jobId])
  @@index([reviewRequestId])
}

/// Editable response draft for a recorded Review. Lifecycle:
/// DRAFT → READY_FOR_REVIEW → APPROVED. Never publishes externally.
model ReviewResponse {
  id                     String    @id @default(cuid())
  businessId             String
  reviewId               String
  body                   String    @default("")
  /// DRAFT | READY_FOR_REVIEW | APPROVED
  status                 String    @default("DRAFT")
  createdByMembershipId  String
  reviewedByMembershipId String?
  reviewedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  review     Review      @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdBy  Membership  @relation("ReviewResponseCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  reviewedBy Membership? @relation("ReviewResponseReviewer", fields: [reviewedByMembershipId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([reviewId])
}

/// Minimum owner-managed sales state for the Deals / Pipeline workspace.
/// This is NOT a second CRM: customer, request, estimate, job, and
/// invoice records stay where they are. A row is created lazily when the
/// owner records a stage that cannot be derived (CONTACTED,
/// SITE_VISIT_NEEDS_INFO, FOLLOW_UP, LOST), a follow-up date, or notes.
///
/// Displayed stage is resolved in src/lib/pipeline.ts from this row PLUS
/// the stronger Estimate/Job lifecycle. An approved estimate or Job
/// always displays as WON, even if ownerStage is still LOST.
model PipelineOpportunity {
  id         String @id @default(cuid())
  businessId String
  /// Opportunity keyed by ServiceRequest when one exists.
  serviceRequestId String? @unique
  /// Standalone estimate (no ServiceRequest). Never set together with
  /// serviceRequestId -- request-linked estimates reuse that request's row.
  standaloneEstimateId String? @unique
  /// CONTACTED | SITE_VISIT_NEEDS_INFO | FOLLOW_UP | LOST. Null until the
  /// owner records a sales state that cannot be derived from Estimate/Job.
  ownerStage String?
  /// Internal owner follow-up date. Never sends SMS/email.
  followUpOn DateTime?
  /// PRICE | OTHER_CONTRACTOR | POSTPONED | UNABLE_TO_REACH |
  /// OUTSIDE_SCOPE | SCHEDULING | OTHER
  lossReason String?
  lossReasonNote String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business           Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceRequest     ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  standaloneEstimate Estimate?       @relation("PipelineStandaloneEstimate", fields: [standaloneEstimateId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, ownerStage])
  @@index([businessId, followUpOn])
}

/// Typed, business-scoped lightweight settings that are not already
/// stored on Business (name, trade, labor minimum). One row per Business.
/// Created lazily by application code -- never a dumping-ground JSON blob.
/// Communication and notification flags are owner preferences only; they
/// never send SMS/email or publish externally.
model BusinessSettings {
  id         String @id @default(cuid())
  businessId String @unique

  estimateCommunicationEnabled     Boolean @default(true)
  scheduleNotificationEnabled      Boolean @default(true)
  invoiceCommunicationEnabled      Boolean @default(true)
  reviewRequestPreferenceEnabled   Boolean @default(false)
  marketingCommunicationEnabled    Boolean @default(false)

  notifyEstimateEvents Boolean @default(true)
  notifyScheduleEvents Boolean @default(true)
  notifyInvoiceEvents  Boolean @default(true)
  notifyPayrollEvents  Boolean @default(true)
  notifyTeamEvents     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

/// Append-only audit trail for consequential Settings changes.
/// Application code must never update or delete an existing row.
/// Never stores passwords, tokens, API secrets, or banking credentials.
model SettingsAuditLog {
  id                    String   @id @default(cuid())
  businessId            String
  changedByMembershipId String
  settingArea           String
  settingKey            String
  previousValue         String?
  newValue              String?
  changedAt             DateTime @default(now())

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  changedBy Membership @relation("SettingsAuditActor", fields: [changedByMembershipId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([businessId, settingArea])
  @@index([businessId, changedAt])
}

/// Internal operational knowledge for one business. This is NOT a second
/// catalog, CRM, or estimate store -- TBBT records stay where they are
/// and are referenced. Owner-created text is never auto-VERIFIED.
/// SYSTEM_DERIVED is reserved for future evidence-backed derivation and
/// is never written by this core implementation.
///
/// category: SERVICES_PRICING | ESTIMATING_TAKEOFFS | JOB_PROCEDURES |
///   CUSTOMERS_POLICIES | VENDORS_MATERIALS | MARKETING_BRAND |
///   SAFETY_COMPLIANCE | TRAINING_HOWTO
/// sourceType: OWNER_CREATED | TBBT_RECORD | EXTERNAL_REFERENCE | SYSTEM_DERIVED
/// sourceKind: SERVICE | ESTIMATE | JOB | EXPENSE | TIME | MARKETING | REVIEW
/// trustState: VERIFIED | SUPPORTED | ESTIMATE | NEEDS_REVIEW | CONFLICT | UNKNOWN
model KnowledgeEntry {
  id         String @id @default(cuid())
  businessId String
  title      String
  category   String
  body       String
  sourceType String
  sourceKind String?
  sourceReferenceId String?
  sourceLabel String?
  trustState String
  archived   Boolean  @default(false)
  createdByMembershipId String
  lastReviewedAt DateTime?
  lastReviewedByMembershipId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy  Membership @relation("KnowledgeEntryCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  reviewedBy Membership? @relation("KnowledgeEntryReviewer", fields: [lastReviewedByMembershipId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, category])
  @@index([businessId, trustState])
  @@index([businessId, archived])
}
