model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  email      String?
  phone      String?
  /// UNKNOWN | GRANTED | REVOKED. Never inferred from phone being present.
  smsConsentStatus    String    @default("UNKNOWN")
  smsConsentUpdatedAt DateTime?
  /// First-touch recorded source only. Never overwritten by later requests.
  firstLeadSource     String?
  firstCampaignId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  firstCampaign   MarketingCampaign? @relation("CustomerFirstCampaign", fields: [firstCampaignId], references: [id], onDelete: SetNull)
  properties      Property[]
  serviceRequests ServiceRequest[]
  estimates       Estimate[]
  jobs            Job[]
  invoices        Invoice[]
  payments        Payment[]
  invoiceCredits  InvoiceCredit[]
  invoiceCollectionWorkItems InvoiceCollectionWorkItem[]
  expenses        Expense[]
  reviewRequests  ReviewRequest[]
  reviews         Review[]
  communications  CustomerCommunication[]
  communicationThreads CommunicationThread[]
  phoneInteractions PhoneInteraction[]
  receptionistEvents ReceptionistEvent[]
  referralRequests ReferralRequest[]
  customerFollowUps CustomerFollowUp[]
  referralsGiven   Referral[] @relation("ReferralSourceCustomer")
  referralsReceived Referral[] @relation("ReferralReferredCustomer")
  growthActionRequests GrowthActionRequest[]
  jobCallbacks         JobCallback[]

  @@index([businessId])
  @@index([firstCampaignId])
}

/// OWNER-confirmed merge of two same-business customers. The absorbed
/// customer id is stored without an FK so that row can be deleted after
/// every relation moves. Matching names never create this record.
model CustomerMerge {
  id                   String   @id @default(cuid())
  businessId           String
  survivorCustomerId   String
  absorbedCustomerId   String
  absorbedSnapshot     Json
  /// Comma-separated email and/or phone. Never "name".
  matchReasons         String
  mergedByMembershipId String?
  createdAt            DateTime @default(now())

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  mergedBy Membership? @relation("CustomerMergeActor", fields: [mergedByMembershipId], references: [id], onDelete: SetNull)

  @@unique([businessId, absorbedCustomerId])
  @@index([businessId])
  @@index([survivorCustomerId])
  @@index([absorbedCustomerId])
}

/// Durable business/customer communication thread. One customer-level
/// thread uses subjectType=CUSTOMER and subjectId=customerId. Never stores
/// secrets. Browser businessId never authorizes these rows.
model CommunicationThread {
  id             String   @id @default(cuid())
  businessId     String
  customerId     String
  /// CUSTOMER | ESTIMATE | JOB | INVOICE | REQUEST | PROPERTY
  subjectType    String   @default("CUSTOMER")
  subjectId      String
  title          String?
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business       Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer       Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  communications CustomerCommunication[]
  phoneInteractions PhoneInteraction[]

  @@unique([businessId, customerId, subjectType, subjectId])
  @@index([businessId, customerId, lastActivityAt])
  @@index([businessId])
}

/// Durable audit trail for attempted customer communications.
/// One row belongs to exactly one Business. Destination is stored as a
/// fingerprint + last-4, not the raw phone/email. Status never claims
/// provider delivery unless a connected adapter reported it.
model CustomerCommunication {
  id                       String    @id @default(cuid())
  businessId               String
  customerId               String
  threadId                 String?
  /// INBOUND | OUTBOUND
  direction                String    @default("OUTBOUND")
  /// SMS | EMAIL | PHONE | MANUAL | PORTAL | SYSTEM
  channel                  String    @default("SMS")
  /// ESTIMATE_READY | APPOINTMENT_CONFIRMATION | APPOINTMENT_REMINDER |
  /// SCHEDULE_CHANGE | INVOICE_READY | PAYMENT_REMINDER | REVIEW_REQUEST |
  /// REVIEW_REMINDER | REFERRAL_REQUEST | JOB_FOLLOW_UP | REPEAT_FOLLOW_UP |
  /// ESTIMATE_FOLLOW_UP | JOB_UPDATE | GENERAL | OWNER_FOLLOW_UP |
  /// MISSED_CALL | MANUAL_PHONE | INBOUND_CALL
  purpose                  String
  subject                  String?
  /// ESTIMATE | JOB | INVOICE | REVIEW_REQUEST | REFERRAL_REQUEST |
  /// CUSTOMER_FOLLOW_UP | SERVICE_REQUEST | PHONE_INTERACTION
  relatedType              String?
  relatedId                String?
  idempotencyKey           String
  destinationLast4         String?
  destinationFingerprint   String?
  /// Safe consent/eligibility snapshot at write time. Never a secret.
  consentContext           String?
  bodySnapshot             String    @default("")
  /// DRAFT | READY | QUEUED | ACCEPTED | SENT | DELIVERED | FAILED | BLOCKED | NOT_SENT
  status                   String
  provider                 String
  providerMessageId        String?
  providerMetadata         Json?
  failureReason            String?
  initiatedByMembershipId  String?
  createdAt                DateTime  @default(now())
  attemptedAt              DateTime?
  updatedAt                DateTime  @updatedAt

  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  thread       CommunicationThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)
  initiatedBy  Membership?          @relation("CustomerCommunicationInitiator", fields: [initiatedByMembershipId], references: [id], onDelete: SetNull)
  phoneInteractions PhoneInteraction[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([customerId])
  @@index([threadId])
  @@index([provider, providerMessageId])
  @@index([businessId, relatedType, relatedId])
  @@index([businessId, customerId, createdAt])
}

/// Manual / missed-call / inbound-call log. Useful before live voice.
/// Never synthesizes a completed provider call.
model PhoneInteraction {
  id                       String    @id @default(cuid())
  businessId               String
  customerId               String?
  threadId                 String?
  communicationId          String?
  /// Concrete ServiceRequest FK. Validated server-side for tenant + customer.
  requestId                String?
  /// Concrete Job FK. Validated server-side for tenant + customer.
  jobId                    String?
  /// Concrete BusinessActionItem FK for the optional callback task.
  followUpActionItemId     String?
  /// MISSED_CALL | MANUAL_PHONE | INBOUND_CALL_EVENT
  kind                     String
  /// LOGGED | CALLBACK_NEEDED | ESCALATED | CLOSED
  status                   String    @default("LOGGED")
  /// INBOUND | OUTBOUND
  direction                String    @default("INBOUND")
  callerLast4              String?
  callerFingerprint        String?
  summary                  String    @default("")
  callbackNeeded           Boolean   @default(false)
  idempotencyKey           String
  initiatedByMembershipId  String?
  occurredAt               DateTime  @default(now())
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  thread       CommunicationThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)
  communication CustomerCommunication? @relation(fields: [communicationId], references: [id], onDelete: SetNull)
  initiatedBy  Membership?          @relation("PhoneInteractionInitiator", fields: [initiatedByMembershipId], references: [id], onDelete: SetNull)
  receptionistEvents ReceptionistEvent[]
  request            ServiceRequest?       @relation(fields: [requestId], references: [id], onDelete: SetNull)
  job                Job?                  @relation(fields: [jobId], references: [id], onDelete: SetNull)
  followUpActionItem BusinessActionItem?   @relation(fields: [followUpActionItemId], references: [id], onDelete: SetNull)

  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([customerId])
  @@index([threadId])
  @@index([requestId])
  @@index([jobId])
  @@index([followUpActionItemId])
}

/// Provider-neutral receptionist domain events. Voice readiness is honest:
/// no Twilio Voice connection, no purchased numbers, no fake completed calls.
model ReceptionistEvent {
  id                       String    @id @default(cuid())
  businessId               String
  customerId               String?
  phoneInteractionId       String?
  /// INBOUND_CALL | CALLER_LOOKUP | QUALIFICATION | CREATE_REQUEST_PROPOSAL |
  /// SCHEDULING_PROPOSAL | MESSAGE_SUMMARY | ESCALATION
  kind                     String
  /// RECORDED | PROPOSED | ESCALATED | SKIPPED_NOT_CONNECTED
  status                   String
  provider                 String    @default("none")
  providerConnected        Boolean   @default(false)
  payload                  Json?
  idempotencyKey           String
  initiatedByMembershipId  String?
  createdAt                DateTime  @default(now())

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  phoneInteraction PhoneInteraction? @relation(fields: [phoneInteractionId], references: [id], onDelete: SetNull)
  initiatedBy      Membership?       @relation("ReceptionistEventInitiator", fields: [initiatedByMembershipId], references: [id], onDelete: SetNull)

  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([customerId])
}

/// Idempotency for provider webhooks (delivery + inbound STOP/START/HELP).
/// Inbound providerEventId is the Twilio MessageSid. Delivery events use
/// `{MessageSid}:{mappedStatus}` so queued → delivered can both apply.
/// Never trusts a browser-supplied businessId.
model CustomerMessagingWebhookEvent {
  id              String   @id @default(cuid())
  provider        String
  providerEventId String
  /// delivery | inbound
  eventKind       String
  businessId      String?
  processedAt     DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId, eventKind])
  @@index([businessId])
}

model Property {
  id           String   @id @default(cuid())
  businessId   String
  customerId   String
  label        String?
  addressLine1 String
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceRequests ServiceRequest[]
  estimates       Estimate[]
  jobs            Job[]

  @@index([businessId])
  @@index([customerId])
}

model ServiceCatalogItem {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  /// Reusable Scope / Included Work. Copied onto estimate lines by encoding
  /// it into LineItem.description — later catalog edits must not rewrite
  /// already-created estimate / version / invoice snapshots.
  description String?
  /// FIXED | STARTING_AT | VARIABLE | CUSTOM_QUOTE. Existing rows default
  /// to STARTING_AT. Allowed modes come from the owning trade config.
  pricingMode String   @default("STARTING_AT")
  price       Decimal?
  /// Persistent grouping label for this business's price list (e.g.
  /// "Doors & Locks" for a Handyman business). Free-form per business/trade
  /// on purpose -- this is NOT a shared enum, so a future non-Handyman trade
  /// (Cleaning, Painting, Landscaping, ...) can use its own category
  /// vocabulary without any TBBT Core schema change. "Other Services" is
  /// the safe fallback for a service with no meaningful category, matching
  /// the app's pre-existing OTHER_SERVICES_CATEGORY fallback (see
  /// src/lib/service-catalog-category.ts and
  /// src/lib/handyman-starter-catalog.ts).
  category    String   @default("Other Services")
  active      Boolean  @default(true)
  /// NONE | OPTIONAL | RECOMMENDED | REQUIRED. Default NONE means the
  /// public request form does not ask for measurements for this item.
  intakeMeasurementMode String @default("NONE")
  /// Comma-separated axes this item cares about: width,height,length.
  /// Empty when measurements are not applicable.
  intakeMeasurementAxes String @default("")
  /// IN | FT. Customer-reported only; never contractor-verified units.
  intakeMeasurementUnit String @default("IN")
  /// Trade this catalog row belongs to. Tenant-scoped: installing Cleaning
  /// never inserts Cleaning services into a Handyman-only business.
  tradeCode String @default("HANDYMAN")
  /// Whether this service may be offered on a recurring cadence. Existing
  /// Handyman rows stay false unless deliberately configured.
  recurrenceEligible Boolean @default(false)
  /// Unit label for VARIABLE / unit-based pricing (for example "room").
  /// Empty when the pricing mode does not use a unit.
  unitLabel String @default("")
  /// Stable customer-facing website slug. Generated once, kept when the
  /// display name changes, unique within the business. Null until first
  /// persist/publish so existing rows can be lazily initialized.
  websiteSlug String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business                     Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lineItems                    LineItem[]
  serviceRequests              ServiceRequest[]
  requestItems                 ServiceRequestItem[]
  additionalWorkRequestItems   AdditionalWorkRequestItem[]
  websiteGalleryItems          WebsiteGalleryItem[]
  websiteLocalPageDrafts       WebsiteLocalPageDraft[]
  operatingProcedures          OperatingProcedure[]

  @@unique([businessId, websiteSlug])
  @@index([businessId])
  @@index([businessId, tradeCode])
}

model ServiceRequest {
  id          String   @id @default(cuid())
  businessId  String
  customerId  String?
  propertyId  String?
  status      String   @default("OPEN")
  summary     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Selected catalog service at intake time, if any. "Other / Not sure" leaves this null.
  serviceCatalogItemId String?
  /// Recorded acquisition source. WEBSITE | REFERRAL | CAMPAIGN | MANUAL |
  /// GOOGLE | FACEBOOK | OTHER. Never inferred from an address.
  leadSource String?
  campaignId String?
  /// First-recorded source at create. Owner correction never overwrites this.
  originalLeadSource String?
  originalCampaignId String?
  /// Public hire/local path recorded at submit, if any. Not a ranking signal.
  landingPagePath String?
  localPageSlug String?
  /// IN_AREA | OUTSIDE_PREFERRED | UNKNOWN. Historical rows stay UNKNOWN.
  serviceAreaQualification String @default("UNKNOWN")
  matchedServiceAreaId String?
  /// Trade under which this request was submitted. Derived from the
  /// authorized business + selected catalog items — never from a browser
  /// trade/business ID.
  tradeCode String @default("HANDYMAN")
  /// Platform schema key (for example handyman.public) frozen at submit.
  intakeSchemaKey String?
  /// Platform schema version frozen at submit. Config changes after this
  /// never reinterpret the stored answers.
  intakeSchemaVersion Int?
  /// Exact intake schema JSON used when the customer submitted.
  intakeSchemaJson String?
  /// Structured answers for the frozen schema. Legacy rows may be null
  /// when answers only live in description / measurements.
  intakeAnswersJson String?
  /// Tenant intake snapshot frozen at submit, if any. Null on historical
  /// platform-only requests (Cleaning V1/V2, Handyman V1). Stored as an
  /// id/version, not a live FK, so later publishes cannot rewrite history.
  tenantIntakeSnapshotId String?
  tenantIntakeSnapshotVersion Int?
  /// ONE_TIME | RECURRING. Existing Handyman requests stay ONE_TIME.
  serviceIntent String @default("ONE_TIME")
  /// WEEKLY | BIWEEKLY | MONTHLY | CUSTOM. Empty when one-time.
  recurrenceCadence String @default("")
  /// Cleaning job this existing-customer "another visit" request came from.
  /// Unique so one source job yields at most one customer-submitted request.
  /// Distinct from Job.nextBookingSourceJobId (OWNER-created Job) and
  /// Job.correctiveCleanSourceJobId. Null on ordinary public hire requests.
  repeatVisitSourceJobId String? @unique

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaign           MarketingCampaign?  @relation("ServiceRequestCampaign", fields: [campaignId], references: [id], onDelete: SetNull)
  matchedServiceArea ServiceArea?        @relation("ServiceRequestMatchedArea", fields: [matchedServiceAreaId], references: [id], onDelete: SetNull)
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  property           Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  serviceCatalogItem ServiceCatalogItem? @relation(fields: [serviceCatalogItemId], references: [id], onDelete: SetNull)
  /// Additional requested tasks for a multi-service visit. Empty on legacy
  /// single-service rows -- those keep using serviceCatalogItemId only.
  items              ServiceRequestItem[]
  photos             ServiceRequestPhoto[]
  measurements       ServiceRequestMeasurement[]
  estimates          Estimate[]
  /// Owner-managed sales state for this request, if any. Created lazily
  /// when the owner records CONTACTED / SITE_VISIT_NEEDS_INFO / FOLLOW_UP /
  /// LOST, a follow-up date, or pipeline notes. New requests appear as
  /// New Lead without a row here.
  pipelineOpportunity PipelineOpportunity?
  growthActionRequests GrowthActionRequest[]
  phoneInteractions   PhoneInteraction[]
  repeatVisitSourceJob Job? @relation("ServiceRequestRepeatVisitSource", fields: [repeatVisitSourceJobId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, tradeCode])
  @@index([campaignId])
  @@index([matchedServiceAreaId])
  @@index([businessId, tenantIntakeSnapshotId])
}

/// OWNER draft of extra intake questions and allowlisted show/hide/require
/// rules. Drafts are never applied to public hire forms. OWNER review
/// publishes a copy into TenantIntakeSnapshot. Historical ServiceRequest
/// snapshots and archived platform schemas are never rewritten from these
/// rows. Draft.status stays DRAFT.
model IntakeConditionDraft {
  id                    String   @id @default(cuid())
  businessId            String
  /// HANDYMAN | CLEANING. Must be an ACTIVE BusinessTrade for this tenant.
  tradeCode             String
  baseSchemaKey         String
  baseSchemaVersion     Int
  /// Always DRAFT in this slice. Application code rejects any other status.
  status                String   @default("DRAFT")
  documentJson          String
  updatedByMembershipId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, tradeCode])
  @@index([businessId])
}

/// Immutable OWNER-reviewed tenant intake snapshot. Application code
/// never updates snapshotJson / schemaVersion / versionNumber after insert.
/// The current pointer is BusinessTrade.publishedIntakeSnapshotId.
/// New public requests freeze this version. Historical ServiceRequest
/// rows and archived Cleaning V1/V2 / Handyman V1 stay exactly as recorded.
model TenantIntakeSnapshot {
  id                      String   @id @default(cuid())
  businessId              String
  /// HANDYMAN | CLEANING | PRESSURE_WASHING. Must match an ACTIVE BusinessTrade.
  tradeCode               String
  versionNumber           Int
  /// Always PUBLISHED. Historical rows stay PUBLISHED after a later version
  /// becomes current.
  status                  String   @default("PUBLISHED")
  schemaVersion           Int      @default(1)
  snapshotJson            String
  summary                 String   @default("")
  publishedAt             DateTime @default(now())
  publishedByMembershipId String?
  idempotencyKey          String?
  createdAt               DateTime @default(now())

  business         Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  publishedBy      Membership?     @relation("TenantIntakeSnapshotAuthor", fields: [publishedByMembershipId], references: [id], onDelete: SetNull)
  currentForTrades BusinessTrade[] @relation("CurrentPublishedIntake")

  @@unique([businessId, tradeCode, versionNumber])
  @@unique([businessId, tradeCode, idempotencyKey])
  @@index([businessId])
  @@index([businessId, tradeCode])
  @@index([publishedByMembershipId])
}

/// One requested task on a public intake ServiceRequest. A customer can
/// select multiple catalog services and/or a custom "Other" task for a
/// single visit. Historical requests may have zero rows here and still
/// remain readable via ServiceRequest.serviceCatalogItemId.
model ServiceRequestItem {
  id                   String   @id @default(cuid())
  businessId           String
  serviceRequestId     String
  serviceCatalogItemId String?
  /// Used when the customer chose "Other / Something Else" (or a catalog
  /// item later became inactive/deleted). Never a comma-separated ID list.
  customDescription    String?
  /// Customer-selected count for this task. Whole numbers only, 1–99.
  /// Never encoded only in notes. Default 1 keeps legacy rows valid.
  quantity             Int      @default(1)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceRequest     ServiceRequest      @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  serviceCatalogItem ServiceCatalogItem? @relation(fields: [serviceCatalogItemId], references: [id], onDelete: SetNull)
  measurements       ServiceRequestMeasurement[]

  @@index([businessId])
  @@index([serviceRequestId])
}

/// Optional customer-uploaded project photos attached at public intake.
/// New photos use private Business Storage (R2) via storedAssetId.
/// Legacy rows may still have a Vercel Blob URL and no stored asset.
model ServiceRequestPhoto {
  id               String   @id @default(cuid())
  businessId       String
  serviceRequestId String
  url              String
  storedAssetId    String?
  createdAt        DateTime @default(now())

  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  storedAsset    StoredAsset?   @relation(fields: [storedAssetId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([serviceRequestId])
  @@index([storedAssetId])
}

/// Approximate project measurements captured at intake or later confirmed
/// by the contractor. Customer-reported rows are never overwritten when a
/// contractor-verified row is added.
model ServiceRequestMeasurement {
  id                     String    @id @default(cuid())
  businessId             String
  serviceRequestId       String
  serviceRequestItemId   String?
  /// CUSTOMER_REPORTED | CONTRACTOR_VERIFIED
  source                 String
  width                  Decimal?
  height                 Decimal?
  length                 Decimal?
  quantity               Int?
  /// IN | FT
  unit                   String
  createdAt              DateTime  @default(now())
  verifiedAt             DateTime?
  verifiedByMembershipId String?

  business             Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceRequest       ServiceRequest      @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  serviceRequestItem   ServiceRequestItem? @relation(fields: [serviceRequestItemId], references: [id], onDelete: SetNull)
  verifiedBy           Membership?         @relation("MeasurementVerifier", fields: [verifiedByMembershipId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([serviceRequestId])
  @@index([serviceRequestItemId])
}

model Estimate {
  id                     String   @id @default(cuid())
  businessId             String
  customerId             String?
  propertyId             String?
  serviceRequestId       String?
  /// Lifecycle: DRAFT → SENT → APPROVED. String values, not a Prisma enum.
  status                 String   @default("DRAFT")
  total                  Decimal  @default(0)
  laborMinimumWaived     Boolean  @default(false)
  laborMinimumAdjustment Decimal  @default(0)
  publicToken            String   @unique
  /// Points at the EstimateVersion the customer actually approved. Set
  /// exactly once, in the same transaction that flips status SENT ->
  /// APPROVED, and never changed afterward.
  approvedVersionId      String?
  /// The frozen EstimateVersionOption the customer chose. Null for
  /// single-option estimates (existing behavior) and for any estimate
  /// that is not yet APPROVED. Set exactly once with approvedVersionId.
  approvedOptionId       String?
  leadSource             String?
  campaignId             String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaign        MarketingCampaign? @relation("EstimateCampaign", fields: [campaignId], references: [id], onDelete: SetNull)
  customer        Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  property        Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  serviceRequest  ServiceRequest?   @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  jobs            Job[]
  lineItems       LineItem[]
  payments        Payment[]
  /// Immutable snapshots created every time this estimate is successfully
  /// sent. Application code must never update or delete an existing row.
  versions        EstimateVersion[] @relation("EstimateVersions")
  approvedVersion EstimateVersion?  @relation("EstimateApprovedVersion", fields: [approvedVersionId], references: [id], onDelete: SetNull)
  /// Live OWNER-authored priced alternatives. Zero rows means a
  /// single-option estimate. Two or three rows is the only multi-option
  /// shape. Mutable only while this Estimate is DRAFT.
  options         EstimateOption[]
  approvedOption  EstimateVersionOption? @relation("EstimateApprovedOption", fields: [approvedOptionId], references: [id], onDelete: SetNull)
  /// Owner-managed sales state only for standalone estimates (no
  /// ServiceRequest). Request-linked estimates reuse the request's
  /// PipelineOpportunity -- never a second opportunity row.
  pipelineOpportunity PipelineOpportunity? @relation("PipelineStandaloneEstimate")
  growthActionRequests GrowthActionRequest[]
  materialPurchaseLists MaterialPurchaseList[]

  @@index([businessId])
  @@index([propertyId])
  @@index([campaignId])
  @@index([approvedOptionId])
}

/// OWNER-named, business-scoped set of draft estimate line snapshots.
/// Apply copies these onto a DRAFT estimate only. Edit / rename / archive
/// change this stored snapshot for future applications. Application code
/// must never rewrite LineItem rows on estimates that already used a
/// template, never write ServiceCatalogItem prices, and never mutate
/// SENT/APPROVED estimates from this model. Not a public catalog and not
/// an hourly rate list.
model EstimateLineTemplate {
  id                    String   @id @default(cuid())
  businessId            String
  name                  String
  /// Case-folded unique key so "Bath refresh" and "bath refresh" collide
  /// under concurrent same-business creates, including rename.
  nameKey               String
  /// Archived templates stay in the workspace (and keep their nameKey)
  /// but are hidden from apply pickers. Existing estimate lines that
  /// already copied this snapshot stay exactly as recorded.
  archived              Boolean  @default(false)
  createdByMembershipId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  business  Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy Membership?                @relation("EstimateLineTemplateCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  lines     EstimateLineTemplateLine[]

  @@unique([businessId, nameKey])
  @@index([businessId, updatedAt])
  @@index([businessId, archived])
}

/// Snapshot of one LABOR / MATERIAL / OTHER draft line stored on a
/// business-scoped EstimateLineTemplate. Prices here are job-draft
/// snapshots, never published catalog hourly rates.
model EstimateLineTemplateLine {
  id          String       @id @default(cuid())
  businessId  String
  templateId  String
  sortOrder   Int
  description String
  quantity    Decimal
  unitPrice   Decimal
  type        LineItemType @default(LABOR)
  createdAt   DateTime     @default(now())

  business Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  template EstimateLineTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([templateId, sortOrder])
}

/// OWNER-authored priced alternative on a DRAFT estimate. Live rows are
/// mutable only while the parent Estimate is DRAFT. Sending freezes a
/// copy onto EstimateVersionOption. Zero rows means a single-option
/// estimate (existing behavior). Two or three rows is the only
/// multi-option shape this product supports. Application code must never
/// write these rows for SENT or APPROVED estimates.
model EstimateOption {
  id         String   @id @default(cuid())
  businessId String
  estimateId String
  /// Owner-facing label, e.g. "Good", "Better", "Best".
  name       String
  /// 1, 2, or 3. Unique per estimate.
  sortOrder  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  estimate  Estimate   @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  lineItems LineItem[]

  @@unique([estimateId, sortOrder])
  @@index([businessId])
  @@index([estimateId])
}

/// Frozen priced alternative captured at send. Application code must never
/// update snapshot fields (sourceOptionId, name, sortOrder, total,
/// laborMinimumAdjustment). The only field written after creation is
/// approvedAt, and only on the single option the customer approved.
model EstimateVersionOption {
  id                     String    @id @default(cuid())
  businessId             String
  estimateVersionId      String
  /// The live EstimateOption.id this snapshot was copied from. Used so
  /// approval can detect a stale choice after Return to Draft + Send.
  /// Not a foreign key — the live row may later be edited or removed.
  sourceOptionId         String
  name                   String
  sortOrder              Int
  total                  Decimal
  laborMinimumAdjustment Decimal
  /// Set exactly once, only on the option the customer actually approved.
  approvedAt             DateTime?
  createdAt              DateTime  @default(now())

  business            Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  estimateVersion     EstimateVersion           @relation(fields: [estimateVersionId], references: [id], onDelete: Cascade)
  lineItems           EstimateVersionLineItem[]
  approvedOnEstimates Estimate[]                @relation("EstimateApprovedOption")
  jobsApprovedFrom    Job[]                     @relation("JobApprovedEstimateOption")

  @@unique([estimateVersionId, sortOrder])
  @@index([businessId])
  @@index([estimateVersionId])
}

/// Immutable historical snapshot of an Estimate exactly as it was SENT to a
/// customer. Created exactly once per successful DRAFT -> SENT transition,
/// in the same transaction as that transition. Application code must never
/// update the snapshot fields (versionNumber, total, labor-minimum fields,
/// customer/property snapshot fields, line items) of an existing row --
/// the only field ever written after creation is approvedAt, and only on
/// the single version the customer actually approved.
model EstimateVersion {
  id            String @id @default(cuid())
  businessId    String
  estimateId    String
  versionNumber Int

  /// Snapshot of Estimate totals at the moment this version was sent.
  total                  Decimal
  laborMinimumWaived     Boolean
  laborMinimumAdjustment Decimal

  /// Snapshot of customer/property context needed to reconstruct what was
  /// sent, independent of later edits to the live Customer/Property rows.
  customerName         String?
  customerEmail        String?
  customerPhone        String?
  propertyAddressLine1 String?
  propertyAddressLine2 String?
  propertyCity         String?
  propertyRegion       String?
  propertyPostalCode   String?

  sentAt     DateTime  @default(now())
  /// Set exactly once, only on the version the customer actually approved.
  /// Never overwritten afterward.
  approvedAt DateTime?
  createdAt  DateTime  @default(now())

  business            Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  estimate            Estimate                  @relation("EstimateVersions", fields: [estimateId], references: [id], onDelete: Cascade)
  approvedOnEstimates Estimate[]                @relation("EstimateApprovedVersion")
  /// Jobs/Work Orders created from this exact approved version (see
  /// Job.approvedEstimateVersionId).
  jobsApprovedFrom    Job[]                     @relation("JobApprovedEstimateVersion")
  lineItems           EstimateVersionLineItem[]
  options             EstimateVersionOption[]
  materialPurchaseLists MaterialPurchaseList[]

  @@unique([estimateId, versionNumber])
  @@index([businessId])
  @@index([estimateId])
}

/// Immutable snapshot of a LineItem as it existed at the moment its parent
/// EstimateVersion was sent. Never edited or deleted by application code.
model EstimateVersionLineItem {
  id                String       @id @default(cuid())
  businessId        String
  estimateVersionId String
  /// Null on single-option snapshots (existing behavior). On a multi-option
  /// send this points at the frozen EstimateVersionOption this line belongs
  /// to. Never edited after insert.
  optionId          String?
  description       String
  quantity          Decimal
  unitPrice         Decimal
  total             Decimal
  type              LineItemType
  createdAt         DateTime     @default(now())

  business        Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  estimateVersion EstimateVersion        @relation(fields: [estimateVersionId], references: [id], onDelete: Cascade)
  option          EstimateVersionOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([estimateVersionId])
  @@index([optionId])
}

model Job {
  id                        String    @id @default(cuid())
  businessId                String
  customerId                String?
  propertyId                String?
  /// Optional office location this Job is associated with. Null is the
  /// historical and default state — existing Jobs and new Jobs created
  /// without an explicit assignment stay unassigned. Application code
  /// must never infer a location from timezone, Stripe, or service area.
  businessLocationId        String?
  /// Source estimate for this Job. Multiple Jobs may share estimateId when
  /// they are recurring occurrences, next bookings, or corrective cleans.
  /// At most one root conversion Job per Estimate is enforced by the
  /// Job_estimateId_conversion_unique partial index in
  /// prisma/migrations/20260929161500_job_one_conversion_per_estimate.
  estimateId                String?
  /// The immutable EstimateVersion this Work Order was created from -- the
  /// exact scope/price a customer actually approved, independent of any
  /// later edits to the live (mutable) Estimate. Set once, at Job creation,
  /// from the source Estimate's approvedVersionId. Null only for legacy
  /// Jobs created before this relation existed, or where the source
  /// Estimate had no approved version on record (pre-versioning estimate).
  /// Application code must never fabricate this relation after the fact --
  /// see resolveApprovedWorkOrderScope() in src/lib/job-work-order.ts for
  /// the safe fallback used when it is null.
  approvedEstimateVersionId String?
  /// The frozen EstimateVersionOption whose lines are this Job's approved
  /// scope. Null for single-option jobs and legacy jobs. Set once at Job
  /// creation from Estimate.approvedOptionId. Never fabricated later.
  approvedEstimateOptionId  String?
  /// The single field employee assigned to perform this Job -- Phase 3 /
  /// Step 4's Employee Field Workflow. References Membership (the existing
  /// business-user identity), NOT a separate Employee table -- see the note
  /// on Membership.assignedJobs above. Null means Unassigned, a real and
  /// safe state: existing Jobs created before this column existed simply
  /// stay Unassigned. Only a Membership belonging to THIS Job's own
  /// businessId may ever be set here (enforced in
  /// src/app/actions/job.ts::assignJobMember -- cross-business assignment
  /// must be impossible). onDelete: SetNull so a (currently unsupported)
  /// future membership removal safely unassigns rather than deleting the
  /// Job.
  assignedMembershipId      String?
  /// Unique, unguessable token for the customer-facing Project Portal
  /// (see src/app/p/[token]/page.tsx). Server-scoped to exactly this Job --
  /// the portal route looks a Job up ONLY by this token and never accepts a
  /// businessId from the client. Deliberately separate from
  /// Estimate.publicToken (a different record with a different lifecycle:
  /// estimate approval, not project status).
  projectToken              String    @unique
  /// Lifecycle: UNSCHEDULED | SCHEDULED → IN_PROGRESS → COMPLETED.
  /// String values, not a Prisma enum. No extra fields for completion notes.
  status                    String    @default("SCHEDULED")
  scheduledAt               DateTime?
  /// Expected duration in minutes. Null means duration is not set.
  scheduledDurationMinutes  Int?
  /// Orthogonal to Job.status. NONE | AWAITING_CUSTOMER | CONFIRMED |
  /// DIFFERENT_TIME_REQUESTED. Confirmation is bound to appointmentProposalId,
  /// never to operational lifecycle (UNSCHEDULED/SCHEDULED/IN_PROGRESS/COMPLETED).
  appointmentConfirmationStatus String @default("NONE")
  /// Increments when scheduledAt or duration materially changes so a stale
  /// confirmation cannot apply to a new slot.
  appointmentProposalId     Int       @default(0)
  appointmentConfirmedAt   DateTime?
  appointmentConfirmedForProposalId Int?
  /// PORTAL | OWNER_PHONE | OWNER_TEXT | OWNER_IN_PERSON | OWNER_OTHER
  appointmentConfirmationSource String?
  appointmentConfirmedByMembershipId String?
  /// Data-driven property access (not trade-specific). See src/lib/property-access.ts.
  propertyAccessMethod      String?
  /// Key location, access-code instructions, pickup instructions, or Other notes.
  /// Sensitive operational information — never put in ordinary emails.
  propertyAccessInstructions String?
  propertyAccessContactName String?
  propertyAccessContactInfo String?
  /// Structured pickup location for KEY_PICKUP_REQUIRED so later scheduling
  /// can account for pickup before the Job. Not a routing engine.
  propertyAccessPickupLocation String?
  propertyAccessNote        String?
  /// Customer note from Request Different Time. Never access instructions.
  appointmentChangeRequestNote String?
  /// SENT | FAILED | SKIPPED_NO_EMAIL | NOT_CONFIGURED
  appointmentNotificationStatus String?
  appointmentNotificationError String?
  appointmentNotifiedAt     DateTime?
  appointmentNotifiedForProposalId Int?
  startWithoutConfirmationAt DateTime?
  startWithoutConfirmationReason String?
  startWithoutConfirmationByMembershipId String?
  leadSource                String?
  campaignId                String?
  /// ONE_TIME | RECURRING. Existing Handyman jobs stay ONE_TIME unless
  /// deliberately configured. Recurrence-ready only — not a billing engine.
  serviceIntent String @default("ONE_TIME")
  /// WEEKLY | BIWEEKLY | MONTHLY | CUSTOM. Empty when one-time.
  recurrenceCadence String @default("")
  /// Parent / source job when this row is a later occurrence.
  /// Later recurring occurrences may share the same source. Not unique.
  recurrenceSourceJobId String?
  /// Completed Cleaning job this OWNER-created next booking was copied from.
  /// Unique so one completed job yields at most one manual next booking.
  /// Distinct from recurrenceSourceJobId and correctiveCleanSourceJobId.
  nextBookingSourceJobId String? @unique
  /// Cleaning job whose visit recorded RE_CLEAN_REQUESTED and that this
  /// OWNER-scheduled corrective Cleaning job was copied from. Unique so
  /// one requested re-clean yields at most one corrective job. Distinct
  /// from nextBookingSourceJobId and recurrenceSourceJobId.
  correctiveCleanSourceJobId String? @unique
  /// Idempotency key for one recurring occurrence: source job + civil date.
  /// Unique so retries and concurrent materialize runs cannot duplicate jobs.
  /// Distinct from nextBookingSourceJobId and correctiveCleanSourceJobId.
  /// Job.recurrenceSourceJobId stays nonunique so later occurrences can share a source.
  recurrenceOccurrenceKey String? @unique
  nextOccurrenceAt DateTime?
  /// ACTIVE | SKIPPED | CANCELLED. Empty when one-time.
  recurrenceStatus String @default("")
  /// Owner-recorded material pickup minutes consumed before the job.
  pickupDurationMinutes     Int?
  /// Arrival window length when later work uses a window instead of an exact time.
  arrivalWindowMinutes      Int?
  /// Comma-separated practical skill keys required for this job.
  requiredSkills            String    @default("")
  /// Optional LEARNING | CAPABLE | LEAD_QUALIFIED floor for assignment.
  requiredProgression       String    @default("")
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  business                Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaign                MarketingCampaign?      @relation("JobCampaign", fields: [campaignId], references: [id], onDelete: SetNull)
  customer                Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  property                Property?               @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  businessLocation        BusinessLocation?       @relation(fields: [businessLocationId], references: [id], onDelete: SetNull)
  estimate                Estimate?               @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  approvedEstimateVersion EstimateVersion?        @relation("JobApprovedEstimateVersion", fields: [approvedEstimateVersionId], references: [id], onDelete: SetNull)
  approvedEstimateOption  EstimateVersionOption?  @relation("JobApprovedEstimateOption", fields: [approvedEstimateOptionId], references: [id], onDelete: SetNull)
  assignedMembership      Membership?             @relation("JobAssignment", fields: [assignedMembershipId], references: [id], onDelete: SetNull)
  appointmentConfirmedBy Membership?            @relation("JobAppointmentConfirmedBy", fields: [appointmentConfirmedByMembershipId], references: [id], onDelete: SetNull)
  startWithoutConfirmationBy Membership?       @relation("JobStartWithoutConfirmationBy", fields: [startWithoutConfirmationByMembershipId], references: [id], onDelete: SetNull)
  appointmentEvents       JobAppointmentEvent[]
  invoices                Invoice[]
  lineItems               LineItem[]
  photos                  JobPhoto[]
  /// Post-approval scope/pricing changes for this Job. See ChangeOrder below
  /// -- the original approvedEstimateVersion above is never rewritten by
  /// these; they are additive, separately-approved records.
  changeOrders            ChangeOrder[]
  additionalWorkRequests  AdditionalWorkRequest[]
  problemReports          JobProblemReport[]
  callbacks               JobCallback[]
  /// One current aftercare document per Job. Job columns stay unchanged.
  aftercareInstruction    JobAftercareInstruction?
  aftercareEvents         JobAftercareEvent[]
  timeEntries             TimeEntry[]
  expenses                Expense[]
  payments                Payment[]
  marketingContents       MarketingContent[]
  reviewRequests          ReviewRequest[]
  reviews                 Review[]
  referralRequests        ReferralRequest[]
  customerFollowUps       CustomerFollowUp[]
  phoneInteractions       PhoneInteraction[]
  recurrenceSource        Job?  @relation("JobRecurrenceSource", fields: [recurrenceSourceJobId], references: [id], onDelete: SetNull)
  recurrenceOccurrences   Job[] @relation("JobRecurrenceSource")
  nextBookingSource       Job?  @relation("JobNextBookingSource", fields: [nextBookingSourceJobId], references: [id], onDelete: SetNull)
  nextBookings            Job[] @relation("JobNextBookingSource")
  correctiveCleanSource   Job?  @relation("JobCorrectiveCleanSource", fields: [correctiveCleanSourceJobId], references: [id], onDelete: SetNull)
  correctiveCleans        Job[] @relation("JobCorrectiveCleanSource")
  growthActionRequests    GrowthActionRequest[]
  workforceOutreachTasks  WorkforceOutreachTask[]
  materialPurchaseLists   MaterialPurchaseList[]
  materialPurchaseOrders  MaterialPurchaseOrder[]
  crewVisit               JobCrewVisit?
  repeatVisitRequest      ServiceRequest? @relation("ServiceRequestRepeatVisitSource")
  /// OWNER-recorded milestones. Relation only — Job itself stores no
  /// milestone columns, so concurrent Job-column migrations do not collide.
  milestones              JobMilestone[]
  milestoneEvents         JobMilestoneEvent[]

  @@index([businessId])
  @@index([assignedMembershipId])
  @@index([businessLocationId])
  @@index([recurrenceSourceJobId])
  @@index([appointmentConfirmedByMembershipId])
  @@index([startWithoutConfirmationByMembershipId])
  @@index([campaignId])
  @@index([approvedEstimateOptionId])
}

/// Append-only appointment communication/confirmation history for one Job.
/// Application code must never update or delete an existing row.
/// Do not store access codes, key locations, or similar sensitive details
/// in payload — those live on Job and are shown only on authorized surfaces.
model JobAppointmentEvent {
  id                       String   @id @default(cuid())
  businessId               String
  jobId                    String
  /// APPOINTMENT_PROPOSED | APPOINTMENT_CONFIRMED | APPOINTMENT_RESCHEDULED |
  /// APPOINTMENT_DIFFERENT_TIME_REQUESTED | APPOINTMENT_CONFIRMATION_OVERRIDE |
  /// APPOINTMENT_NOTIFICATION_SENT | APPOINTMENT_NOTIFICATION_FAILED
  eventType                String
  appointmentProposalId   Int?
  scheduledAt              DateTime?
  scheduledDurationMinutes Int?
  /// CUSTOMER | OWNER | SYSTEM
  actorKind                String
  actorMembershipId       String?
  /// Non-sensitive JSON (method labels, notification status, override reason).
  payload                  String?
  createdAt                DateTime @default(now())

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  job      Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actor    Membership? @relation("JobAppointmentEventActor", fields: [actorMembershipId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([jobId])
  @@index([businessId, createdAt])
}

/// OWNER-recorded, ordered Job milestones.
/// Completion is an explicit OWNER mark only — never inferred from
/// Job.status, Invoice, or JobCrewVisit.checklistJson.
/// Customer Project Portal shows a row only when customerVisible is true
/// for that token-scoped Job. Application code must never send email or
/// SMS from these rows.
model JobMilestone {
  id                      String    @id @default(cuid())
  businessId              String
  jobId                   String
  title                   String
  /// Lowercased trimmed title for per-job duplicate detection.
  titleKey                String
  sortOrder               Int
  /// OWNER-chosen portal exposure. Default hidden from the customer token.
  customerVisible         Boolean   @default(false)
  /// OPEN | COMPLETED. Explicit OWNER mark only.
  status                  String    @default("OPEN")
  completedAt             DateTime?
  completedByMembershipId String?
  createdByMembershipId   String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy   Membership?  @relation("JobMilestoneRecorder", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  completedBy Membership?  @relation("JobMilestoneCompleter", fields: [completedByMembershipId], references: [id], onDelete: SetNull)
  events      JobMilestoneEvent[]

  @@unique([jobId, sortOrder])
  @@unique([jobId, titleKey])
  @@index([businessId])
  @@index([jobId, sortOrder])
  @@index([businessId, jobId])
}

/// Append-only milestone history. Application code must never update or
/// delete an existing row. Status on the event is a snapshot of the
/// milestone at write time, not a live Job/Invoice derivation.
model JobMilestoneEvent {
  id                String   @id @default(cuid())
  businessId        String
  jobId             String
  milestoneId       String
  /// RECORDED | COMPLETED | CUSTOMER_EXPOSED | CUSTOMER_HIDDEN
  eventType         String
  status            String
  actorMembershipId String?
  payload           String?
  createdAt         DateTime @default(now())

  business  Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  job       Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  milestone JobMilestone  @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  actor     Membership?   @relation("JobMilestoneEventActor", fields: [actorMembershipId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([jobId])
  @@index([milestoneId, createdAt])
}

/// Private, owner-facing job documentation by default. Stores only a
/// storage URL/key, never image bytes. Marketing/public use requires an
/// explicit recorded permission -- existence on a Job is never enough.
model JobPhoto {
  id         String        @id @default(cuid())
  businessId String
  jobId      String
  stage      JobPhotoStage
  url        String
  /// New field uploads use private Business Storage (R2) via storedAssetId.
  /// Legacy rows keep a Vercel Blob URL and no stored asset.
  storedAssetId String?
  caption    String?
  createdAt  DateTime      @default(now())
  /// PRIVATE (default) | APPROVED. APPROVED is marketing-eligible only.
  marketingPermissionStatus String @default("PRIVATE")
  marketingPermissionGrantedAt DateTime?
  marketingPermissionGrantedByMembershipId String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  storedAsset StoredAsset? @relation(fields: [storedAssetId], references: [id], onDelete: SetNull)
  marketingPermissionGrantedBy Membership? @relation("JobPhotoMarketingGrant", fields: [marketingPermissionGrantedByMembershipId], references: [id], onDelete: SetNull)
  marketingContentPhotos MarketingContentPhoto[]

  @@index([businessId])
  @@index([jobId])
  @@index([storedAssetId])
  @@index([businessId, marketingPermissionStatus])
}

/// Per-business object-storage allocation. Platform-managed R2 by default.
/// BYO credentials are not stored here — only the chosen bucket/namespace.
/// Usage and quota live on this row so one tenant cannot silently consume
/// unlimited platform storage.
model BusinessStorageAccount {
  id                  String   @id @default(cuid())
  businessId          String   @unique
  /// R2 | S3_COMPATIBLE
  provider            String   @default("R2")
  /// MANAGED | BYO
  mode                String   @default("MANAGED")
  bucketName          String
  /// Immutable tenant prefix, e.g. businesses/{businessId}
  namespacePrefix     String
  /// ACTIVE | SUSPENDED
  status              String   @default("ACTIVE")
  storageLimitBytes   BigInt
  storageUsedBytes    BigInt   @default(0)
  storageReservedBytes BigInt  @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assets   StoredAsset[]

  @@index([provider, mode])
}

/// Provider-neutral file metadata. The bytes live in object storage;
/// this row is the source of truth for ownership, visibility, and quota.
model StoredAsset {
  id               String    @id @default(cuid())
  businessId       String
  storageAccountId String
  customerId       String?
  propertyId       String?
  jobId            String?
  /// WEBSITE_IMAGE | BRAND_ASSET | CUSTOMER_PHOTO | JOB_PHOTO |
  /// BEFORE_PHOTO | AFTER_PHOTO | DOCUMENT | INVOICE_ASSET |
  /// ATTACHMENT | OTHER
  category         String
  purpose          String?
  originalFilename String
  storageKey       String
  mimeType         String
  fileSizeBytes    Int
  width            Int?
  height           Int?
  /// PUBLIC | PRIVATE
  visibility       String    @default("PRIVATE")
  /// PENDING | READY | FAILED | DELETED
  status           String    @default("PENDING")
  publicPath       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  expiresAt        DateTime?

  business       Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storageAccount BusinessStorageAccount @relation(fields: [storageAccountId], references: [id], onDelete: Cascade)
  publicSiteImages     PublicSiteImage[]
  serviceRequestPhotos ServiceRequestPhoto[]
  jobPhotos            JobPhoto[]
  websiteGalleryItems  WebsiteGalleryItem[]
  vaultRecords         BusinessVaultRecord[]
  expenseReceipts      Expense[]

  @@unique([businessId, storageKey])
  @@index([businessId, category, status])
  @@index([storageAccountId, status])
  @@index([businessId, visibility, status])
}

/// Per-business electronic payment destination. Stores only the
/// provider account identifier — never secret keys, bank numbers, or
/// card data. Payment readiness is derived from the processor, not
/// persisted here.
model BusinessPaymentAccount {
  id              String   @id @default(cuid())
  businessId      String   @unique
  /// First implementation: "stripe".
  provider        String
  /// Stripe Accounts v2 connected-account id (acct_...).
  stripeAccountId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([stripeAccountId])
}

/// TBBT SaaS software subscription for one Business. This is what the
/// trade business pays TBBT for access. It is not Stripe Connect and
/// not a contractor-customer invoice/deposit record. Stripe Customer
/// and Subscription ids live here — never on BusinessPaymentAccount.
model BusinessSaasSubscription {
  id                   String    @id @default(cuid())
  businessId           String    @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  /// Stripe subscription status, or "none" before Checkout completes.
  status               String    @default("none")
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  /// Explicit Founder trial window. Never inferred from Business.createdAt.
  trialStartedAt       DateTime?
  trialEndsAt          DateTime?
  /// Eligible for Founder Plan pricing while continuously subscribed.
  founderEligible      Boolean   @default(false)
  /// Set when a Founder-eligible trial first converts to a paid subscription.
  founderConvertedAt   DateTime?
  /// Set when Founder eligibility ends (cancel/terminate). A later restart
  /// is not promised the Founder rate.
  founderEligibilityEndedAt DateTime?
  /// Existing tenants present when Founder trial shipped. Not a trial.
  legacyExempt         Boolean   @default(false)
  /// Set once when existing tenants were marked legacy-exempt.
  saasFounderTrialBackfilledAt DateTime?
  /// Latest Stripe event.created applied to this row. Stale events are ignored.
  lastStripeEventCreatedAt DateTime?
  /// Authoritative catalog plan code (STARTER | FOUNDER | BUSINESS | ENTERPRISE).
  /// Null on historical rows; compatibility resolves those to FOUNDER.
  planCode             String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@index([planCode])
}

/// Optional add-on entitlement source. Independently tracked from the
/// base SaaS plan. No secrets. Cross-tenant assignment is impossible
/// because writes always use the server workspace businessId.
model BusinessProductAddon {
  id          String    @id @default(cuid())
  businessId  String
  addonCode   String
  status      String    @default("INACTIVE")
  quantity    Int       @default(1)
  source      String    @default("SUPPORT")
  /// Provider subscription-item / reference id. Never a secret.
  providerRef String?
  grantedAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, addonCode])
  @@index([businessId, status])
}

/// Explicit support / grandfather grants. Additive, auditable, tenant-scoped.
/// Never browser-controlled. Never a hidden plan-code special case.
model BusinessProductGrant {
  id         String    @id @default(cuid())
  businessId String
  grantType  String
  code       String
  quantity   Int?
  status     String    @default("ACTIVE")
  source     String    @default("SUPPORT")
  /// Idempotency key for a logical support/provider grant. Null means
  /// an independent grant. Never a secret.
  sourceRef  String?
  note       String?
  grantedAt  DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@unique([businessId, grantType, code, source, sourceRef])
}

/// Idempotency log for TBBT SaaS billing webhooks. Distinct from the
/// Payment table used by Stripe Connect invoice/deposit Checkout.
model SaasBillingWebhookEvent {
  id                   String    @id @default(cuid())
  stripeEventId        String    @unique
  eventType            String
  businessId           String?
  stripeEventCreatedAt DateTime?
  processedAt          DateTime  @default(now())

  @@index([businessId])
}

model Invoice {
  id               String    @id @default(cuid())
  businessId       String
  customerId       String?
  jobId            String?
  /// ORIGINAL | SUPPLEMENTAL. Exactly one ORIGINAL per job is enforced by
  /// a partial unique index in the migration. The migration first ranks
  /// legacy duplicate Invoice rows (oldest createdAt, then id) as ORIGINAL
  /// and later rows as SUPPLEMENTAL — it never merges or deletes history.
  /// A SUPPLEMENTAL / balance invoice bills approved Change Orders that
  /// were not on the original invoice. Existing invoice totals are never
  /// rewritten.
  kind             String    @default("ORIGINAL")
  status           String    @default("DRAFT")
  total            Decimal   @default(0)
  /// Set exactly once, when status transitions SENT -> PAID. Never overwritten afterward.
  paidAt           DateTime?
  /// Owner-facing only: CASH | CHECK | ZELLE_BANK_TRANSFER | CARD_EXTERNAL | OTHER | STRIPE. Free-form string, not an enum. STRIPE is set by the processor webhook, never by Mark Paid.
  paymentMethod    String?
  /// Owner-facing only optional note (e.g. check number). Never shown on public/customer pages.
  paymentReference String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  business             Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer             Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  job                  Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  lineItems            LineItem[]
  payments             Payment[]
  credits              InvoiceCredit[]
  checkoutSessions     InvoiceCheckoutSession[]
  billedChangeOrders   ChangeOrder[]
  collectionWorkItems  InvoiceCollectionWorkItem[]

  @@index([businessId])
  @@index([jobId, kind])
}

/// Durable payment record — source of truth for material deposits and
/// invoice credits. Do not store "deposit paid" as a boolean. Amounts
/// are whole cents. Stripe Checkout session/payment-intent ids are
/// unique so webhook retries cannot double-credit.
model Payment {
  id                      String    @id @default(cuid())
  businessId              String
  customerId              String?
  estimateId              String?
  jobId                   String?
  invoiceId               String?
  /// MATERIAL_DEPOSIT | INVOICE_BALANCE
  purpose                 String
  amount                  Decimal
  /// CASH | CHECK | ZELLE_BANK_TRANSFER | CARD_EXTERNAL | OTHER | STRIPE
  method                  String
  receivedAt              DateTime  @default(now())
  note                    String?
  stripeCheckoutSessionId String?   @unique
  stripePaymentIntentId   String?   @unique
  /// Set when OWNER acknowledges a STRIPE_CREDIT_MISMATCH_REVIEW flag.
  /// Null means the flag is still open on Dashboard / Reports.
  stripeCreditMismatchResolvedAt DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  estimate Estimate? @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  job      Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  invoice  Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([estimateId])
  @@index([jobId])
  @@index([invoiceId])
}

/// Expected Stripe Checkout amount at session creation. Webhooks that
/// match this session id and amount are accepted even if later credits
/// changed remaining due. Additive only. Sessions created before this
/// table fall back to historical remaining-due amounts.
model InvoiceCheckoutSession {
  id              String   @id @default(cuid())
  businessId      String
  invoiceId       String
  stripeSessionId String   @unique
  amountCents     Int
  createdAt       DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([invoiceId])
}

/// OWNER-recorded collections work for one invoice. Next step and
/// resolution are workspace notes only. They never mark an invoice paid,
/// never write a Payment, and never send a reminder.
model InvoiceCollectionWorkItem {
  id                    String    @id @default(cuid())
  businessId            String
  invoiceId             String
  customerId            String?
  /// OPEN | RESOLVED
  status                String    @default("OPEN")
  /// CALL | EMAIL | WAIT | OTHER
  nextStep              String?
  note                  String    @default("")
  createdByMembershipId String?
  updatedByMembershipId String?
  resolvedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  business  Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice   Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customer  Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy Membership? @relation("InvoiceCollectionWorkItemCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  updatedBy Membership? @relation("InvoiceCollectionWorkItemUpdater", fields: [updatedByMembershipId], references: [id], onDelete: SetNull)

  @@unique([businessId, invoiceId])
  @@index([businessId, status])
  @@index([invoiceId])
  @@index([customerId])
}

/// OWNER-recorded internal credit / correction against an issued invoice.
/// Additive only. Never rewrites Invoice.total, LineItem snapshots, or
/// Payment rows. Never issues a Stripe refund or customer message.
/// Remaining due = invoice total − attributed payments − recorded credits.
model InvoiceCredit {
  id                     String   @id @default(cuid())
  businessId             String
  invoiceId              String
  customerId             String?
  /// Positive credit amount. Whole cents only (at most two decimal places).
  /// Not a payment and not a refund.
  amount                 Decimal
  reason                 String
  recordedByMembershipId String
  /// Client-supplied idempotency key. Duplicate submit returns this row.
  idempotencyKey         String
  createdAt              DateTime @default(now())

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice    Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  recordedBy Membership @relation("InvoiceCreditRecorder", fields: [recordedByMembershipId], references: [id], onDelete: Restrict)

  @@unique([businessId, invoiceId, idempotencyKey])
  @@index([businessId])
  @@index([invoiceId])
  @@index([customerId])
  @@index([recordedByMembershipId])
}

/// Detection ledger for revenue-integrity backfills that joined on
/// jobId/estimateId without businessId equality. Rows are recorded
/// only. Application code must never use this table to reassign
/// Invoice, Payment, or ChangeOrder ownership.
model RevenueIntegrityBusinessIsolationFinding {
  id                String   @id
  category          String
  recordTable       String
  recordId          String
  recordBusinessId  String
  attachedInvoiceId String?
  invoiceBusinessId String?
  jobId             String?
  jobBusinessId     String?
  detectedAt        DateTime @default(now())

  @@unique([recordTable, recordId, category])
  @@index([category])
}

model LineItem {
  id                   String       @id @default(cuid())
  businessId           String
  serviceCatalogItemId String?
  estimateId           String?
  jobId                String?
  invoiceId            String?
  /// Attaches this line item to a ChangeOrder's own commercial terms (see
  /// ChangeOrder below). A ChangeOrder line item lives here -- the same
  /// description/quantity/unitPrice/total/type shape already used for
  /// Estimate and Invoice line items -- rather than in a new parallel model.
  /// Only the dedicated change-order server actions
  /// (src/app/actions/change-order.ts) ever read/write rows scoped by this
  /// column, and only while the parent ChangeOrder is still DRAFT; once
  /// SENT, no code path mutates them again (see ChangeOrder.status below).
  changeOrderId        String?
  /// Live priced-option assignment on a DRAFT estimate. Null on
  /// single-option estimates. Must belong to an EstimateOption on the
  /// same estimate and business. Ignored for job/invoice/change-order
  /// lines.
  optionId             String?
  /// Snapshot fields. Catalog price changes must not rewrite these.
  /// Optional Scope / Included Work is encoded in description after
  /// INCLUDED_WORK_MARKER. Internal calculator snapshots use
  /// CALCULATOR_SNAPSHOT_MARKER. Owner-only material takeoff uses
  /// MATERIAL_TAKEOFF_MARKER (see src/lib/estimate-line-scope.ts).
  /// Owner material-deposit override uses MATERIAL_DEPOSIT_MARKER.
  /// Owner Final Customer Materials Total override uses
  /// CUSTOMER_MATERIALS_TOTAL_MARKER and is read by persistDraftEstimateTotal
  /// so the customer estimate can use that lump sum instead of summing
  /// MATERIAL line prices. Do not add a Preview-breaking column for these.
  description          String
  quantity             Decimal
  unitPrice            Decimal
  total                Decimal
  type                 LineItemType @default(LABOR)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceCatalogItem ServiceCatalogItem? @relation(fields: [serviceCatalogItemId], references: [id], onDelete: SetNull)
  estimate           Estimate?           @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  job                Job?                @relation(fields: [jobId], references: [id], onDelete: SetNull)
  invoice            Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  changeOrder        ChangeOrder?        @relation(fields: [changeOrderId], references: [id], onDelete: SetNull)
  option             EstimateOption?     @relation(fields: [optionId], references: [id], onDelete: SetNull)
  materialPurchaseListItems MaterialPurchaseListItem[]

  @@index([businessId])
  @@index([estimateId])
  @@index([jobId])
  @@index([invoiceId])
  @@index([changeOrderId])
  @@index([optionId])
}

/// A separately-approved, post-contract scope/pricing change on a Job,
/// distinct from the original approved Estimate/EstimateVersion (which this
/// never rewrites). Lifecycle: DRAFT -> SENT -> APPROVED, with DECLINED (the
/// customer said no) and CANCELLED (the owner/admin withdrew it before the
/// customer responded) as the only other real states. String status, not a
/// Prisma enum, matching Estimate/Job/Invoice.
///
/// Immutability model: this record's own line items (LineItem rows attached
/// via LineItem.changeOrderId) and `title`/`total` may only be edited by
/// application code while status is DRAFT (enforced in
/// src/app/actions/change-order.ts). Once SENT, no code path updates any of
/// those fields again for the rest of this row's life -- there is no
/// "return to draft" for a Change Order. If a correction is needed after
/// Send, the owner/admin cancels this one (status -> CANCELLED, a terminal
/// state) and creates a new DRAFT ChangeOrder instead. This is deliberately
/// simpler than EstimateVersion's snapshot-on-every-send model: because this
/// row is never mutated again after Send, the row itself already IS the
/// immutable sent snapshot, so a customer approving a SENT ChangeOrder is
/// always approving exactly what is on this record -- there is no staleness
/// window to defend against.
model ChangeOrder {
  id          String    @id @default(cuid())
  businessId  String
  jobId       String
  /// Lifecycle: DRAFT -> SENT -> APPROVED | DECLINED | CANCELLED.
  status      String    @default("DRAFT")
  /// Short customer-facing label for the additional work covered by this
  /// change order, e.g. "Additional tile work in guest bathroom".
  title       String
  /// Sum of this ChangeOrder's own LineItem rows. Recomputed by application
  /// code on every line item add/remove while DRAFT (see
  /// persistChangeOrderTotal in src/lib/change-order.ts); frozen once SENT.
  total       Decimal   @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Set exactly once, on the guarded DRAFT -> SENT transition.
  sentAt      DateTime?
  /// Set exactly once, on the guarded SENT -> APPROVED transition (customer
  /// action, token-scoped -- see src/app/actions/customer-change-order.ts).
  approvedAt  DateTime?
  /// Set exactly once, on the guarded SENT -> DECLINED transition (customer
  /// action).
  declinedAt  DateTime?
  /// Set exactly once, on the guarded DRAFT|SENT -> CANCELLED transition
  /// (owner/admin action). Never set on an APPROVED or DECLINED order.
  cancelledAt DateTime?
  /// Set when this approved Change Order is copied onto an Invoice.
  /// Null means not yet billed. A Change Order is billed at most once —
  /// this column is the integrity guard that replaced one-invoice-per-job.
  invoiceId   String?

  business               Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  job                    Job                     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  invoice                Invoice?                @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  lineItems              LineItem[]
  additionalWorkRequests AdditionalWorkRequest[]

  @@index([businessId])
  @@index([jobId])
  @@index([invoiceId])
}

/// A customer's (or, in the future, an employee's -- see `source` below)
/// simple request for additional work on an existing Job. This is
/// deliberately NOT an approval and NEVER changes approved scope, price,
/// Job total, or Invoice total by itself -- it only creates an internal
/// review item. Owner/admin then decides whether to create a ChangeOrder
/// from it (setting changeOrderId + status CONVERTED), handle it outside
/// this feature, or dismiss it (status DISMISSED). Mirrors the existing
/// ServiceRequest OPEN -> CONVERTED pattern.
model AdditionalWorkRequest {
  id            String                      @id @default(cuid())
  businessId    String
  jobId         String
  description   String
  /// OPEN -> CONVERTED | DISMISSED. String status, matching ServiceRequest.
  status        String                      @default("OPEN")
  /// CUSTOMER (submitted from /p/[token]) or EMPLOYEE (submitted from the
  /// assigned field member's Field Job page). See
  /// AdditionalWorkRequestSource above.
  source        AdditionalWorkRequestSource @default(CUSTOMER)
  /// Set once the request leaves OPEN (either converted or dismissed).
  reviewedAt    DateTime?
  /// Set only when an owner/admin creates a ChangeOrder from this request.
  changeOrderId String?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  changeOrder ChangeOrder? @relation(fields: [changeOrderId], references: [id], onDelete: SetNull)
  items       AdditionalWorkRequestItem[]

  @@index([businessId])
  @@index([jobId])
  @@index([changeOrderId])
}

/// One requested task on a customer Additional Work request. Catalog
/// selections persist the ServiceCatalogItem id (not only the name) so
/// Create draft can prefill Change Order lines from the live catalog.
/// Legacy requests may have zero rows and remain description-only.
model AdditionalWorkRequestItem {
  id                      String   @id @default(cuid())
  businessId              String
  additionalWorkRequestId String
  serviceCatalogItemId    String?
  /// Used when the customer chose "Something else / Other".
  customDescription       String?
  /// Customer-selected count for this task. Whole numbers only, 1–99.
  quantity                Int      @default(1)
  sortOrder               Int      @default(0)
  createdAt               DateTime @default(now())

  business                Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  additionalWorkRequest   AdditionalWorkRequest   @relation(fields: [additionalWorkRequestId], references: [id], onDelete: Cascade)
  serviceCatalogItem      ServiceCatalogItem?     @relation(fields: [serviceCatalogItemId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([additionalWorkRequestId])
}

/// A factual, operational field issue reported by the assigned MEMBER
/// against their own assigned Job (Phase 3 / Step 4 Employee Field
/// Workflow's "Report Problem"). Deliberately minimal -- not a general
/// ticketing system: no priority, assignment, comments, or attachments.
/// OWNER/ADMIN read these on the Work Order and may mark one RESOLVED;
/// nothing here ever changes Job status, approved scope, price, or the
/// Invoice.
model JobProblemReport {
  id           String    @id @default(cuid())
  businessId   String
  jobId        String
  /// The reporting member -- always the authenticated member's OWN
  /// Membership row for the Job's Business, set server-side (see
  /// reportJobProblem in src/app/actions/field-job.ts). Never accepted as
  /// client input.
  membershipId String
  description  String
  /// OPEN -> RESOLVED. String status, matching ServiceRequest/
  /// AdditionalWorkRequest's existing pattern rather than a Prisma enum.
  status       String    @default("OPEN")
  /// Set once, when an owner/admin marks this RESOLVED.
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  job        Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([jobId])
  @@index([membershipId])
}

/// OWNER-recorded or customer-portal-submitted callback against a
/// completed same-business Job. Portal submissions resolve the Job from
/// projectToken only and reuse this review path. Trade-neutral
/// operational review only — never a warranty coverage or legal
/// determination, and never an invoice, scheduled Job, or customer
/// message by itself. Distinct from AdditionalWorkRequest (portal/field
/// extra-work review) and JobProblemReport (assigned-member field issues).
///
/// Status: RECORDED -> UNDER_REVIEW -> OUTCOME_RECORDED.
/// At most one open (RECORDED | UNDER_REVIEW) row per Job is enforced by
/// a partial unique index in the migration, not here — Prisma cannot
/// express that WHERE clause.
model JobCallback {
  id                       String    @id @default(cuid())
  businessId               String
  jobId                    String
  customerId               String?
  /// Customer-reported description as the OWNER recorded it.
  description              String
  /// PHONE | TEXT | EMAIL | IN_PERSON | PORTAL | OTHER
  reportedVia              String
  /// RECORDED | UNDER_REVIEW | OUTCOME_RECORDED
  status                   String    @default("RECORDED")
  /// WILL_FOLLOW_UP | NO_RETURN_VISIT | CUSTOMER_WITHDREW | RECORDED_ONLY
  /// Operational outcome only — never COVERED / NOT_COVERED.
  outcome                  String?
  outcomeNotes             String?
  recordedByMembershipId   String
  reviewedByMembershipId   String?
  outcomeByMembershipId    String?
  recordedAt               DateTime  @default(now())
  reviewedAt               DateTime?
  outcomeAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  job        Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  recordedBy Membership @relation("JobCallbackRecorder", fields: [recordedByMembershipId], references: [id], onDelete: Restrict)
  reviewedBy Membership? @relation("JobCallbackReviewer", fields: [reviewedByMembershipId], references: [id], onDelete: SetNull)
  outcomeBy  Membership? @relation("JobCallbackOutcome", fields: [outcomeByMembershipId], references: [id], onDelete: SetNull)
  events     JobCallbackEvent[]

  @@index([businessId])
  @@index([jobId])
  @@index([businessId, status])
  @@index([customerId])
}

/// Append-only status history for one JobCallback.
/// Application code must never update or delete an existing row.
model JobCallbackEvent {
  id                String   @id @default(cuid())
  businessId        String
  callbackId        String
  /// RECORDED | REVIEWED | OUTCOME_RECORDED
  eventType         String
  fromStatus        String?
  toStatus          String
  actorMembershipId String
  /// Non-sensitive JSON (reportedVia, outcome, note length). Never a
  /// coverage determination or customer message payload.
  payload           String?
  createdAt         DateTime @default(now())

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  callback JobCallback @relation(fields: [callbackId], references: [id], onDelete: Cascade)
  actor    Membership  @relation("JobCallbackEventActor", fields: [actorMembershipId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([callbackId, createdAt])
}

/// OWNER-authored aftercare instructions for a completed same-business Job.
/// One current document per Job. Drafts and ownerNotes are never visible
/// to Job.projectToken. The customer token may read publishedInstructions
/// only while status is PUBLISHED. Application code must never send email
/// or SMS from these rows. Distinct from JobCallback (operational review)
/// and JobMilestone (progress steps). Warranty terms are displayed from
/// recorded sources only — never invented here.
///
/// Status: DRAFT | PUBLISHED | UNPUBLISHED
model JobAftercareInstruction {
  id                         String    @id @default(cuid())
  businessId                 String
  jobId                      String    @unique
  /// Current owner working copy. Hidden from the project token.
  draftInstructions          String    @default("")
  /// Private owner notes. Hidden from the project token. Never published.
  ownerNotes                 String    @default("")
  /// Snapshot last explicitly published. Null until first publish and
  /// after an unpublish so a token query cannot leak revoked wording.
  publishedInstructions      String?
  /// DRAFT | PUBLISHED | UNPUBLISHED
  status                     String    @default("DRAFT")
  createdByMembershipId      String
  updatedByMembershipId      String?
  publishedByMembershipId    String?
  unpublishedByMembershipId  String?
  publishedAt                DateTime?
  unpublishedAt              DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  business      Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  job           Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy     Membership @relation("JobAftercareCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  updatedBy     Membership? @relation("JobAftercareUpdater", fields: [updatedByMembershipId], references: [id], onDelete: SetNull)
  publishedBy   Membership? @relation("JobAftercarePublisher", fields: [publishedByMembershipId], references: [id], onDelete: SetNull)
  unpublishedBy Membership? @relation("JobAftercareUnpublisher", fields: [unpublishedByMembershipId], references: [id], onDelete: SetNull)
  events        JobAftercareEvent[]

  @@index([businessId])
  @@index([businessId, status])
}

/// Append-only aftercare history. Application code must never update or
/// delete an existing row. instructionsSnapshot is the customer-facing
/// wording at that event. Owner notes are never stored here.
model JobAftercareEvent {
  id                    String   @id @default(cuid())
  businessId            String
  jobId                 String
  aftercareId           String
  /// DRAFTED | REVISED | PUBLISHED | UNPUBLISHED
  eventType             String
  fromStatus            String?
  toStatus              String
  /// Historical wording of the customer-facing instructions at this event.
  instructionsSnapshot  String?
  actorMembershipId     String
  /// Non-sensitive JSON (instruction length). Never owner notes, never a
  /// customer message payload, never a coverage determination.
  payload               String?
  createdAt             DateTime @default(now())

  business  Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  job       Job                      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  aftercare JobAftercareInstruction  @relation(fields: [aftercareId], references: [id], onDelete: Cascade)
  actor     Membership               @relation("JobAftercareEventActor", fields: [actorMembershipId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([jobId])
  @@index([aftercareId, createdAt])
}

/// One clocked or manually-entered interval of labor time. This is the
/// source of labor-hour truth (Time Cards). Distinct from Job.status,
/// which remains operational truth (UNSCHEDULED / SCHEDULED /
/// IN_PROGRESS / COMPLETED). Starting a Job does NOT create a TimeEntry;
/// clocking time does not change Job.status.
///
/// activityType: JOB | TRAVEL | MATERIAL_PICKUP | BREAK | OTHER
/// status: RUNNING | READY | NEEDS_REVIEW | APPROVED
/// source: CLOCK | MANUAL
///
/// BREAK is tracked working-day time but is unpaid (excluded from labor
/// cost). JOB / TRAVEL / MATERIAL_PICKUP / OTHER are paid working time.
/// jobId is required for JOB and optional for the others.
model TimeEntry {
  id           String    @id @default(cuid())
  businessId   String
  membershipId String
  jobId        String?
  activityType String
  status       String    @default("RUNNING")
  startedAt    DateTime
  endedAt      DateTime?
  note         String?
  source       String    @default("CLOCK")
  /// Frozen at week approval for historical integrity. Later wage / job /
  /// catalog changes must not rewrite these. Null until the parent week
  /// is approved (see TimesheetWeek).
  approvedHours       Decimal?
  approvedHourlyWage  Decimal?
  approvedLaborCost   Decimal?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business   Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  membership Membership             @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  job        Job?                   @relation(fields: [jobId], references: [id], onDelete: SetNull)
  adjustments TimeEntryAdjustment[]
  correctionRequests TimeCorrectionRequest[]

  @@index([businessId])
  @@index([membershipId])
  @@index([jobId])
  @@index([businessId, membershipId, status])
  @@index([businessId, startedAt])
}

/// Auditable change history for a TimeEntry. Created on every create,
/// edit, correction-request, owner decision, approve, and reopen.
/// Application code must never update or delete an existing row --
/// append only.
model TimeEntryAdjustment {
  id                String   @id @default(cuid())
  businessId        String
  timeEntryId       String
  actorMembershipId String
  /// CREATE | UPDATE | CORRECT | CORRECTION_REQUEST | CORRECTION_DECLINED | APPROVE | REOPEN
  action            String
  reason            String?
  previousJson      Json?
  nextJson          Json?
  createdAt         DateTime @default(now())

  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  timeEntry    TimeEntry  @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  actor        Membership @relation("TimeEntryAdjustmentActor", fields: [actorMembershipId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([timeEntryId])
}

/// Worker request to correct their own recorded TimeEntry. Proposed
/// times and the original clock live here so an OWNER decision never
/// silently rewrites the entry, an approved week, or a payroll result.
/// status: PENDING | ACCEPTED | DECLINED
/// One PENDING row per timeEntryId is enforced by a partial unique
/// index in the migration (TimeCorrectionRequest_timeEntryId_pending_key).
model TimeCorrectionRequest {
  id                      String   @id @default(cuid())
  businessId              String
  timeEntryId             String
  requestedByMembershipId String
  status                  String   @default("PENDING")
  reason                  String
  originalStartedAt       DateTime
  originalEndedAt         DateTime
  proposedStartedAt       DateTime
  proposedEndedAt         DateTime
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  business    Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  timeEntry   TimeEntry                @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  requestedBy Membership               @relation("TimeCorrectionRequester", fields: [requestedByMembershipId], references: [id], onDelete: Cascade)
  decisions   TimeCorrectionDecision[]

  @@index([businessId])
  @@index([timeEntryId])
  @@index([businessId, status])
  @@index([requestedByMembershipId])
}

/// Append-only OWNER decision for one TimeCorrectionRequest. One row
/// per request (unique requestId). Application code must never update
/// or delete an existing row.
model TimeCorrectionDecision {
  id                String   @id @default(cuid())
  businessId        String
  requestId         String
  actorMembershipId String
  /// ACCEPTED | DECLINED
  decision          String
  reason            String?
  createdAt         DateTime @default(now())

  business Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  request  TimeCorrectionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor    Membership            @relation("TimeCorrectionDecisionActor", fields: [actorMembershipId], references: [id], onDelete: Cascade)

  @@unique([requestId])
  @@index([businessId])
  @@index([actorMembershipId])
}

/// Weekly approval unit for one worker in one business. Payroll Ready
/// means status = APPROVED. This is a handoff flag only -- Time Cards
/// does not process payroll, taxes, or bank movement.
///
/// weekStartedAt is Sunday 00:00 local (matching startOfWeek() in
/// src/lib/schedule.ts). approvedHours / approvedHourlyWage /
/// approvedLaborCost are snapshots taken at approval.
model TimesheetWeek {
  id                     String    @id @default(cuid())
  businessId             String
  membershipId           String
  weekStartedAt          DateTime
  /// OPEN | APPROVED
  status                 String    @default("OPEN")
  approvedAt             DateTime?
  approvedByMembershipId String?
  approvedHours          Decimal?
  approvedHourlyWage     Decimal?
  approvedLaborCost      Decimal?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  business     Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  membership   Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  approvedBy   Membership? @relation("TimesheetWeekApprover", fields: [approvedByMembershipId], references: [id], onDelete: SetNull)
  payrollRunItems PayrollRunItem[]

  @@unique([businessId, membershipId, weekStartedAt])
  @@index([businessId])
  @@index([membershipId])
  @@index([businessId, status])
}

/// One assembled payroll period for a business. TBBT prepares, reviews,
/// authorizes, and records -- it is NOT a payroll processor. AUTHORIZED
/// and PROCESSED rows freeze their item snapshots; later wage / time /
/// membership edits must not rewrite those amounts.
///
/// status: DRAFT | READY_FOR_REVIEW | REVIEWED | AUTHORIZED | PROCESSED | CANCELLED
/// processedSource: MANUAL_EXTERNAL | PROVIDER (null until processed)
model PayrollRun {
  id         String @id @default(cuid())
  businessId String
  payPeriodStart DateTime
  payPeriodEnd   DateTime
  status     String @default("DRAFT")
  reviewedAt DateTime?
  reviewedByMembershipId String?
  authorizedAt DateTime?
  authorizedByMembershipId String?
  processedAt DateTime?
  processedByMembershipId String?
  processedSource String?
  providerReference String?
  notes      String?
  /// Frozen at OWNER authorization. History views read these, never
  /// recompute from current wages.
  authorizedWorkerCount      Int?
  authorizedApprovedHours    Decimal?
  authorizedGrossLaborAmount Decimal?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business     Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reviewedBy   Membership? @relation("PayrollRunReviewer", fields: [reviewedByMembershipId], references: [id], onDelete: SetNull)
  authorizedBy Membership? @relation("PayrollRunAuthorizer", fields: [authorizedByMembershipId], references: [id], onDelete: SetNull)
  processedBy  Membership? @relation("PayrollRunProcessor", fields: [processedByMembershipId], references: [id], onDelete: SetNull)
  items        PayrollRunItem[]
  events       PayrollRunEvent[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, payPeriodStart])
}

/// One worker-week included in a PayrollRun. Values are copied from the
/// approved TimesheetWeek at inclusion time. AUTHORIZED / PROCESSED items
/// are immutable snapshots.
model PayrollRunItem {
  id                 String   @id @default(cuid())
  businessId         String
  payrollRunId       String
  membershipId       String
  timesheetWeekId    String
  weekStartedAt      DateTime
  regularHours       Decimal
  overtimeHours      Decimal
  approvedHours      Decimal
  approvedHourlyWage Decimal?
  grossLaborAmount   Decimal?
  /// READY | NEEDS_ATTENTION
  readiness          String   @default("NEEDS_ATTENTION")
  /// String[] of PAYROLL_EXCEPTION codes (see src/lib/payroll.ts).
  exceptions         Json     @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payrollRun    PayrollRun    @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  membership    Membership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  timesheetWeek TimesheetWeek @relation(fields: [timesheetWeekId], references: [id], onDelete: Restrict)

  @@unique([payrollRunId, timesheetWeekId])
  @@index([businessId])
  @@index([payrollRunId])
  @@index([membershipId])
  @@index([timesheetWeekId])
}

/// Append-only audit log for consequential payroll actions. Application
/// code must never update or delete an existing row.
model PayrollRunEvent {
  id                String   @id @default(cuid())
  businessId        String
  payrollRunId      String
  actorMembershipId String
  /// CREATE | CHANGE_PERIOD | ADD_ITEM | REMOVE_ITEM | REVIEW | AUTHORIZE | REOPEN | CANCEL | MARK_PROCESSED
  action            String
  reason            String?
  previousJson      Json?
  nextJson          Json?
  createdAt         DateTime @default(now())

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  actor    Membership @relation("PayrollRunEventActor", fields: [actorMembershipId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([payrollRunId])
}

/// A business expense recorded by OWNER/ADMIN. Tenant-private financial
/// record -- always queried through the authenticated workspace
/// businessId. Split allocation is an intentional extension point
/// (parentExpenseId) and is not implemented in this step.
///
/// category: MATERIALS | GAS_FUEL | TOOLS_EQUIPMENT | VEHICLE |
///   SUBCONTRACTOR_HELPER | PERMITS_FEES | OFFICE_ADMIN |
///   SOFTWARE_SUBSCRIPTIONS | INSURANCE | MARKETING_ADVERTISING |
///   MILEAGE | OTHER
/// reimbursementStatus: NONE | PENDING | REIMBURSED
/// reviewStatus: RECORDED | APPROVED | FLAGGED
/// paymentMethod: same vocabulary as Invoice (CASH | CHECK |
///   ZELLE_BANK_TRANSFER | CARD_EXTERNAL | OTHER)
/// customerBillable marks a possible customer charge later. It never
/// creates or updates an Invoice / LineItem.
/// voidedAt is a soft void -- the row stays for job-cost history.
/// receiptStoredAssetId is the private managed receipt. receiptUrl is
/// a legacy pointer and is not cleared by private attach/remove. New
/// receipts never write a public file URL.
model Expense {
  id                    String    @id @default(cuid())
  businessId            String
  occurredOn            DateTime
  description           String
  amount                Decimal
  category              String
  vendor                String?
  purchaserMembershipId String?
  jobId                 String?
  customerId            String?
  receiptUrl            String?
  receiptStoredAssetId  String?   @unique
  reimbursable          Boolean   @default(false)
  customerBillable      Boolean   @default(false)
  voidedAt              DateTime?
  reimbursementStatus   String    @default("NONE")
  paymentMethod         String?
  taxCategory           String?
  recurring             Boolean   @default(false)
  recurringNote         String?
  /// Actual miles driven, stored separately from amount. Never used to
  /// invent an IRS/tax rate -- amount is always owner-entered.
  mileageMiles          Decimal?
  notes                 String?
  reviewStatus          String    @default("RECORDED")
  reviewedAt            DateTime?
  reviewedByMembershipId String?
  /// Reserved for future split-allocation children. Unused in this step.
  parentExpenseId       String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaser  Membership? @relation("ExpensePurchaser", fields: [purchaserMembershipId], references: [id], onDelete: SetNull)
  reviewer   Membership? @relation("ExpenseReviewer", fields: [reviewedByMembershipId], references: [id], onDelete: SetNull)
  job        Job?        @relation(fields: [jobId], references: [id], onDelete: SetNull)
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  receiptAsset StoredAsset? @relation(fields: [receiptStoredAssetId], references: [id], onDelete: SetNull)
  parent     Expense?    @relation("ExpenseSplit", fields: [parentExpenseId], references: [id], onDelete: SetNull)
  splits     Expense[]   @relation("ExpenseSplit")
  materialPurchaseItem MaterialPurchaseListItem?
  materialPriceHistory MaterialPriceHistory[]
  /// Optional durable-equipment purchase reference. One expense can
  /// back at most one register item. Not inventory or tax treatment.
  equipmentItem        EquipmentItem?

  @@index([businessId])
  @@index([businessId, occurredOn])
  @@index([businessId, category])
  @@index([jobId])
  @@index([customerId])
  @@index([purchaserMembershipId])
}

/// Internal marketing content. Never implies an external publish.
/// Status is DRAFT | READY_FOR_REVIEW | APPROVED only -- there is no
/// PUBLISHED state until a real channel integration exists.
model MarketingContent {
  id                     String    @id @default(cuid())
  businessId             String
  jobId                  String?
  contentType            String
  title                  String
  body                   String    @default("")
  channelIntent          String    @default("UNASSIGNED")
  status                 String    @default("DRAFT")
  /// Internal planning date only. Does not publish anything.
  plannedFor             DateTime?
  createdByMembershipId  String
  reviewedByMembershipId String?
  reviewedAt             DateTime?
  /// Optional future Marketing link from a recorded Review. Never auto-copies
  /// review text and never publishes a testimonial.
  reviewId               String?
  campaignId             String?
  catalogItemId          String?
  /// Editable storyboard beats as JSON. Internal planning only.
  storyboardJson         String    @default("[]")
  /// Editable shot list as JSON. Internal planning only.
  shotListJson           String    @default("[]")
  /// Caption hashtags drafted from recorded facts. Not a publish action.
  hashtags               String    @default("")
  /// Set when an OWNER/ADMIN exports a creator package. Never a publish.
  exportedAt             DateTime?
  exportedByMembershipId String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  business  Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaign  MarketingCampaign?       @relation("MarketingContentCampaign", fields: [campaignId], references: [id], onDelete: SetNull)
  job       Job?                     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdBy Membership               @relation("MarketingContentCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  reviewedBy Membership?             @relation("MarketingContentReviewer", fields: [reviewedByMembershipId], references: [id], onDelete: SetNull)
  exportedBy Membership?             @relation("MarketingContentExporter", fields: [exportedByMembershipId], references: [id], onDelete: SetNull)
  review    Review?                  @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  photos    MarketingContentPhoto[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, plannedFor])
  @@index([jobId])
  @@index([reviewId])
  @@index([campaignId])
}

/// One OWNER-opted weekly in-app reminder that studio packages await
/// review. Unique per business + timezone week. Optional OWNER SMS is
/// recorded on this same row. Never a customer message, auto-approve,
/// publish, or post.
model MarketingStudioWeeklyReminder {
  id            String   @id @default(cuid())
  businessId    String
  /// Sunday-first week start (YYYY-MM-DD) in Business.timezone.
  weekKey       String
  awaitingCount Int
  /// IN_APP. Owner SMS is an optional extra delivery on this row.
  channel       String   @default("IN_APP")
  /// NOT_CONNECTED | CONNECTED_UNUSED | NOT_SENT | ACCEPTED | SENT | FAILED | BLOCKED
  smsStatus     String
  smsLabel      String   @default("")
  /// Committed before the provider is called. A later failed status
  /// update cannot unclaim this; retries must not send again.
  smsSendClaimedAt DateTime?
  /// Provider message id when the send was accepted. Server-side only.
  smsProviderMessageId String?
  /// Raw provider error. Server-side only — never shown to ADMIN/manager.
  smsProviderError String?
  createdAt     DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, weekKey])
  @@index([businessId])
}

/// Selected marketing-approved JobPhoto on a content draft.
/// The photo must already be APPROVED for marketing at attach time.
model MarketingContentPhoto {
  id         String   @id @default(cuid())
  businessId String
  contentId  String
  jobPhotoId String
  createdAt  DateTime @default(now())

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  content  MarketingContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  jobPhoto JobPhoto         @relation(fields: [jobPhotoId], references: [id], onDelete: Cascade)

  @@unique([contentId, jobPhotoId])
  @@index([businessId])
  @@index([jobPhotoId])
}

/// Internal review-request record. SENT means the owner recorded that a
/// request was sent -- TBBT does not send SMS/email unless a real
/// integration exists. Lifecycle: DRAFT → READY → SENT → COMPLETED,
/// plus CANCELLED. One active (non-cancelled) request per completed Job
/// is enforced in application code.
model ReviewRequest {
  id                    String    @id @default(cuid())
  businessId            String
  customerId            String
  jobId                 String?
  /// DRAFT | READY | SENT | COMPLETED | CANCELLED
  status                String    @default("DRAFT")
  /// GOOGLE | FACEBOOK | OTHER | UNASSIGNED
  intendedPlatform      String    @default("UNASSIGNED")
  requestText           String    @default("")
  notes                 String?
  /// Set when the owner records SENT. Not an automated send timestamp.
  requestedAt           DateTime?
  /// Owner workflow reminder date. Delivery uses connected adapters only.
  reminderAt            DateTime?
  reminderCount         Int       @default(0)
  lastReminderAt        DateTime?
  remindersStoppedAt    DateTime?
  lastEmailStatus       String?
  lastSmsStatus         String?
  createdByMembershipId String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job       Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdBy Membership @relation("ReviewRequestCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  reviews   Review[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([customerId])
  @@index([jobId])
}

/// A review the owner recorded as received externally. TBBT does not
/// ingest Google/Facebook reviews in this step. Low ratings flag
/// needsAttention for recovery -- never suppress or retaliate.
model Review {
  id                       String    @id @default(cuid())
  businessId               String
  customerId               String
  jobId                    String?
  reviewRequestId          String?
  /// GOOGLE | FACEBOOK | OTHER
  platform                 String
  /// Present only when the external review actually has a rating.
  rating                   Int?
  reviewText               String    @default("")
  externalReviewDate       DateTime?
  externalUrl              String?
  /// NONE | DRAFT | READY_FOR_REVIEW | APPROVED -- mirrors the latest
  /// ReviewResponse status, or NONE when no response exists.
  responseStatus           String    @default("NONE")
  needsAttention           Boolean   @default(false)
  recoveryNotes            String?
  notes                    String?
  /// Eligible for a future Marketing opportunity. Never auto-copies
  /// review text into public content and never publishes a testimonial.
  marketingEligible        Boolean   @default(false)
  /// Owner explicitly selected this recorded review for the next website
  /// publish. Never inferred. Does not rewrite reviewText.
  websiteSelected          Boolean   @default(false)
  recordedByMembershipId   String
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job          Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  reviewRequest ReviewRequest? @relation(fields: [reviewRequestId], references: [id], onDelete: SetNull)
  recordedBy   Membership      @relation("ReviewRecorder", fields: [recordedByMembershipId], references: [id], onDelete: Restrict)
  responses    ReviewResponse[]
  marketingContents MarketingContent[]

  @@index([businessId])
  @@index([businessId, needsAttention])
  @@index([customerId])
  @@index([jobId])
  @@index([reviewRequestId])
}

/// Editable response draft for a recorded Review. Lifecycle:
/// DRAFT → READY_FOR_REVIEW → APPROVED. Never publishes externally.
model ReviewResponse {
  id                     String    @id @default(cuid())
  businessId             String
  reviewId               String
  body                   String    @default("")
  /// DRAFT | READY_FOR_REVIEW | APPROVED
  status                 String    @default("DRAFT")
  createdByMembershipId  String
  reviewedByMembershipId String?
  reviewedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  review     Review      @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdBy  Membership  @relation("ReviewResponseCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  reviewedBy Membership? @relation("ReviewResponseReviewer", fields: [reviewedByMembershipId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([reviewId])
}

/// Minimum owner-managed sales state for the Deals / Pipeline workspace.
/// This is NOT a second CRM: customer, request, estimate, job, and
/// invoice records stay where they are. A row is created lazily when the
/// owner records a stage that cannot be derived (CONTACTED,
/// SITE_VISIT_NEEDS_INFO, FOLLOW_UP, LOST), a follow-up date, or notes.
///
/// Displayed stage is resolved in src/lib/pipeline.ts from this row PLUS
/// the stronger Estimate/Job lifecycle. An approved estimate or Job
/// always displays as WON, even if ownerStage is still LOST.
model PipelineOpportunity {
  id         String @id @default(cuid())
  businessId String
  /// Opportunity keyed by ServiceRequest when one exists.
  serviceRequestId String? @unique
  /// Standalone estimate (no ServiceRequest). Never set together with
  /// serviceRequestId -- request-linked estimates reuse that request's row.
  standaloneEstimateId String? @unique
  /// CONTACTED | SITE_VISIT_NEEDS_INFO | FOLLOW_UP | LOST. Null until the
  /// owner records a sales state that cannot be derived from Estimate/Job.
  ownerStage String?
  /// Internal owner follow-up date. Never sends SMS/email.
  followUpOn DateTime?
  /// PRICE | OTHER_CONTRACTOR | POSTPONED | UNABLE_TO_REACH |
  /// OUTSIDE_SCOPE | SCHEDULING | OTHER
  lossReason String?
  lossReasonNote String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business           Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceRequest     ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  standaloneEstimate Estimate?       @relation("PipelineStandaloneEstimate", fields: [standaloneEstimateId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, ownerStage])
  @@index([businessId, followUpOn])
}

/// Reusable owner-configured estimating defaults for a registered
/// workspace (concrete-slab, decorative-wall-paneling, framed-wall, ...).
/// This is business pricing infrastructure — not a catalog row, not a
/// prior estimate, and not a project takeoff encoding. Catalog deletion,
/// draft reset, and finishing a job must not remove these values.
/// Payload JSON holds labor rates, waste/markup, bag yield, and reusable
/// material unit costs / customer unit prices. Project measurements,
/// rounded job totals, and SENT/APPROVED snapshots never live here.
model BusinessEstimatingDefault {
  id          String   @id @default(cuid())
  businessId  String
  workspaceId String
  payload     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, workspaceId])
  @@index([businessId])
}

/// One preferred supplier/location context per business + provider.
/// First implementation uses Home Depot; Lowe's can be added later
/// without changing the estimating engine. Not a purchasing account.
model BusinessSupplierPreference {
  id              String   @id @default(cuid())
  businessId      String
  providerId      String
  enabled         Boolean  @default(true)
  locationZip     String?
  locationStoreId String?
  locationLabel   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, providerId])
  @@index([businessId])
}

/// Maps a stable calculator material identity (not an estimate line)
/// to a provider product for one business. Custom materials may be
/// mapped later; pickup/procurement is never a supplier product.
model BusinessMaterialSupplierMapping {
  id                String   @id @default(cuid())
  businessId        String
  providerId        String
  materialIdentity  String
  takeoffType       String?
  providerProductId String
  providerSku       String?
  providerUrl       String?
  productName       String
  unitLabel         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, providerId, materialIdentity])
  @@index([businessId])
  @@index([businessId, providerId])
}

/// Current supplier/source price for one business, product, and
/// location key. Separate from BusinessEstimatingDefault. Never
/// auto-copied onto SENT/APPROVED/job/invoice snapshots.
model SupplierPriceRecord {
  id                String   @id @default(cuid())
  businessId        String
  providerId        String
  providerProductId String
  productName       String
  sku               String?
  productUrl        String?
  unitLabel         String
  currentPrice      Decimal
  currency          String   @default("USD")
  locationKey       String   @default("_")
  locationZip       String?
  locationStoreId   String?
  locationLabel     String?
  fetchedAt         DateTime
  sourceStatus      String
  sourceMode        String
  rawMetadata       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, providerId, providerProductId, locationKey])
  @@index([businessId])
  @@index([businessId, providerId])
}

/// Typed, business-scoped lightweight settings that are not already
/// stored on Business (name, trade, labor minimum). One row per Business.
/// Created lazily by application code -- never a dumping-ground JSON blob.
/// Communication and notification flags are owner preferences only; they
/// never send SMS/email or publish externally.
model BusinessSettings {
  id         String @id @default(cuid())
  businessId String @unique

  estimateCommunicationEnabled     Boolean @default(true)
  scheduleNotificationEnabled      Boolean @default(true)
  invoiceCommunicationEnabled      Boolean @default(true)
  reviewRequestPreferenceEnabled   Boolean @default(false)
  marketingCommunicationEnabled    Boolean @default(false)

  notifyEstimateEvents Boolean @default(true)
  notifyScheduleEvents Boolean @default(true)
  notifyInvoiceEvents  Boolean @default(true)
  notifyPayrollEvents  Boolean @default(true)
  notifyTeamEvents     Boolean @default(true)

  /// Owner/admin background notes. Never published as-is.
  rawOwnerStory String?
  /// Owner-approved About story shown on the public website.
  approvedPublicAboutCopy String?

  marketingBrandVoice String?
  marketingIdentityNotes String?
  /// OWNER opt-in for one weekly in-app reminder when studio packages
  /// await review. Default off. Absence of a settings row also means off.
  /// Optional OWNER SMS uses the communications provider only when that
  /// provider, the dedicated tenant From number, and an explicit OWNER
  /// SMS destination opt-in actually work. Never uses Business.publicPhone.
  /// Never sends customer SMS/email or auto-approves/publishes/posts.
  studioWeeklyReviewReminderOptedIn Boolean @default(false)
  /// OWNER-controlled SMS destination for the weekly studio reminder.
  /// Stored as E.164. Null/blank means in-app only — no SMS.
  /// Never Business.publicPhone and never a customer phone.
  studioWeeklyReminderOwnerSmsTo String?
  /// Separate opt-in for sending the weekly reminder to
  /// studioWeeklyReminderOwnerSmsTo. Default off.
  studioWeeklyReminderOwnerSmsOptedIn Boolean @default(false)
  /// Inbound STOP from the OWNER destination. Separate from Customer consent.
  studioWeeklyReminderOwnerSmsStopAt DateTime?
  /// Provider blocked/opted-out the OWNER destination (Twilio 21610).
  studioWeeklyReminderOwnerSmsBlockedAt DateTime?
  reviewGoogleUrl String?
  reviewFacebookUrl String?
  reviewOtherUrl String?
  reviewReminderMaxCount Int @default(2)
  seoTitleHome String?
  seoDescriptionHome String?
  seoTitleServices String?
  seoDescriptionServices String?
  seoTitleAbout String?
  seoDescriptionAbout String?
  seoTitleRequest String?
  seoDescriptionRequest String?
  /// Owner-approved homepage hero copy. Empty uses safe trade/name defaults.
  websiteHeroHeadline String?
  websiteHeroSupporting String?

  /// Minutes from midnight for the normal workday start (default 08:00).
  workStartMinutes Int @default(480)
  /// Minutes from midnight for the normal workday end (default 17:00).
  workEndMinutes Int @default(1020)
  /// Comma-separated JS getDay() values (0=Sun … 6=Sat). Default Mon–Fri.
  workingWeekdays String @default("1,2,3,4,5")
  /// Travel / material-pickup buffer after a job, in minutes. Default 30.
  schedulingBufferMinutes Int @default(30)
  /// EXACT | WINDOW. First appointment default. Configurable per business.
  firstAppointmentMode String @default("EXACT")
  /// EXACT | WINDOW. Later / follow-on work default.
  laterAppointmentMode String @default("WINDOW")
  defaultArrivalWindowMinutes Int @default(120)
  /// Hours before start when a change is flagged as inside the day-before cutoff.
  dayBeforeChangeCutoffHours Int @default(24)
  defaultPickupMinutes Int @default(0)
  /// Estimated travel placeholder only. Never GPS routing.
  travelPlaceholderMinutes Int @default(0)
  helperRecommendationThresholdMinutes Int @default(60)
  overloadThresholdPercent Int @default(90)

  /// Launch-only owner notes that have no other Core home.
  /// STARTING | GROWING | ESTABLISHED | STABILIZING
  businessStage String?
  /// HOURLY | FLAT | MIXED | CUSTOM
  pricingApproach String?
  teamStructureNotes String?
  paymentPreferenceNotes String?
  schedulingPreferenceNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

/// A calendar date this business is unavailable. Stored as YYYY-MM-DD so it
/// matches the existing schedule date inputs. Tenant-scoped; never shared.
model BusinessUnavailableDate {
  id         String   @id @default(cuid())
  businessId String
  date       String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
  @@index([businessId])
}

/// Append-only audit trail for consequential Settings changes.
/// Application code must never update or delete an existing row.
/// Never stores passwords, tokens, API secrets, or banking credentials.
model SettingsAuditLog {
  id                    String   @id @default(cuid())
  businessId            String
  changedByMembershipId String
  settingArea           String
  settingKey            String
  previousValue         String?
  newValue              String?
  changedAt             DateTime @default(now())

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  changedBy Membership @relation("SettingsAuditActor", fields: [changedByMembershipId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([businessId, settingArea])
  @@index([businessId, changedAt])
}

/// Owner/admin override for a single public-website marketing image slot.
/// Defaults stay in code/assets. A row here only changes presentation for
/// that business — never catalog data, project history, or page structure.
model PublicSiteImage {
  id                    String   @id @default(cuid())
  businessId            String
  page                  String
  slot                  String
  imageUrl              String?
  objectPosition        String   @default("50% 50%")
  /// Non-destructive display zoom. 1 = current object-fit:cover appearance.
  objectZoom            Float    @default(1)
  /// Optional pointer to the reusable StoredAsset that owns this slot's
  /// upload. Crop/zoom stay on this row; the original file is never
  /// destructively cropped.
  storedAssetId         String?
  updatedByMembershipId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storedAsset StoredAsset? @relation(fields: [storedAssetId], references: [id], onDelete: SetNull)
  updatedBy   Membership?  @relation("PublicSiteImageActor", fields: [updatedByMembershipId], references: [id], onDelete: SetNull)

  @@unique([businessId, page, slot])
  @@index([businessId, page])
  @@index([storedAssetId])
}

/// Internal operational knowledge for one business. This is NOT a second
/// catalog, CRM, or estimate store -- TBBT records stay where they are
/// and are referenced. Owner-created text is never auto-VERIFIED.
/// SYSTEM_DERIVED is reserved for future evidence-backed derivation and
/// is never written by this core implementation.
///
/// category: SERVICES_PRICING | ESTIMATING_TAKEOFFS | JOB_PROCEDURES |
///   CUSTOMERS_POLICIES | VENDORS_MATERIALS | MARKETING_BRAND |
///   SAFETY_COMPLIANCE | TRAINING_HOWTO
/// sourceType: OWNER_CREATED | TBBT_RECORD | EXTERNAL_REFERENCE | SYSTEM_DERIVED
/// sourceKind: SERVICE | ESTIMATE | JOB | EXPENSE | TIME | MARKETING | REVIEW |
///   REQUEST | EXPERIENCE_CANDIDATE
/// trustState: VERIFIED | SUPPORTED | ESTIMATE | NEEDS_REVIEW | CONFLICT | UNKNOWN
model KnowledgeEntry {
  id         String @id @default(cuid())
  businessId String
  title      String
  category   String
  body       String
  sourceType String
  sourceKind String?
  sourceReferenceId String?
  sourceLabel String?
  trustState String
  archived   Boolean  @default(false)
  createdByMembershipId String
  lastReviewedAt DateTime?
  lastReviewedByMembershipId String?
  /// BUSINESS (this tenant only) | PLATFORM (shared later; never mixed into tenant retrieval)
  scope      String   @default("BUSINESS")
  /// STANDARD_OPERATING_PROCEDURE | PRICING_LESSON | SERVICE_LESSON |
  /// CUSTOMER_FAQ | FIELD_TECHNIQUE | ESTIMATING_ASSUMPTION |
  /// SCHEDULING_LESSON | VENDOR_MATERIAL_LESSON | OWNER_POLICY | BUSINESS_RULE
  knowledgeKind String?
  /// UNREVIEWED | APPROVED | REJECTED. Owner approval is separate from trust.
  approvalState String @default("UNREVIEWED")
  approvedAt DateTime?
  approvedByMembershipId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy  Membership @relation("KnowledgeEntryCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  reviewedBy Membership? @relation("KnowledgeEntryReviewer", fields: [lastReviewedByMembershipId], references: [id], onDelete: SetNull)
  approvedBy Membership? @relation("KnowledgeEntryApprover", fields: [approvedByMembershipId], references: [id], onDelete: SetNull)
  concepts   KnowledgeConcept[]
  assertions KnowledgeAssertion[]
  procedures OperatingProcedure[]
  experienceCandidates ExperienceLearningCandidate[]

  @@index([businessId])
  @@index([businessId, category])
  @@index([businessId, trustState])
  @@index([businessId, archived])
  @@index([businessId, scope])
  @@index([businessId, approvalState])
  @@index([businessId, knowledgeKind])
}

/// Owner-authored business goal. Recommendations never invent the target
/// number; title/notes are owner text over recorded TBBT activity.
model BusinessGoal {
  id                    String   @id @default(cuid())
  businessId            String
  title                 String
  description           String   @default("")
  /// ACTIVE | DONE | PAUSED
  status                String   @default("ACTIVE")
  recommendationKey     String?
  createdByMembershipId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  business    Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy   Membership?          @relation("BusinessGoalCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  actionItems BusinessActionItem[]

  @@index([businessId])
  @@index([businessId, status])
}

/// Owner action plan item, optionally linked to a computed recommendation.
model BusinessActionItem {
  id                    String   @id @default(cuid())
  businessId            String
  goalId                String?
  recommendationKey     String
  title                 String
  notes                 String   @default("")
  /// OPEN | DONE | DISMISSED
  status                String   @default("OPEN")
  createdByMembershipId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  business  Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  goal      BusinessGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  createdBy Membership? @relation("BusinessActionItemCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  recommendationStates BsosRecommendationState[]
  phoneCallbacks PhoneInteraction[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([goalId])
}

/// Internal campaign record. Never implies an external ad account.
model MarketingCampaign {
  id                    String   @id @default(cuid())
  businessId            String
  name                  String
  /// WEBSITE | REFERRAL | GOOGLE | FACEBOOK | MANUAL | OTHER
  sourceKey             String   @default("OTHER")
  /// DRAFT | ACTIVE | PAUSED | COMPLETED
  status                String   @default("DRAFT")
  notes                 String   @default("")
  /// Owner-recorded campaign cost. Null means cost/ROI is unavailable.
  recordedCost          Decimal?
  createdByMembershipId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy         Membership?        @relation("MarketingCampaignCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  requests          ServiceRequest[]   @relation("ServiceRequestCampaign")
  estimates         Estimate[]         @relation("EstimateCampaign")
  jobs              Job[]              @relation("JobCampaign")
  firstTouchCustomers Customer[]       @relation("CustomerFirstCampaign")
  contents          MarketingContent[] @relation("MarketingContentCampaign")
  referrals         Referral[]
  growthActionRequests GrowthActionRequest[]

  @@index([businessId])
  @@index([businessId, status])
}

/// Owner-configured city or postal service area. Not a GIS engine.
model ServiceArea {
  id                    String   @id @default(cuid())
  businessId            String
  /// CITY | POSTAL
  kind                  String
  label                 String
  city                  String?
  region                String?
  postalCode            String?
  enabled               Boolean  @default(true)
  travelAdjustment      Decimal?
  minimumAdjustment     Decimal?
  notes                 String   @default("")
  createdByMembershipId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy Membership?    @relation("ServiceAreaCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  matchedRequests ServiceRequest[] @relation("ServiceRequestMatchedArea")
  websiteLocalPageDrafts WebsiteLocalPageDraft[]

  @@index([businessId])
  @@index([businessId, enabled])
}

/// Referral request to an existing customer. Delivery uses connected adapters.
model ReferralRequest {
  id                    String    @id @default(cuid())
  businessId            String
  customerId            String
  jobId                 String?
  /// DRAFT | READY | SENT | FAILED | COMPLETED | CANCELLED
  status                String    @default("DRAFT")
  requestText           String    @default("")
  notes                 String?
  requestedAt           DateTime?
  remindersStoppedAt    DateTime?
  lastEmailStatus       String?
  lastSmsStatus         String?
  createdByMembershipId String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job       Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdBy Membership @relation("ReferralRequestCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  referrals Referral[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([customerId])
  @@index([jobId])
}

/// Recorded referral source. Never invents a referred customer.
model Referral {
  id                 String   @id @default(cuid())
  businessId         String
  sourceCustomerId   String
  referredCustomerId String?
  referralRequestId  String?
  campaignId         String?
  /// RECORDED | CONVERTED | CANCELLED
  status             String   @default("RECORDED")
  notes              String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business         Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sourceCustomer   Customer         @relation("ReferralSourceCustomer", fields: [sourceCustomerId], references: [id], onDelete: Cascade)
  referredCustomer Customer?        @relation("ReferralReferredCustomer", fields: [referredCustomerId], references: [id], onDelete: SetNull)
  referralRequest  ReferralRequest? @relation(fields: [referralRequestId], references: [id], onDelete: SetNull)
  campaign         MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  partnerVendorOpportunities PartnerVendorOpportunity[]

  @@index([businessId])
  @@index([sourceCustomerId])
  @@index([referredCustomerId])
}

/// Owner-controlled follow-up for a completed job or repeat customer.
/// Delivery uses connected adapters; the row survives provider failure.
model CustomerFollowUp {
  id                    String    @id @default(cuid())
  businessId            String
  customerId            String
  jobId                 String?
  /// JOB_COMPLETE | REPEAT
  kind                  String
  /// OPEN | SENT | FAILED | CANCELLED | DONE
  /// DONE is owner-completed retention work. It is never a send.
  status                String    @default("OPEN")
  /// COMMUNICATION | RETENTION_TASK
  /// RETENTION_TASK is owner-recorded work and is excluded from due scans.
  origin                String    @default("COMMUNICATION")
  /// Optional owner-set calendar day for RETENTION_TASK work. Stored as
  /// the start of that day in the business timezone. Never used to emit
  /// CUSTOMER_FOLLOW_UP_DUE or send a message.
  dueOn                 DateTime?
  notes                 String    @default("")
  cancelledAt           DateTime?
  sentAt                DateTime?
  lastEmailStatus       String?
  lastSmsStatus         String?
  createdByMembershipId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  business  Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer  Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job       Job?        @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdBy Membership? @relation("CustomerFollowUpCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, kind, status])
  @@index([businessId, origin, status])
  @@index([businessId, origin, status, dueOn])
  @@index([customerId])
  @@index([jobId])
  @@index([createdByMembershipId])
}

/// Tenant-scoped AI conversation. Never used as an authorization boundary.
model AiConversation {
  id           String   @id @default(cuid())
  businessId   String
  membershipId String
  /// COACH | KNOWLEDGE | MARKETING | REVIEW | WRITING
  area         String
  title        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business     Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  membership   Membership              @relation("AiConversationMembership", fields: [membershipId], references: [id], onDelete: Cascade)
  messages     AiConversationMessage[]
  interactions AiInteraction[]
  orchestrationRuns AiOrchestrationRun[] @relation("AiOrchestrationConversation")

  @@index([businessId])
  @@index([businessId, area])
  @@index([membershipId])
}

model AiConversationMessage {
  id             String   @id @default(cuid())
  businessId     String
  conversationId String
  /// USER | ASSISTANT | SYSTEM
  role           String
  content        String
  /// FACT | RECOMMENDATION | MIXED
  stance         String   @default("MIXED")
  citedFacts     Json?
  interactionId  String?
  createdAt      DateTime @default(now())

  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation AiConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  interaction  AiInteraction?  @relation("AiMessageInteraction", fields: [interactionId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([conversationId])
}

/// Auditable AI call. Stores sanitized summaries, never secrets or raw dumps.
model AiInteraction {
  id               String   @id @default(cuid())
  businessId       String
  membershipId     String?
  userId           String?
  conversationId   String?
  /// COACH_ASK | COS_ASK | WRITING | MARKETING_DRAFT | REVIEW_RESPONSE | KNOWLEDGE_ASK | WEEKLY_PLAN | CAMPAIGN_IDEAS
  taskType         String
  provider         String?
  model            String?
  /// PENDING | COMPLETED | FAILED | SKIPPED_NOT_CONNECTED | VALIDATION_FAILED
  status           String
  inputSummary     String
  outputSummary    String?
  failureReason    String?
  latencyMs        Int?
  promptTokens     Int?
  completionTokens Int?
  retryCount       Int      @default(0)
  idempotencyKey   String
  /// Set when a worker claims PENDING or reclaims a stale PENDING interaction.
  claimedAt        DateTime?
  createdAt        DateTime @default(now())

  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  membership   Membership?     @relation("AiInteractionMembership", fields: [membershipId], references: [id], onDelete: SetNull)
  conversation AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages     AiConversationMessage[] @relation("AiMessageInteraction")
  orchestrationRun AiOrchestrationRun? @relation("AiOrchestrationInteraction")

  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([businessId, taskType])
  @@index([businessId, createdAt])
}

/// Chief-of-Staff audit metadata. No secrets and no chain-of-thought.
/// Orchestration status is NOT AI-provider status.
model AiOrchestrationRun {
  id                 String   @id @default(cuid())
  businessId         String
  membershipId       String
  interactionId      String   @unique
  conversationId     String?
  /// PENDING | COMPLETED | PARTIAL | FAILED
  status             String
  questionSummary    String
  specialistIds      Json
  factKeys           Json
  recommendationKeys Json
  conflictMetadata   Json?
  skippedFailure     Json?
  idempotencyKey     String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  membership   Membership      @relation("AiOrchestrationMembership", fields: [membershipId], references: [id], onDelete: Cascade)
  interaction  AiInteraction   @relation("AiOrchestrationInteraction", fields: [interactionId], references: [id], onDelete: Cascade)
  conversation AiConversation? @relation("AiOrchestrationConversation", fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([membershipId])
  @@index([conversationId])
}

/// Monthly usage totals. No invented dollar cost.
model AiUsagePeriod {
  id               String   @id @default(cuid())
  businessId       String
  periodStart      DateTime
  requestCount     Int      @default(0)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  failedCount      Int      @default(0)
  skippedCount     Int      @default(0)
  updatedAt        DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, periodStart])
}

model KnowledgeConcept {
  id         String   @id @default(cuid())
  businessId String
  entryId    String
  label      String
  /// CONCEPT | WORKFLOW | STRATEGY | WARNING | EXCEPTION
  kind       String
  createdAt  DateTime @default(now())

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entry    KnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([entryId])
}

model KnowledgeAssertion {
  id         String   @id @default(cuid())
  businessId String
  entryId    String
  statement  String
  /// FACT | CLAIM | OPINION
  stance     String
  /// HIGH | MEDIUM | LOW | UNKNOWN
  confidence String   @default("UNKNOWN")
  createdAt  DateTime @default(now())

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entry    KnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([entryId])
}

/// Resumable OWNER launch checklist. Progress is derived from defined
/// steps — never a fake percentage. Authoritative business data stays on
/// existing Core records; this table only tracks setup state.
model BusinessLaunchProgress {
  id                    String    @id @default(cuid())
  businessId            String    @unique
  /// IN_PROGRESS | COMPLETED
  status                String    @default("IN_PROGRESS")
  lastStepKey           String?
  resumeLaterAt         DateTime?
  completedAt           DateTime?
  createdByMembershipId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  business  Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy Membership?          @relation("BusinessLaunchProgressCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  steps     BusinessLaunchStep[]
}

model BusinessLaunchStep {
  id          String    @id @default(cuid())
  businessId  String
  progressId  String
  stepKey     String
  /// PENDING | COMPLETED | SKIPPED | DEFERRED
  status      String    @default("PENDING")
  completedAt DateTime?
  skippedAt   DateTime?
  deferredAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  progress BusinessLaunchProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  @@unique([businessId, stepKey])
  @@index([businessId])
  @@index([progressId])
}

/// AI-assisted company setup proposal. Never an authorized write.
/// Owner must approve each consequential item before Core records change.
model CompanySetupProposal {
  id                    String   @id @default(cuid())
  businessId            String
  createdByMembershipId String
  /// DRAFT | REVIEWED | PARTIALLY_APPLIED | APPLIED | DISCARDED
  status                String   @default("DRAFT")
  inputText             String
  proposalSummary       String   @default("")
  interactionId         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  business  Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy Membership                 @relation("CompanySetupProposalCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  items     CompanySetupProposalItem[]

  @@unique([businessId, interactionId])
  @@index([businessId])
  @@index([businessId, status])
}

model CompanySetupProposalItem {
  id                 String    @id @default(cuid())
  businessId         String
  proposalId         String
  /// SERVICE | DESCRIPTION | BRAND_VOICE | GOAL | PROCEDURE | SETUP_CHOICE |
  /// TRADE_ACTIVATION | SUBSCRIPTION | WEBSITE_PUBLISH | LEGAL | PRICING
  kind               String
  title              String
  body               String
  payloadJson        String    @default("{}")
  /// PENDING | APPROVED | REJECTED | APPLIED | BLOCKED
  status             String    @default("PENDING")
  appliedAt          DateTime?
  appliedRecordKind  String?
  appliedRecordId    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  business Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  proposal CompanySetupProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([proposalId])
}

/// Reusable operating procedure / checklist. Not a workflow engine.
model OperatingProcedure {
  id                    String   @id @default(cuid())
  businessId            String
  title                 String
  summary               String   @default("")
  tradeCode             String?
  serviceCatalogItemId  String?
  jobType               String?
  knowledgeEntryId      String?
  /// UNREVIEWED | APPROVED | REJECTED
  approvalState         String   @default("UNREVIEWED")
  archived              Boolean  @default(false)
  createdByMembershipId String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  business    Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy   Membership          @relation("OperatingProcedureCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  catalogItem ServiceCatalogItem? @relation(fields: [serviceCatalogItemId], references: [id], onDelete: SetNull)
  knowledge   KnowledgeEntry?     @relation(fields: [knowledgeEntryId], references: [id], onDelete: SetNull)
  steps       OperatingProcedureStep[]
  crewVisits  JobCrewVisit[]

  @@index([businessId])
  @@index([businessId, archived])
  @@index([serviceCatalogItemId])
  @@index([knowledgeEntryId])
}

model OperatingProcedureStep {
  id           String @id @default(cuid())
  businessId   String
  procedureId  String
  sortOrder    Int
  title        String
  body         String  @default("")
  required     Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business  Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  procedure OperatingProcedure  @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([procedureId, sortOrder])
}

/// Candidate learning from recorded work. Never trusted policy until
/// an owner reviews and approves it.
model ExperienceLearningCandidate {
  id                       String    @id @default(cuid())
  businessId               String
  /// DURATION_VARIANCE | INTAKE_QUESTION | RECURRING_CUSTOMER_QUESTION |
  /// SCOPE_CHANGE | FIELD_NOTE | ESTIMATING_ASSUMPTION
  kind                     String
  title                    String
  body                     String
  evidenceJson             String    @default("{}")
  evidenceKey              String
  sourceKind               String?
  sourceReferenceId        String?
  /// CANDIDATE | REVIEWED | APPROVED | REJECTED
  status                   String    @default("CANDIDATE")
  confidence               String    @default("UNKNOWN")
  reviewedAt               DateTime?
  reviewedByMembershipId   String?
  knowledgeEntryId         String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reviewedBy   Membership?     @relation("ExperienceLearningReviewer", fields: [reviewedByMembershipId], references: [id], onDelete: SetNull)
  knowledge    KnowledgeEntry? @relation(fields: [knowledgeEntryId], references: [id], onDelete: SetNull)

  @@unique([businessId, kind, evidenceKey])
  @@index([businessId])
  @@index([businessId, status])
}

/// Durable business event. Idempotent per (businessId, idempotencyKey).
model BusinessEvent {
  id             String   @id @default(cuid())
  businessId     String
  /// REQUEST_CREATED | ESTIMATE_SENT | ESTIMATE_APPROVED | APPOINTMENT_SCHEDULED |
  /// APPOINTMENT_CHANGED | JOB_STARTED | JOB_COMPLETED | INVOICE_SENT | INVOICE_DUE |
  /// INVOICE_OVERDUE | INVOICE_PAID | REVIEW_OPPORTUNITY_CREATED |
  /// REFERRAL_OPPORTUNITY_CREATED | CUSTOMER_FOLLOW_UP_DUE
  type           String
  subjectType    String
  subjectId      String
  payload        Json?
  occurredAt     DateTime @default(now())
  idempotencyKey String
  createdAt      DateTime @default(now())

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  runs     AutomationRun[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([businessId, type])
  @@index([businessId, subjectType, subjectId])
}

model AutomationRule {
  id           String   @id @default(cuid())
  businessId   String
  eventType    String
  /// COMMUNICATION | ACTION_SUGGESTION
  kind         String   @default("COMMUNICATION")
  purpose      String
  enabled      Boolean  @default(false)
  /// EMAIL | SMS | BOTH | NONE
  channel      String   @default("NONE")
  delayMinutes Int      @default(0)
  templateKey  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  runs     AutomationRun[]

  @@unique([businessId, eventType, purpose])
  @@index([businessId])
}

model AutomationRun {
  id             String    @id @default(cuid())
  businessId     String
  eventId        String
  ruleId         String?
  kind           String
  /// PENDING | PROCESSING | SUCCEEDED | FAILED | SKIPPED | BLOCKED
  status         String    @default("PENDING")
  attemptCount   Int       @default(0)
  lastError      String?
  resultSummary  String?
  idempotencyKey String
  availableAt    DateTime  @default(now())
  /// Set when a worker claims PENDING or reclaims a stale PROCESSING run.
  claimedAt      DateTime?
  processedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  event    BusinessEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rule     AutomationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([businessId, status, availableAt])
  @@index([eventId])
}

/// Persisted recommendation acknowledgment so dismissed/completed items
/// do not keep repeating on Business Health.
model BsosRecommendationState {
  id                      String   @id @default(cuid())
  businessId              String
  recommendationKey       String
  /// OPEN | DISMISSED | COMPLETED
  status                  String   @default("OPEN")
  /// Fingerprint of the supporting facts when this status was recorded.
  evidenceKey             String   @default("")
  /// Prior dismiss/complete acknowledgments for older fact fingerprints.
  history                 Json?
  actionItemId            String?
  updatedByMembershipId   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  business   Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  updatedBy  Membership?         @relation("BsosRecommendationStateActor", fields: [updatedByMembershipId], references: [id], onDelete: SetNull)
  actionItem BusinessActionItem? @relation(fields: [actionItemId], references: [id], onDelete: SetNull)

  @@unique([businessId, recommendationKey])
  @@index([businessId])
}

/// Durable provenance for an explicitly confirmed Controlled AI Action.
/// Written only after owner confirmation. Never inferred from existing
/// BusinessActionItem / BsosRecommendationState rows. No prompts, secrets,
/// customer message bodies, or provider payloads.
model ControlledAiActionAttempt {
  id                      String   @id @default(cuid())
  businessId              String
  /// CREATE_RECOMMENDATION_ACTION_ITEM | DISMISS_RECOMMENDATION | COMPLETE_RECOMMENDATION
  actionKey               String
  /// EXECUTED | REPLAYED | FAILED | DENIED
  result                  String
  recommendationKey       String
  /// RECOMMENDATION
  targetEntityType        String
  /// BusinessActionItem | BsosRecommendationState. Null when no domain row.
  targetRecordType        String?
  targetRecordId          String?
  confirmedByMembershipId String
  confirmedByUserId       String?
  /// SUCCEEDED | REPLAYED | STALE_PROPOSAL | NOT_ACTIVE | MISSING_ACTION_ITEM | DOMAIN_ERROR
  resultCode              String
  resultMessage           String
  executionAttemptId      String
  confirmedAt             DateTime @default(now())
  executedAt              DateTime?
  createdAt               DateTime @default(now())

  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  confirmedBy Membership @relation("ControlledAiActionAttemptActor", fields: [confirmedByMembershipId], references: [id], onDelete: Restrict)

  @@unique([businessId, executionAttemptId, actionKey, recommendationKey])
  @@index([businessId, confirmedAt])
  @@index([businessId, actionKey])
  @@index([confirmedByMembershipId])
}

/// Immutable published public-website snapshot. Application code must
/// never update snapshotJson / schemaVersion / versionNumber after insert.
/// Rollback copies this payload into a new row and moves the current pointer.
/// OWNER restore moves Business.publishedWebsiteId to this existing row and
/// restores each trade’s captured TenantIntakeSnapshot pointer. Restore
/// never rewrites WebsitePublish, TenantIntakeSnapshot, or ServiceRequest.
model WebsitePublish {
  id                       String   @id @default(cuid())
  businessId               String
  versionNumber            Int
  /// PUBLISHED. Historical rows stay PUBLISHED even after a later version
  /// becomes current. The current pointer is Business.publishedWebsiteId.
  status                   String   @default("PUBLISHED")
  schemaVersion            Int
  snapshotJson             String
  summary                  String   @default("")
  publishedAt              DateTime @default(now())
  publishedByMembershipId  String?
  sourcePublishId          String?
  idempotencyKey           String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  business      Business          @relation("BusinessWebsitePublishes", fields: [businessId], references: [id], onDelete: Cascade)
  publishedBy   Membership?       @relation("WebsitePublishAuthor", fields: [publishedByMembershipId], references: [id], onDelete: SetNull)
  sourcePublish WebsitePublish?   @relation("WebsitePublishLineage", fields: [sourcePublishId], references: [id], onDelete: SetNull)
  derivedPublishes WebsitePublish[] @relation("WebsitePublishLineage")
  currentFor    Business?         @relation("CurrentPublishedWebsite")

  @@unique([businessId, versionNumber])
  @@unique([businessId, idempotencyKey])
  @@index([businessId, publishedAt])
  @@index([publishedByMembershipId])
  @@index([sourcePublishId])
}

/// Owner-selected public gallery/project image. Draft state only —
/// published sites read the frozen snapshot projection.
model WebsiteGalleryItem {
  id                      String   @id @default(cuid())
  businessId              String
  storedAssetId           String
  title                   String   @default("")
  caption                 String   @default("")
  sortOrder               Int      @default(0)
  catalogItemId           String?
  createdByMembershipId   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  business    Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storedAsset StoredAsset         @relation(fields: [storedAssetId], references: [id], onDelete: Cascade)
  catalogItem ServiceCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  createdBy   Membership?         @relation("WebsiteGalleryCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  @@index([businessId, sortOrder])
  @@index([storedAssetId])
  @@index([catalogItemId])
}

/// Future custom-domain binding. UNVERIFIED rows never authorize public
/// host resolution. This PR does not provision DNS or mark verified.
model WebsiteHostBinding {
  id         String   @id @default(cuid())
  businessId String
  hostname   String
  /// UNVERIFIED | VERIFIED | FAILED
  status     String   @default("UNVERIFIED")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([hostname])
  @@index([businessId])
}

/// Owner/AI draft copy for a local service-area page. Never public until
/// the owner publishes a snapshot that includes it.
model WebsiteLocalPageDraft {
  id             String   @id @default(cuid())
  businessId     String
  serviceAreaId  String
  catalogItemId  String
  draftCopy      String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceArea ServiceArea        @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)
  catalogItem ServiceCatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@unique([businessId, serviceAreaId, catalogItemId])
  @@index([businessId])
}

/// Practical skill recorded on an existing Membership. Tenant-scoped.
/// Not a public profile and not a second employee identity.
model MembershipSkill {
  id           String   @id @default(cuid())
  businessId   String
  membershipId String
  skillKey     String
  /// LEARNING | CAPABLE | LEAD_QUALIFIED
  proficiency  String   @default("CAPABLE")
  createdAt    DateTime @default(now())

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, skillKey])
  @@index([businessId])
}

/// Optional weekly hours for one membership. Empty means inherit business hours.
model MembershipWeeklyAvailability {
  id           String @id @default(cuid())
  businessId   String
  membershipId String
  weekday      Int
  startMinutes Int
  endMinutes   Int

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, weekday])
  @@index([businessId])
}

/// Worker-requested dated availability exception or time off.
/// PENDING until an OWNER accepts or declines. Only ACCEPT writes
/// MembershipAvailabilityException. Decline does not change recorded
/// availability. These rows never cancel, reassign, or message Jobs.
model MembershipAvailabilityExceptionRequest {
  id           String   @id @default(cuid())
  businessId   String
  membershipId String
  /// Business-timezone civil date. YYYY-MM-DD. Not a UTC instant.
  date         String
  /// AVAILABLE | UNAVAILABLE
  kind         String
  startMinutes Int?
  endMinutes   Int?
  note         String   @default("")
  /// PENDING | ACCEPTED | DECLINED
  status       String   @default("PENDING")
  requestedAt  DateTime @default(now())
  decidedAt    DateTime?
  decidedByMembershipId String?
  updatedAt    DateTime @updatedAt

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  decidedBy  Membership? @relation("AvailabilityRequestDecider", fields: [decidedByMembershipId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@index([membershipId, date])
  @@index([decidedByMembershipId])
}

/// One-day availability exception for a membership. YYYY-MM-DD.
model MembershipAvailabilityException {
  id           String   @id @default(cuid())
  businessId   String
  membershipId String
  date         String
  /// AVAILABLE | UNAVAILABLE
  kind         String
  startMinutes Int?
  endMinutes   Int?
  note         String   @default("")
  createdAt    DateTime @default(now())

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, date])
  @@index([businessId])
}

/// Internal approved helper / subcontractor bench. Never public.
/// Not a cross-business marketplace and never shares CRM or revenue.
/// A bench row is not a User or Membership. Optional membershipId only
/// records that this person is already on the regular team roster.
model FillInBenchWorker {
  id                String    @id @default(cuid())
  businessId        String
  displayName       String
  /// PHONE | EMAIL | TEXT | OTHER
  contactPreference String    @default("PHONE")
  contactValue      String    @default("")
  skills            String    @default("")
  availabilityNotes String    @default("")
  /// BACKUP | HELPER | SUBCONTRACTOR | FUTURE_HIRE
  workerType        String    @default("BACKUP")
  /// Owner-recorded service-area / location notes. Not a geo engine.
  locationNotes     String    @default("")
  approved          Boolean   @default(true)
  active            Boolean   @default(true)
  lastUsedAt        DateTime?
  notes             String    @default("")
  membershipId      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  outreachTasks WorkforceOutreachTask[]

  @@index([businessId])
  @@index([membershipId])
}

/// Owner-approved staffing outreach task. Creating this row is the
/// authorization. No other agent sends contact from this record.
model WorkforceOutreachTask {
  id                       String   @id @default(cuid())
  businessId               String
  /// DRAFT | APPROVED | DISMISSED | DONE
  status                   String   @default("DRAFT")
  /// STAFFING_SHORTAGE | HELPER_NEEDED
  kind                     String
  jobId                    String?
  benchWorkerId            String?
  missingSkills            String   @default("")
  missingMinutes           Int?
  explanation              String
  createdByMembershipId    String?
  approvedByMembershipId   String?
  /// Stable retry key for one logical outreach click. Unique per business.
  idempotencyKey           String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  job        Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  benchWorker FillInBenchWorker? @relation(fields: [benchWorkerId], references: [id], onDelete: SetNull)
  createdBy  Membership?       @relation("WorkforceOutreachCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  approvedBy Membership?       @relation("WorkforceOutreachApprover", fields: [approvedByMembershipId], references: [id], onDelete: SetNull)

  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([jobId])
  @@index([benchWorkerId])
}

/// First-class tenant-scoped supplier/vendor. Owner-managed records,
/// not a retailer login, EDI account, or API-credential store.
/// Never store supplier passwords or API secrets here.
model Supplier {
  id                  String   @id @default(cuid())
  businessId          String
  name                String
  contactName         String?
  contactEmail        String?
  contactPhone        String?
  website             String?
  /// Account / vendor reference only. Never credentials.
  accountReference    String?
  preferred           Boolean  @default(false)
  notes               String?
  active              Boolean  @default(true)
  /// Owner categories / trades. Not a national catalog taxonomy.
  categories          String?
  locationDescription String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  business          Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  catalogItems      MaterialCatalogItem[]
  priceHistory      MaterialPriceHistory[]
  purchaseListItems MaterialPurchaseListItem[]
  purchaseOrders    MaterialPurchaseOrder[]
  partnerVendorOpportunities PartnerVendorOpportunity[]

  @@index([businessId])
  @@index([businessId, active])
}

/// Reusable business material item. Owners name their own materials;
/// this is not a standardized national SKU catalog.
model MaterialCatalogItem {
  id                  String    @id @default(cuid())
  businessId          String
  name                String
  normalizedName      String
  sku                 String?
  unit                String
  packSize            Decimal?
  preferredSupplierId String?
  lastKnownCost       Decimal?
  lastKnownCostAt     DateTime?
  notes               String?
  category            String?
  /// Optional calculator / takeoff identity for matching, not required.
  takeoffIdentity     String?
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  business          Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  preferredSupplier Supplier?                  @relation(fields: [preferredSupplierId], references: [id], onDelete: SetNull)
  priceHistory      MaterialPriceHistory[]
  purchaseListItems MaterialPurchaseListItem[]

  @@index([businessId])
  @@index([businessId, normalizedName])
  @@index([preferredSupplierId])
}

/// Append-only observed / purchased prices. Application code must never
/// update or delete an existing row when the current catalog price changes.
model MaterialPriceHistory {
  id                 String    @id @default(cuid())
  businessId         String
  materialId         String
  supplierId         String?
  unit               String
  packSize           Decimal?
  price              Decimal
  observedAt         DateTime
  /// OWNER_ENTRY | EXPENSE | PURCHASE | PROVIDER
  source             String
  purchaseListItemId String?
  expenseId          String?
  notes              String?
  createdAt          DateTime  @default(now())

  business         Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  material         MaterialCatalogItem    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  supplier         Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseListItem MaterialPurchaseListItem? @relation(fields: [purchaseListItemId], references: [id], onDelete: SetNull)
  expense          Expense?                 @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([materialId, observedAt])
  @@index([supplierId])
  @@index([purchaseListItemId])
  @@index([expenseId])
}

/// Job / estimate purchasing workflow. Operational tracking only —
/// TBBT never places supplier orders from this record.
model MaterialPurchaseList {
  id                String   @id @default(cuid())
  businessId        String
  jobId             String?
  estimateId        String?
  estimateVersionId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business        Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  job             Job?                       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  estimate        Estimate?                  @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  estimateVersion EstimateVersion?           @relation(fields: [estimateVersionId], references: [id], onDelete: SetNull)
  items           MaterialPurchaseListItem[]
  purchaseOrders  MaterialPurchaseOrder[]

  @@unique([businessId, jobId])
  @@unique([businessId, estimateId])
  @@index([businessId])
  @@index([jobId])
  @@index([estimateId])
  @@index([estimateVersionId])
}

model MaterialPurchaseListItem {
  id                        String    @id @default(cuid())
  businessId                String
  purchaseListId            String
  materialId                String?
  supplierId                String?
  lineItemId                String?
  takeoffItemId             String?
  /// Deterministic converted-row identity, e.g. takeoff:{lineItemId}:{takeoffItemId}
  /// or material-line:{lineItemId}. Null for manual owner-added rows.
  sourceKey                 String?
  name                      String
  quantityNeeded            Decimal
  unit                      String
  plannedUnitCost           Decimal?
  plannedCost               Decimal?
  quantityPurchased         Decimal?
  actualUnitCost            Decimal?
  actualCost                Decimal?
  /// Owner-entered markup snapshot from the estimate. Never invented.
  markupPercent             Decimal?
  /// Customer-facing unit price snapshot. Separate from purchase cost.
  customerUnitPrice         Decimal?
  estimatedQuantity         Decimal?
  estimatedCost             Decimal?
  pickupRequired            Boolean   @default(false)
  pickupLocationDescription String?
  pickupDurationMinutes     Int?
  pickupReady               Boolean   @default(false)
  /// Worker-recorded picked-up quantity. Distinct from quantityPurchased.
  /// Recording pickup never purchases, prices, or expenses.
  quantityPickedUp          Decimal?
  /// UNAVAILABLE | SHORT | DAMAGED | CLOSED | OTHER
  pickupException           String?
  pickupExceptionNote       String?
  pickupRecordedAt          DateTime?
  pickupRecordedByMembershipId String?
  /// NEEDED | PLANNED | ORDERED | PURCHASED | RECEIVED | CANCELLED
  status                    String    @default("NEEDED")
  expenseId                 String?   @unique
  notes                     String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  business       Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseList   MaterialPurchaseList  @relation(fields: [purchaseListId], references: [id], onDelete: Cascade)
  material       MaterialCatalogItem?  @relation(fields: [materialId], references: [id], onDelete: SetNull)
  supplier       Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  lineItem       LineItem?             @relation(fields: [lineItemId], references: [id], onDelete: SetNull)
  expense        Expense?              @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  pickupRecordedBy Membership?         @relation("PurchaseListItemPickupRecorder", fields: [pickupRecordedByMembershipId], references: [id], onDelete: SetNull)
  priceHistory   MaterialPriceHistory[]
  purchaseOrderItems MaterialPurchaseOrderItem[]

  @@unique([businessId, purchaseListId, sourceKey])
  @@index([businessId])
  @@index([purchaseListId])
  @@index([materialId])
  @@index([supplierId])
  @@index([lineItemId])
  @@index([pickupRecordedByMembershipId])
}

/// Lightweight operational Purchase Order. Not supplier EDI.
/// Status never means a supplier confirmed the order.
model MaterialPurchaseOrder {
  id             String    @id @default(cuid())
  businessId     String
  purchaseListId String
  supplierId     String?
  jobId          String?
  /// DRAFT | READY | ORDERED_EXTERNALLY | PARTIALLY_RECEIVED | RECEIVED | CANCELLED
  status         String    @default("DRAFT")
  notes          String?
  orderedAt      DateTime?
  receivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  business     Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseList MaterialPurchaseList        @relation(fields: [purchaseListId], references: [id], onDelete: Cascade)
  supplier     Supplier?                   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  job          Job?                        @relation(fields: [jobId], references: [id], onDelete: SetNull)
  items        MaterialPurchaseOrderItem[]
  receipts     MaterialPurchaseOrderReceipt[]

  @@index([businessId])
  @@index([purchaseListId])
  @@index([supplierId])
  @@index([jobId])
}

model MaterialPurchaseOrderItem {
  id                 String   @id @default(cuid())
  businessId         String
  purchaseOrderId    String
  purchaseListItemId String
  /// Ordered quantity copied from the purchase list when the PO was drafted.
  quantity           Decimal
  /// Cumulative OWNER-recorded received quantity. Distinct from
  /// MaterialPurchaseListItem.quantityPurchased and from worker
  /// pickup quantities on the native pickup PR. Default 0 — never inferred.
  quantityReceived   Decimal  @default(0)
  lastReceivedAt     DateTime?
  unitCost           Decimal?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business         Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseOrder    MaterialPurchaseOrder    @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseListItem MaterialPurchaseListItem @relation(fields: [purchaseListItemId], references: [id], onDelete: Cascade)
  receiptItems     MaterialPurchaseOrderReceiptItem[]

  @@unique([purchaseOrderId, purchaseListItemId])
  @@index([businessId])
  @@index([purchaseOrderId])
  @@index([purchaseListItemId])
}

/// One OWNER-recorded delivery against an existing purchase order.
/// `MaterialPurchaseOrderItem.quantityReceived` stays the running total.
/// OWNER reversal of a recorded delivery is a follow-up and is not built here.
model MaterialPurchaseOrderReceipt {
  id                     String   @id @default(cuid())
  businessId             String
  purchaseOrderId        String
  attemptKey             String
  recordedByMembershipId String?
  createdAt              DateTime @default(now())

  business      Business                         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseOrder MaterialPurchaseOrder            @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  recordedBy    Membership?                      @relation("PurchaseOrderReceiptRecorder", fields: [recordedByMembershipId], references: [id], onDelete: SetNull)
  items         MaterialPurchaseOrderReceiptItem[]

  @@unique([businessId, attemptKey])
  @@index([businessId])
  @@index([purchaseOrderId])
  @@index([recordedByMembershipId])
}

model MaterialPurchaseOrderReceiptItem {
  id                  String  @id @default(cuid())
  businessId          String
  receiptId           String
  purchaseOrderItemId String
  /// Quantity on this delivery, not the running PO-item total.
  quantity            Decimal

  business          Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  receipt           MaterialPurchaseOrderReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem MaterialPurchaseOrderItem   @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([receiptId])
  @@index([purchaseOrderItemId])
}

/// Browser/form retry identity for convert-takeoff, draft PO,
/// record-purchase, and record-PO-receipt. Never authorizes; businessId
/// comes from the session.
model MaterialOperationAttempt {
  id                 String   @id @default(cuid())
  businessId         String
  attemptKey         String
  /// CONVERT_TAKEOFF | CREATE_DRAFT_PO | RECORD_PURCHASE | RECORD_PO_RECEIPT
  kind               String
  purchaseListId     String?
  purchaseOrderId    String?
  purchaseListItemId String?
  expenseId          String?
  createdCount       Int?
  /// Stable hash of the claimed payload. Receipt retries compare this.
  payloadFingerprint String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, attemptKey])
  @@index([businessId])
}

/// Optional employer labor burden and owner pricing targets for THIS
/// business. Null rates mean nothing is configured — profit calculations
/// stay wage-only and never invent a default percentage. Changing a rate
/// does not rewrite approved time-card or payroll snapshots.
model BusinessLaborBurdenSetting {
  id                    String   @id @default(cuid())
  businessId            String   @unique
  /// Employer burden as a decimal fraction of recorded wage (0.15 = 15%).
  /// Null means no burden is configured.
  burdenRate            Decimal?
  /// Owner target gross margin as a decimal fraction (0.40 = 40%).
  /// Null means no owner target is on file.
  targetGrossMarginRate Decimal?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

/// Owner-reviewed recurring expense pattern derived from Expense history.
/// Detection never creates a payable or liability. Persistence exists so
/// the owner can confirm or dismiss a suggested pattern.
model RecurringExpensePattern {
  id                      String    @id @default(cuid())
  businessId              String
  patternKey              String
  description             String
  vendor                  String?
  category                String
  suggestedAmount         Decimal
  occurrenceCount         Int
  firstOccurredOn         DateTime
  lastOccurredOn          DateTime
  /// SUGGESTED | CONFIRMED | DISMISSED
  ownerStatus             String    @default("SUGGESTED")
  confirmedAt             DateTime?
  confirmedByMembershipId String?
  dismissedAt             DateTime?
  dismissedByMembershipId String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  confirmedBy Membership? @relation("RecurringPatternConfirmedBy", fields: [confirmedByMembershipId], references: [id], onDelete: SetNull)
  dismissedBy Membership? @relation("RecurringPatternDismissedBy", fields: [dismissedByMembershipId], references: [id], onDelete: SetNull)

  @@unique([businessId, patternKey])
  @@index([businessId])
  @@index([businessId, ownerStatus])
}

/// Provider-neutral accounting or banking connection for one business.
/// This table records adapter identity and status only. No live provider
/// is connected in the financial-intelligence release; rows stay
/// DISCONNECTED until a later adapter is implemented.
model BusinessFinanceConnection {
  id           String    @id @default(cuid())
  businessId   String
  /// ACCOUNTING | BANKING
  kind         String
  /// Adapter id. "none" while disconnected.
  providerKey  String    @default("none")
  /// DISCONNECTED | CONNECTED
  status       String    @default("DISCONNECTED")
  connectedAt  DateTime?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, kind])
  @@index([businessId])
}

/// Owner correction of working attribution. originalLeadSource on the
/// request and Customer.firstLeadSource stay immutable.
model LeadAttributionCorrection {
  id                      String   @id @default(cuid())
  businessId              String
  /// SERVICE_REQUEST | CUSTOMER | ESTIMATE | JOB
  recordType              String
  recordId                String
  previousLeadSource      String?
  previousCampaignId      String?
  previousLandingPagePath String?
  newLeadSource           String?
  newCampaignId           String?
  newLandingPagePath      String?
  reason                  String   @default("")
  actorMembershipId       String?
  createdAt               DateTime @default(now())

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actor    Membership? @relation("LeadAttributionActor", fields: [actorMembershipId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, recordType, recordId])
  @@index([actorMembershipId])
}

/// Durable growth follow-up / recovery / reactivation request.
/// Growth never sends customer messages; Communications owns delivery.
model GrowthActionRequest {
  id                    String    @id @default(cuid())
  businessId            String
  /// RECOVERY | REACTIVATION | REVIEW_ASK | REFERRAL_ASK
  kind                  String
  /// NEVER_ESTIMATED | ESTIMATE_NO_RESPONSE | ESTIMATE_LOST | MISSED_FOLLOW_UP | DORMANT | REACTIVATION
  queue                 String
  /// OPEN | APPROVED | CANCELLED | COMPLETED
  status                String    @default("OPEN")
  customerId            String?
  serviceRequestId      String?
  estimateId            String?
  jobId                 String?
  campaignId            String?
  consentEligible       Boolean   @default(false)
  evidenceJson          String    @default("{}")
  notes                 String    @default("")
  createdByMembershipId String?
  approvedByMembershipId String?
  approvedAt            DateTime?
  /// Attempt-scoped key for one logical click. Future intentional actions use a new attemptId.
  idempotencyKey        String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  serviceRequest ServiceRequest?  @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  estimate      Estimate?         @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  job           Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  campaign      MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdBy     Membership?       @relation("GrowthActionCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  approvedBy    Membership?       @relation("GrowthActionApprover", fields: [approvedByMembershipId], references: [id], onDelete: SetNull)

  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, queue])
  @@index([customerId])
  @@index([serviceRequestId])
  @@index([estimateId])
  @@index([jobId])
  @@index([campaignId])
}

/// Tenant-scoped private Business Vault record. Existence never publishes
/// the file. Linked StoredAssets stay PRIVATE.
model BusinessVaultRecord {
  id                      String   @id @default(cuid())
  businessId              String
  title                   String
  /// COMPANY_LEGAL | EIN_TAX | INSURANCE | LICENSE | CERTIFICATION |
  /// WARRANTY | CONTRACT | SUBCONTRACTOR_AGREEMENT | CUSTOMER_AGREEMENT |
  /// NDA | REFERRAL_AGREEMENT | PARTNERSHIP_AGREEMENT | VENDOR_AGREEMENT | OTHER
  category                String
  issuer                  String?
  counterparty            String?
  /// YYYY-MM-DD calendar date. Issue/effective date is owner-recorded only.
  effectiveOn             String?
  /// YYYY-MM-DD calendar date. Never inferred from category. Boundary math
  /// uses Business.timezone, not the browser or process local timezone.
  expiresOn               String?
  /// Owner-recorded attention window in calendar days. Null uses the
  /// canonical 30-day default. Not a legal filing deadline.
  renewalLeadDays         Int?
  /// ACTIVE | ARCHIVED — owner-set. Expiry attention is computed separately.
  recordStatus            String   @default("ACTIVE")
  /// Last persisted computed expiry band for audit history.
  persistedExpiryState    String?
  notes                   String?
  storedAssetId           String?
  createdByMembershipId   String
  updatedByMembershipId   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storedAsset StoredAsset? @relation(fields: [storedAssetId], references: [id], onDelete: SetNull)
  createdBy   Membership   @relation("VaultRecordCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  updatedBy   Membership?  @relation("VaultRecordUpdater", fields: [updatedByMembershipId], references: [id], onDelete: SetNull)
  agreements  BusinessAgreement[]
  auditLogs   BusinessProtectionAuditLog[]
  completionClaims BusinessAgreementCompletionClaim[]

  @@index([businessId, category, recordStatus])
  @@index([businessId, expiresOn])
  @@index([storedAssetId])
}

/// Guided agreement lifecycle. Completed/signed versions are immutable.
model BusinessAgreement {
  id                                    String    @id @default(cuid())
  businessId                            String
  /// CUSTOMER_AGREEMENT | SUBCONTRACTOR_AGREEMENT |
  /// INDEPENDENT_CONTRACTOR_AGREEMENT | NDA | REFERRAL_AGREEMENT |
  /// PARTNERSHIP_AGREEMENT | VENDOR_AGREEMENT | CUSTOM_AGREEMENT
  agreementType                         String
  title                                 String
  counterparty                          String?
  /// QUESTIONS | DRAFT | RISK_REVIEW | OWNER_REVIEW | LEGAL_WARNING |
  /// READY | SENT | SIGNED | COMPLETE | EXTERNAL_COMPLETE
  lifecycleStatus                       String    @default("QUESTIONS")
  currentDraftVersionId                 String?   @unique
  signedVersionId                       String?   @unique
  vaultRecordId                         String?
  effectiveOn                           String?
  expiresOn                             String?
  /// NOT_CONNECTED | EXTERNAL_SIGNATURE | MANUAL_UPLOAD | PROVIDER_READY
  signingMode                           String    @default("NOT_CONNECTED")
  completedByMembershipId               String?
  completedAt                           DateTime?
  completionNotes                       String?
  /// Stable logical completion attempt key. Retries of the same attempt
  /// reuse the winner; a completed agreement cannot be completed again.
  completionAttemptKey                  String?
  legalReviewAcknowledgedAt             DateTime?
  legalReviewAcknowledgedByMembershipId String?
  ownerReviewedAt                       DateTime?
  ownerReviewedByMembershipId           String?
  createdByMembershipId                 String
  createdAt                             DateTime  @default(now())
  updatedAt                             DateTime  @updatedAt

  business          Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  vaultRecord       BusinessVaultRecord?        @relation(fields: [vaultRecordId], references: [id], onDelete: SetNull)
  currentDraft      BusinessAgreementVersion?   @relation("AgreementCurrentDraft", fields: [currentDraftVersionId], references: [id], onDelete: SetNull)
  signedVersion     BusinessAgreementVersion?   @relation("AgreementSignedVersion", fields: [signedVersionId], references: [id], onDelete: SetNull)
  versions          BusinessAgreementVersion[]  @relation("AgreementVersions")
  completionClaim   BusinessAgreementCompletionClaim?
  createdBy         Membership                  @relation("AgreementCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  completedBy       Membership?                 @relation("AgreementCompleter", fields: [completedByMembershipId], references: [id], onDelete: SetNull)
  legalAcknowledgedBy Membership?               @relation("AgreementLegalAck", fields: [legalReviewAcknowledgedByMembershipId], references: [id], onDelete: SetNull)
  ownerReviewedBy   Membership?                 @relation("AgreementOwnerReview", fields: [ownerReviewedByMembershipId], references: [id], onDelete: SetNull)
  auditLogs         BusinessProtectionAuditLog[]

  @@index([businessId, lifecycleStatus])
  @@index([businessId, agreementType])
  @@index([vaultRecordId])
  @@index([businessId, completionAttemptKey])
}

/// Versioned agreement representation. SENT / SIGNED_FINAL rows are locked.
model BusinessAgreementVersion {
  id                     String    @id @default(cuid())
  businessId             String
  agreementId            String
  versionNumber          Int
  /// DRAFT | SENT | SIGNED_FINAL | SUPERSEDED
  representationStatus   String    @default("DRAFT")
  answersJson            String    @default("{}")
  draftContent           String    @default("")
  riskReviewJson         String?
  createdByMembershipId  String
  createdAt              DateTime  @default(now())
  lockedAt               DateTime?

  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  agreement   BusinessAgreement @relation("AgreementVersions", fields: [agreementId], references: [id], onDelete: Cascade)
  currentFor  BusinessAgreement? @relation("AgreementCurrentDraft")
  signedFor   BusinessAgreement? @relation("AgreementSignedVersion")
  completionClaim BusinessAgreementCompletionClaim?
  createdBy   Membership        @relation("AgreementVersionCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)

  @@unique([agreementId, versionNumber])
  @@index([businessId, agreementId])
}

/// One completion claim per agreement. Same attempt key reuses the winner.
/// Concurrent retries cannot create a second signed version or vault row.
model BusinessAgreementCompletionClaim {
  id              String   @id @default(cuid())
  businessId      String
  agreementId     String   @unique
  attemptKey      String
  signedVersionId String   @unique
  vaultRecordId   String   @unique
  createdAt       DateTime @default(now())

  business      Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  agreement     BusinessAgreement        @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  signedVersion BusinessAgreementVersion @relation(fields: [signedVersionId], references: [id], onDelete: Restrict)
  vaultRecord   BusinessVaultRecord      @relation(fields: [vaultRecordId], references: [id], onDelete: Restrict)

  @@unique([businessId, attemptKey])
  @@index([businessId, agreementId])
}

/// Append-only protection/vault/agreement audit. Never updated or deleted.
model BusinessProtectionAuditLog {
  id                    String   @id @default(cuid())
  businessId            String
  vaultRecordId         String?
  agreementId           String?
  changedByMembershipId String
  action                String
  previousValue         String?
  newValue              String?
  changedAt             DateTime @default(now())

  business    Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  vaultRecord BusinessVaultRecord? @relation(fields: [vaultRecordId], references: [id], onDelete: SetNull)
  agreement   BusinessAgreement?   @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  changedBy   Membership           @relation("ProtectionAuditActor", fields: [changedByMembershipId], references: [id], onDelete: Restrict)

  @@index([businessId, changedAt])
  @@index([businessId, action])
  @@index([vaultRecordId])
  @@index([agreementId])
}

/// Owner-recorded acknowledgment (not a government filing).
model BusinessProtectionAcknowledgment {
  id             String   @id @default(cuid())
  businessId     String
  membershipId   String
  kind           String
  statement      String
  acknowledgedAt DateTime @default(now())

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  membership Membership @relation("ProtectionAcknowledgmentActor", fields: [membershipId], references: [id], onDelete: Restrict)

  @@index([businessId, kind])
}

/// Explicit OWNER participation in the BSOS Network.
/// Default-off: no row, or optedIn=false, is not discoverable.
/// Discovery never returns this row unless optedIn is true, and then only
/// the approved public listing fields. Customers, jobs, finances, private
/// contacts, and inferred non-participation are never disclosed.
model BsosNetworkParticipation {
  id                    String    @id @default(cuid())
  businessId            String    @unique
  /// False until OWNER explicitly opts in. Opt-out sets this back to false.
  optedIn               Boolean   @default(false)
  optedInAt             DateTime?
  optedOutAt            DateTime?
  /// OWNER-approved public listing name. Not inferred from private records.
  publicName            String    @default("")
  /// Configured trade shown on the listing (HANDYMAN | CLEANING).
  tradeCode             String    @default("HANDYMAN")
  /// Broad service area only (for example "Reno, NV"). Never a customer address.
  serviceAreaLabel      String    @default("")
  /// PHONE | EMAIL | WEBSITE — the one contact method the OWNER chose to publish.
  publicContactMethod   String    @default("EMAIL")
  publicContactValue    String    @default("")
  updatedByMembershipId String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  updatedBy Membership @relation("BsosNetworkParticipationActor", fields: [updatedByMembershipId], references: [id], onDelete: Restrict)

  @@index([optedIn])
  @@index([optedIn, tradeCode])
}

/// Private owner-managed partner / vendor opportunity for one business.
/// Reuses existing same-tenant Supplier or Referral rows when linked.
/// This is not an external marketplace, live supplier inventory,
/// affiliate payout ledger, or BSOS Network membership record.
///
/// kind: PARTNER | VENDOR
/// source: MANUAL | SUPPLIER | REFERRAL
/// reviewStatus: PENDING_REVIEW | REVIEWED | REJECTED
model PartnerVendorOpportunity {
  id                         String    @id @default(cuid())
  businessId                 String
  kind                       String
  name                       String
  summary                    String    @default("")
  notes                      String    @default("")
  contactName                String?
  contactEmail               String?
  contactPhone               String?
  website                    String?
  category                   String?
  locationDescription        String?
  source                     String
  reviewStatus               String    @default("PENDING_REVIEW")
  supplierId                 String?
  referralId                 String?
  createdByMembershipId      String
  lastReviewedAt             DateTime?
  lastReviewedByMembershipId String?
  reviewNotes                String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier   Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  referral   Referral?   @relation(fields: [referralId], references: [id], onDelete: SetNull)
  createdBy  Membership  @relation("PartnerVendorOpportunityCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  reviewedBy Membership? @relation("PartnerVendorOpportunityReviewer", fields: [lastReviewedByMembershipId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, kind])
  @@index([businessId, reviewStatus])
  @@index([businessId, source])
  @@index([supplierId])
  @@index([referralId])
}

/// OWNER-reviewed external lead import. Preview is stored first; invalid
/// staged rows can be corrected or rejected; ServiceRequest rows are created
/// only after explicit OWNER confirmation. Same-business duplicate flags are
/// possible matches, not scores. This is not scraping, a bought list,
/// outreach, or message sending.
model ExternalLeadImport {
  id                    String   @id @default(cuid())
  businessId            String
  /// CSV_UPLOAD. Server-side source-URL fetch is not implemented.
  sourceKind            String
  /// Sanitized filename or owner-supplied URL. Display only.
  sourceLabel           String
  /// SHA-256 of the exact CSV bytes used for this preview.
  contentSha256         String
  capturedAt            DateTime
  /// PREVIEW | CONFIRMING | CONFIRMED
  status                String   @default("PREVIEW")
  rowCount              Int
  validCount            Int
  invalidCount          Int
  possibleDuplicateCount Int
  createdByMembershipId String
  confirmedAt           DateTime?
  confirmedByMembershipId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy   Membership @relation("ExternalLeadImportCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  confirmedBy Membership? @relation("ExternalLeadImportConfirmer", fields: [confirmedByMembershipId], references: [id], onDelete: SetNull)
  rows        ExternalLeadImportRow[]

  @@unique([businessId, contentSha256])
  @@index([businessId])
  @@index([createdByMembershipId])
  @@index([confirmedByMembershipId])
}

/// One sanitized CSV row captured at preview time. Invalid rows stay staged
/// so the OWNER can correct or reject them before confirm. REJECTED is
/// terminal for this slice. Possible duplicate and rejected rows are never
/// auto-created.
model ExternalLeadImportRow {
  id                    String   @id @default(cuid())
  businessId            String
  importId              String
  rowNumber             Int
  /// VALID | INVALID | POSSIBLE_DUPLICATE | REJECTED
  previewStatus         String
  invalidReason         String?
  rowFingerprint        String
  name                  String
  email                 String?
  phone                 String?
  summary               String?
  notes                 String?
  streetAddress         String?
  unit                  String?
  city                  String?
  region                String?
  postalCode            String?
  /// Recorded LeadSource from the row when valid; otherwise MANUAL.
  leadSource            String
  possibleDuplicateCustomerId String?
  possibleDuplicateRequestId  String?
  createdRequestId      String?
  createdAt             DateTime @default(now())

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  import   ExternalLeadImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, rowNumber])
  @@index([businessId])
  @@index([importId])
  @@index([rowFingerprint])
}

/// OWNER-reviewed existing-customer CSV import. Preview is stored first;
/// invalid staged rows can be corrected or rejected; Customer and Property
/// rows are created only after explicit OWNER confirmation. Same-business
/// duplicate flags are email/phone matches, not scores. Confirm never
/// overwrites an existing customer or SMS consent. This is not outreach.
model CustomerCsvImport {
  id                      String   @id @default(cuid())
  businessId              String
  /// CSV_UPLOAD. Server-side source-URL fetch is not implemented.
  sourceKind              String
  /// Sanitized filename. Display only.
  sourceLabel             String
  /// SHA-256 of the exact CSV bytes used for this preview.
  contentSha256           String
  capturedAt              DateTime
  /// PREVIEW | CONFIRMING | CONFIRMED
  status                  String   @default("PREVIEW")
  rowCount                Int
  validCount              Int
  invalidCount            Int
  possibleDuplicateCount  Int
  createdByMembershipId   String
  confirmedAt             DateTime?
  confirmedByMembershipId String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy   Membership  @relation("CustomerCsvImportCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  confirmedBy Membership? @relation("CustomerCsvImportConfirmer", fields: [confirmedByMembershipId], references: [id], onDelete: SetNull)
  rows        CustomerCsvImportRow[]

  @@unique([businessId, contentSha256])
  @@index([businessId])
  @@index([createdByMembershipId])
  @@index([confirmedByMembershipId])
}

/// One sanitized existing-customer CSV row captured at preview time.
/// Invalid rows stay staged so the OWNER can correct or reject them before
/// confirm. REJECTED is terminal. Possible duplicates never overwrite the
/// matched customer or SMS consent.
model CustomerCsvImportRow {
  id                          String   @id @default(cuid())
  businessId                  String
  importId                    String
  rowNumber                   Int
  /// VALID | INVALID | POSSIBLE_DUPLICATE | REJECTED
  previewStatus               String
  invalidReason               String?
  rowFingerprint              String
  name                        String
  email                       String?
  phone                       String?
  propertyLabel               String?
  streetAddress               String?
  unit                        String?
  city                        String?
  region                      String?
  postalCode                  String?
  possibleDuplicateCustomerId String?
  createdCustomerId           String?
  createdPropertyId           String?
  reusedExistingCustomer      Boolean  @default(false)
  createdAt                   DateTime @default(now())

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  import   CustomerCsvImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, rowNumber])
  @@index([businessId])
  @@index([importId])
  @@index([rowFingerprint])
}

/// OWNER-reviewed service catalog CSV. Preview is stored first; catalog
/// rows are added or updated only after explicit OWNER confirmation.
/// Duplicate-name matches are same-business + same-trade name matches,
/// not scores. Confirm never rewrites LineItem / EstimateVersionLineItem
/// snapshots and never publishes hourly rates.
model ServiceCatalogImport {
  id                      String   @id @default(cuid())
  businessId              String
  /// CSV_UPLOAD. Server-side source-URL fetch is not implemented.
  sourceKind              String
  /// Sanitized filename. Display only.
  sourceLabel             String
  /// SHA-256 of the exact CSV bytes used for this preview.
  contentSha256           String
  capturedAt              DateTime
  /// PREVIEW | CONFIRMING | CONFIRMED
  status                  String   @default("PREVIEW")
  rowCount                Int
  validCount              Int
  invalidCount            Int
  nameMatchCount          Int
  createdByMembershipId   String
  confirmedAt             DateTime?
  confirmedByMembershipId String?
  /// Set when status is CONFIRMING. Re-upload and a second confirm may
  /// recover only after CATALOG_IMPORT_CONFIRMING_LEASE_MS.
  confirmingAt            DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy   Membership @relation("ServiceCatalogImportCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  confirmedBy Membership? @relation("ServiceCatalogImportConfirmer", fields: [confirmedByMembershipId], references: [id], onDelete: SetNull)
  rows        ServiceCatalogImportRow[]

  @@unique([businessId, contentSha256])
  @@index([businessId])
  @@index([createdByMembershipId])
  @@index([confirmedByMembershipId])
}

/// One sanitized catalog CSV row captured at preview time. Invalid rows
/// block confirm. NAME_MATCH rows stay skipped until the owner picks
/// update or add-as-new. Blank optional cells keep existing catalog
/// values on update. Confirm writes ServiceCatalogItem only.
model ServiceCatalogImportRow {
  id                   String   @id @default(cuid())
  businessId           String
  importId             String
  rowNumber            Int
  /// VALID | INVALID | NAME_MATCH
  previewStatus        String
  invalidReason        String?
  rowFingerprint       String
  name                 String
  description          String?
  pricingMode          String
  price                Decimal?
  /// Null means the CSV cell was blank — keep the existing category on update.
  category             String?
  tradeCode            String
  unitLabel            String   @default("")
  /// Null means the CSV cell was blank — keep the existing value on update.
  recurrenceEligible   Boolean?
  /// Null means the CSV cell was blank — never reactivate an archived service.
  active               Boolean?
  matchedCatalogItemId String?
  writtenCatalogItemId String?
  /// ADD | UPDATE after confirm; null while still a preview or skipped.
  writeAction          String?
  /// SKIP | UPDATE | ADD_NEW. Only NAME_MATCH rows use this. Default SKIP.
  matchDecision        String   @default("SKIP")
  createdAt            DateTime @default(now())

  business Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  import   ServiceCatalogImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, rowNumber])
  @@index([businessId])
  @@index([importId])
  @@index([rowFingerprint])
}

/// Provider-neutral e-sign boundary. No live provider is wired in this PR.
model BusinessEsignBoundary {
  id             String   @id @default(cuid())
  businessId     String   @unique
  /// NOT_CONNECTED | PROVIDER_READY
  providerStatus String   @default("NOT_CONNECTED")
  providerName   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

/// One practical Cleaning recurring-visit + crew-checklist field record
/// bound to an existing Job. Cadence stays on Job recurrence columns.
/// This is not a second job engine, CRM, billing, or invented quality stamp.
model JobCrewVisit {
  id        String @id @default(cuid())
  businessId String
  jobId      String @unique
  /// Approved OperatingProcedure used as the crew checklist, if any.
  /// Null means the Cleaning pack default checklist is in use.
  procedureId String?
  /// Snapshot of checklist items + worker checkmarks. JSON array.
  checklistJson String @default("[]")
  /// NONE | VISIT_COMPLETED | RE_CLEAN_REQUESTED
  outcomeStatus String @default("NONE")
  outcomeRecordedAt DateTime?
  outcomeRecordedByMembershipId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  procedure OperatingProcedure? @relation(fields: [procedureId], references: [id], onDelete: SetNull)
  outcomeRecordedBy Membership? @relation("JobCrewVisitOutcomeRecorder", fields: [outcomeRecordedByMembershipId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([jobId])
  @@index([businessId, outcomeStatus])
  @@index([procedureId])
  @@index([outcomeRecordedByMembershipId])
}

/// Owner-recorded tool or vehicle. Trade-neutral register — not inventory
/// stock, telemetry, depreciation, tax treatment, or automated reminders.
/// Due status uses the owner-entered serviceOn date only.
model EquipmentItem {
  id                    String    @id @default(cuid())
  businessId            String
  /// TOOL | VEHICLE
  kind                  String
  name                  String
  notes                 String    @default("")
  /// Optional same-business Expense purchase reference. Null means none.
  /// Never invents cost, depreciation, or tax treatment from this link.
  purchaseExpenseId     String?   @unique
  /// Owner-entered service calendar date. Null means none recorded.
  /// The due list includes this item only when this date is on or before
  /// today in the business timezone. TBBT never invents the next date.
  serviceOn             DateTime?
  createdByMembershipId String?
  /// Browser/form retry identity. Unique per business. Never authorizes.
  attemptKey            String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  business           Business                      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseExpense    Expense?                      @relation(fields: [purchaseExpenseId], references: [id], onDelete: SetNull)
  createdBy          Membership?                   @relation("EquipmentItemCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  maintenanceEntries EquipmentMaintenanceEntry[]

  @@unique([businessId, attemptKey])
  @@index([businessId])
  @@index([businessId, serviceOn])
  @@index([businessId, kind])
  @@index([createdByMembershipId])
}

/// Manual owner maintenance log for one EquipmentItem. Historical dates
/// only — never a reminder engine and never used to invent the next service.
model EquipmentMaintenanceEntry {
  id                    String   @id @default(cuid())
  businessId            String
  equipmentId           String
  /// Owner-entered maintenance calendar date.
  occurredOn            DateTime
  notes                 String
  createdByMembershipId String?
  attemptKey            String
  createdAt             DateTime @default(now())

  business  Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  equipment EquipmentItem @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  createdBy Membership?   @relation("EquipmentMaintenanceCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  @@unique([businessId, attemptKey])
  @@index([businessId])
  @@index([equipmentId, occurredOn])
  @@index([createdByMembershipId])
}

/// Tenant-scoped official-source regulatory note. Read-only application
/// surface. recordedState is CURRENT | STALE | CONFLICT | UNKNOWN.
/// A CURRENT note still never certifies a license or legal compliance.
/// This table does not gate estimates or jobs and does not claim
/// nationwide coverage.
model RegulatoryIntelligenceNote {
  id                  String   @id @default(cuid())
  businessId          String
  jurisdictionCode    String
  jurisdictionLabel   String
  tradeCode           String
  officialSourceUrl   String
  officialSourceTitle String
  citation            String
  retrievedAt         DateTime
  effectiveOn         DateTime?
  expiresOn           DateTime?
  recordedState       String
  summary             String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, jurisdictionCode, tradeCode])
}
